---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteLinks } from '../data/site';

const workOn = [
  'Audience growth and digital strategy',
  'Analytics, segmentation, and performance measurement',
  'Content and campaign systems',
  'E-commerce acquisition and lifecycle strategy',
  'New digital programs and platform opportunities',
  'Cross-functional workflows and operational design',
];
---

<BaseLayout
  title="About — Archieval Mariano"
  description="Archieval Mariano is a digital strategy and audience growth professional based in the Philippines, working across content, analytics, e-commerce, and digital operations."
>
  <section class="wrap about">
    <div class="about__head">
      <p class="eyebrow">About</p>
      <h1>Archieval Mariano</h1>
    </div>

    <div class="prose flow about__body">
      <p class="lede">
        I&rsquo;m a digital strategy and audience growth professional based in the
        Philippines. I work across content, analytics, e-commerce, and digital
        operations &mdash; usually in the space between a good idea and the systems
        needed to make it work.
      </p>

      <p>
        I started my career in digital publishing as a writer and editor. Over
        time, the questions I found myself working on became larger: Who are we
        trying to reach? Why does something perform? How do we build a repeatable
        process around it? What should we measure? And what should we try next?
      </p>

      <p>
        That progression has taken me through editorial, branded content, creative
        strategy, client management, e-commerce, analytics, audience development,
        partnerships, and digital strategy.
      </p>

      <p>
        More than a decade across digital publishing, branded content, client
        strategy, e-commerce, analytics, and audience development.
      </p>

      <div class="selected-exp">
        <p class="eyebrow">Selected experience</p>
        <p class="selected-exp__list">
          GMA New Media Inc. · SM Investments Corporation · Summit Media ·
          Independent consulting
        </p>
      </div>

      <h2>What I work on</h2>
      <ul>
        {workOn.map((item) => <li>{item}</li>)}
      </ul>

      <h2>How I work</h2>
      <p>
        I like strategy that survives contact with actual work. That usually means
        understanding the audience first, using data without mistaking it for
        judgment, and building processes that people can realistically maintain.
      </p>

      <p>
        My background in writing still shapes how I approach digital work: clarity
        matters, context matters, and the person on the other side of the screen
        is never merely a metric.
      </p>

      <p>
        You can reach me on the <a href="/contact">contact page</a>, or view my
        full record on <a href={siteLinks.linkedin} target="_blank" rel="noopener">LinkedIn</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: var(--space-xl);
  }

  .about__head {
    max-width: 54rem;
    margin-bottom: var(--space-lg);
  }

  .about__head h1 {
    margin-top: var(--space-sm);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink);
  }

  /* Quiet credibility cue — not a résumé section. */
  .selected-exp p {
    margin: 0;
  }

  .selected-exp__list {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
  }
</style>
