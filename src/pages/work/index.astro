---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const selectedWork = work.filter((entry) => entry.data.featured);
const archiveWork = work.filter((entry) => !entry.data.featured);

const experiments = [
  {
    title: 'Pinned Shop',
    label: 'Commerce prototype',
    description:
      'A concept storefront for enamel pins and small collectibles, exploring how voice, collections, saving, cart, and checkout can make a fictional brand feel complete.',
    href: 'https://archievalmariano.com/pinned-shop/',
  },
  {
    title: 'Pinned Travel',
    label: 'Travel check-in prototype',
    description:
      'A private trip check-in concept built around routes, check-in windows, and sharing the latest plan with people you trust.',
    href: 'https://archievalmariano.com/pinned-travel/',
  },
];
---

<BaseLayout
  title="Work — Archieval Mariano"
  description="Selected projects across digital strategy, audience growth, content, analytics, e-commerce, and operations."
>
  <section class="wrap page-head">
    <p class="page-head__chapter"><span>01</span> Work</p>
    <h1>Stories about audiences, systems and digital work.</h1>
    <p class="page-head__intro">
      The projects are different on the surface. Underneath, most begin with the
      same question: how can information become something a team can actually use?
    </p>
  </section>

  <div class="wrap work-groups">
    <section class="work-group" aria-labelledby="selected-work-heading">
      <h2 class="work-group__heading" id="selected-work-heading">Selected case studies</h2>
      <ul class="work-list">
        {selectedWork.map((entry, index) => <WorkCard entry={entry} variant="selected" number={index + 1} />)}
      </ul>
    </section>

    <section class="work-group work-group--archive" aria-labelledby="archive-heading">
      <h2 class="work-group__heading" id="archive-heading">More from the archive</h2>
      <ul class="work-list">
        {archiveWork.map((entry, index) => <WorkCard entry={entry} variant="archive" number={selectedWork.length + index + 1} />)}
      </ul>
    </section>

    <section class="experiments" aria-labelledby="experiments-heading">
      <div class="experiments__head">
        <h2 id="experiments-heading">Product experiments</h2>
        <p class="experiments__intro">
          Independent prototypes exploring product ideas and interactions. These
          are not launched products or claims of measured outcomes.
        </p>
      </div>

      <div class="experiments__list">
        {
          experiments.map((experiment, index) => (
            <a class="experiment" href={experiment.href} target="_blank" rel="noopener">
              <span class="experiment__number">P{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="experiment__label">{experiment.label}</p>
                <h3>{experiment.title}</h3>
                <p class="experiment__description">{experiment.description}</p>
              </div>
              <span class="experiment__link">
                Open prototype <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> (opens in a new tab)</span>
              </span>
            </a>
          ))
        }
      </div>

      <p class="experiments__note">
        The name is a callback to #Pinned, a label a colleague and I conceived and
        developed for an evergreen SEO project at GMA. Editorial later approved its
        use for search-focused service pieces designed to remain relevant over time.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
    max-width: var(--wrap);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 14ch;
    font-family: var(--font-sans);
    font-size: clamp(3.3rem, 7vw, 7.8rem);
    font-weight: 760;
    letter-spacing: -.065em;
    line-height: .9;
  }

  .page-head__intro {
    grid-column: 2;
    max-width: 44rem;
    margin: var(--space-md) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__chapter {
    grid-row: 1 / span 2;
    margin: 0;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .page-head__chapter span {
    display: block;
    width: fit-content;
    margin-bottom: .65rem;
    padding: .35rem .5rem;
    background: var(--yellow);
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .work-group--archive {
    padding-top: clamp(5rem, 10vw, 10rem);
  }

  .experiments {
    margin-top: clamp(5rem, 10vw, 10rem);
    padding: clamp(2rem, 5vw, 5rem);
    background: var(--blue-dark);
    border: var(--heavy-rule);
    color: var(--paper);
  }

  .experiments__head {
    display: grid;
    grid-template-columns: minmax(12rem, .55fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-bottom: clamp(2rem, 5vw, 5rem);
  }

  .experiments__head h2 {
    max-width: 10ch;
    font-family: var(--font-sans);
    font-size: clamp(2.3rem, 4vw, 4.4rem);
    font-weight: 740;
    letter-spacing: -.05em;
    line-height: .96;
  }

  .experiments__intro {
    max-width: 38rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 76%, transparent);
  }

  .experiments__list {
    border-top: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .experiments__note {
    max-width: 54rem;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-style: italic;
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 68%, transparent);
  }

  .experiment {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: var(--space-lg);
    align-items: start;
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
    color: var(--paper);
    text-decoration: none;
  }

  .experiment:hover {
    color: var(--yellow);
  }

  .experiment__number,
  .experiment__label,
  .experiment__link {
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .experiment__number,
  .experiment__label {
    color: color-mix(in srgb, var(--paper) 62%, transparent);
  }

  .experiment__label {
    margin: 0 0 var(--space-xs);
  }

  .experiment h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 3vw, 3.2rem);
    font-weight: 740;
    letter-spacing: -.045em;
    line-height: 1;
  }

  .experiment__description {
    max-width: 42rem;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 76%, transparent);
  }

  .experiment__link {
    white-space: nowrap;
  }

  .work-group__heading {
    margin: 0;
    padding-bottom: var(--space-md);
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    font-weight: 740;
    letter-spacing: -.035em;
    line-height: 1;
  }

  .work-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--heavy-rule);
    border-left: var(--heavy-rule);
  }

  @media (max-width: 44rem) {
    .page-head { grid-template-columns: 1fr; }
    .page-head h1, .page-head__intro, .page-head__chapter { grid-column: 1; grid-row: auto; }
    .work-list { grid-template-columns: 1fr; border-right: var(--heavy-rule); }
    .experiments__head { grid-template-columns: 1fr; }
    .experiment { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .experiment__link { grid-column: 2; }
  }
</style>
