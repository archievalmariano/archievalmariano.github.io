---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<BaseLayout
  title="Work — Archieval Mariano"
  description="Selected projects across digital strategy, audience growth, content, analytics, e-commerce, and operations."
>
  <section class="wrap page-head">
    <p class="eyebrow">Work</p>
    <h1>Selected work</h1>
    <p class="page-head__intro">
      A selection of projects across digital strategy, audience growth, content,
      analytics, e-commerce, and operations.
    </p>
  </section>

  <section class="wrap">
    <ul class="work-list">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    max-width: 54rem;
  }

  .page-head h1 {
    margin-top: var(--space-sm);
  }

  .page-head__intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
</style>
