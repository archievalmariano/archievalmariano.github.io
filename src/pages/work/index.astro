---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const selectedWork = work.filter((entry) => entry.data.featured);
const archiveWork = work.filter((entry) => !entry.data.featured);
---

<BaseLayout
  title="Work — Archieval Mariano"
  description="Selected projects across digital strategy, audience growth, content, analytics, e-commerce, and operations."
>
  <section class="wrap page-head">
    <p class="page-head__chapter"><span>01</span> Work</p>
    <h1>Stories about audiences, systems and digital work.</h1>
    <p class="page-head__intro">
      The projects are different on the surface. Underneath, most begin with the
      same question: how can information become something a team can actually use?
    </p>
  </section>

  <div class="wrap work-groups">
    <section class="work-group" aria-labelledby="selected-work-heading">
      <h2 class="work-group__heading" id="selected-work-heading">Selected case studies</h2>
      <ul class="work-list">
        {selectedWork.map((entry) => <WorkCard entry={entry} variant="selected" />)}
      </ul>
    </section>

    <section class="work-group work-group--archive" aria-labelledby="archive-heading">
      <h2 class="work-group__heading" id="archive-heading">More from the archive</h2>
      <ul class="work-list">
        {archiveWork.map((entry) => <WorkCard entry={entry} variant="archive" />)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
    max-width: var(--wrap);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 14ch;
    font-family: var(--font-sans);
    font-size: clamp(3.3rem, 7vw, 7.8rem);
    font-weight: 760;
    letter-spacing: -.065em;
    line-height: .9;
  }

  .page-head__intro {
    grid-column: 2;
    max-width: 44rem;
    margin: var(--space-md) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__chapter {
    grid-row: 1 / span 2;
    margin: 0;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .page-head__chapter span {
    display: block;
    width: fit-content;
    margin-bottom: .65rem;
    padding: .35rem .5rem;
    background: var(--yellow);
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .work-groups {
    counter-reset: project;
  }

  .work-group + .work-group {
    margin-top: clamp(5rem, 10vw, 10rem);
  }

  .work-group__heading {
    margin: 0;
    padding-bottom: var(--space-md);
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    font-weight: 740;
    letter-spacing: -.035em;
    line-height: 1;
  }

  .work-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--heavy-rule);
    border-left: var(--heavy-rule);
  }

  @media (max-width: 44rem) {
    .page-head { grid-template-columns: 1fr; }
    .page-head h1, .page-head__intro, .page-head__chapter { grid-column: 1; grid-row: auto; }
    .work-list { grid-template-columns: 1fr; border-right: var(--heavy-rule); }
  }
</style>
