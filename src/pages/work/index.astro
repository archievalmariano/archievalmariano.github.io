---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const selectedWork = work.filter((entry) => entry.data.featured);
const archiveWork = work.filter((entry) => !entry.data.featured);

const experiments = [
  {
    title: 'Pinned Shop',
    label: 'Commerce prototype',
    description:
      'A concept storefront for enamel pins and small collectibles, exploring how voice, collections, saving, cart, and checkout can make a fictional brand feel complete.',
    href: 'https://archievalmariano.com/pinned-shop/',
  },
  {
    title: 'Pinned Travel',
    label: 'Travel check-in prototype',
    description:
      'A private trip check-in concept built around routes, check-in windows, and sharing the latest plan with people you trust.',
    href: 'https://archievalmariano.com/pinned-travel/',
  },
];
---

<BaseLayout
  title="Work — Archieval Mariano"
  description="Selected projects across digital strategy, audience growth, content, analytics, e-commerce, and operations."
>
  <section class="wrap page-head">
    <p class="page-head__label">Work</p>
    <h1>Stories about audiences, systems, and digital work.</h1>
    <p class="page-head__intro">
      The projects are different on the surface. Underneath, most begin with the
      same question: how can information become something a team can actually use?
    </p>
  </section>

  <div class="wrap work-groups">
    <section class="work-group" aria-labelledby="selected-work-heading">
      <h2 class="work-group__heading" id="selected-work-heading">Selected case studies</h2>
      <ul class="work-list" role="list">
        {selectedWork.map((entry) => <WorkCard entry={entry} variant="selected" />)}
      </ul>
    </section>

    <section class="work-group work-group--archive" aria-labelledby="archive-heading">
      <h2 class="work-group__heading" id="archive-heading">More from the archive</h2>
      <ul class="work-list" role="list">
        {archiveWork.map((entry) => <WorkCard entry={entry} variant="archive" />)}
      </ul>
    </section>

    <section class="experiments" aria-labelledby="experiments-heading">
      <div class="experiments__head">
        <h2 id="experiments-heading">Product experiments</h2>
        <p class="experiments__intro">
          Independent prototypes exploring product ideas and interactions. These
          are not launched products or claims of measured outcomes.
        </p>
      </div>

      <ul class="experiments__list" role="list">
        {
          experiments.map((experiment, index) => (
            <li>
              <a
                class="experiment"
                href={experiment.href}
                target="_blank"
                rel="noopener"
                aria-labelledby={`experiment-${index}-title experiment-${index}-action`}
              >
                <div>
                  <p class="experiment__label">{experiment.label}</p>
                  <h3 id={`experiment-${index}-title`}>{experiment.title}</h3>
                  <p class="experiment__description">{experiment.description}</p>
                </div>
                <span class="experiment__link" id={`experiment-${index}-action`}>
                  Open prototype <span aria-hidden="true">↗</span>
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="experiments__note">
        The name is a callback to #Pinned, a label a colleague and I conceived and
        developed for an evergreen SEO project at GMA. Editorial later approved its
        use for search-focused service pieces designed to remain relevant over time.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: var(--space-md) clamp(2rem, 7vw, 8rem);
    padding-block: clamp(2.75rem, 5.5vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 17ch;
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 5vw, 5.6rem);
    font-weight: 760;
    letter-spacing: -.065em;
    line-height: .9;
  }

  .page-head__intro {
    grid-column: 2;
    max-width: 44rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__label {
    grid-row: 1 / span 2;
    margin: 0;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .work-group--archive,
  .experiments {
    margin-top: clamp(2.75rem, 5vw, 5rem);
  }

  .experiments {
    --experiment-rule: color-mix(in srgb, var(--paper) 36%, var(--blue-dark));
    --experiment-prose: color-mix(in srgb, var(--paper) 86%, var(--blue-dark));
    --experiment-muted: color-mix(in srgb, var(--paper) 72%, var(--blue-dark));
    margin-bottom: clamp(2.25rem, 5vw, 4.75rem);
    padding: clamp(1.25rem, 4vw, 3.25rem);
    background: var(--blue-dark);
    color: var(--paper);
  }

  .experiments__head {
    padding-bottom: clamp(1.35rem, 3vw, 2rem);
  }

  .experiments__head h2 {
    font-family: var(--font-sans);
    font-size: var(--step-3);
    font-weight: 740;
    letter-spacing: -.04em;
  }

  .experiments__intro {
    max-width: 38rem;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--experiment-prose);
  }

  .experiments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--experiment-rule);
  }

  .experiments__note {
    max-width: var(--measure);
    margin: 0;
    padding-top: clamp(1.1rem, 2.5vw, 1.75rem);
    font-family: var(--font-serif);
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.6;
    color: var(--experiment-muted);
  }

  .experiment {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-sm) var(--space-lg);
    align-items: start;
    padding-block: clamp(1.25rem, 2.8vw, 2.25rem);
    border-bottom: 1px solid var(--experiment-rule);
    color: var(--paper);
    text-decoration: none;
  }

  .experiment:is(:hover, :focus-visible) h3 {
    text-decoration: underline;
    text-decoration-thickness: .06em;
    text-underline-offset: .14em;
  }

  .experiment:focus-visible {
    outline-color: var(--paper);
  }

  .experiment__label,
  .experiment__link {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 720;
  }

  .experiment__label {
    margin: 0 0 var(--space-xs);
    color: var(--experiment-muted);
  }

  .experiment h3 {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 740;
    letter-spacing: -.045em;
    line-height: 1.08;
  }

  .experiment__description {
    max-width: 42rem;
    margin: .65rem 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--experiment-prose);
  }

  .experiment__link {
    white-space: nowrap;
  }

  .work-group__heading {
    margin: 0;
    padding-bottom: var(--space-md);
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    font-weight: 740;
    letter-spacing: -.035em;
    line-height: 1;
  }

  #selected-work-heading::before {
    content: '';
    display: block;
    width: 1.8rem;
    height: .22rem;
    margin-bottom: var(--space-xs);
    background: var(--yellow);
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 44rem) {
    .page-head { grid-template-columns: 1fr; }
    .page-head h1, .page-head__intro, .page-head__label { grid-column: 1; grid-row: auto; }
    .experiment { grid-template-columns: minmax(0, 1fr); }
  }
</style>
