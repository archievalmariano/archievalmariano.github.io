---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { hasCaseStudy } from '../../utils/work';

type WorkEntry = CollectionEntry<'work'>;
type Adjacent = { slug: string; title: string } | null;

export async function getStaticPaths() {
  // Only entries with narrative content get a detail page; listing-only
  // projects appear in listings but are never linked.
  const work = (await getCollection('work', ({ data }) => !data.draft))
    .filter(hasCaseStudy)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  return work.map((entry, i) => {
    const prev = work[i - 1];
    const next = work[i + 1];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prev: prev ? { slug: prev.slug, title: prev.data.title } : null,
        next: next ? { slug: next.slug, title: next.data.title } : null,
      },
    };
  });
}

interface Props {
  entry: WorkEntry;
  prev: Adjacent;
  next: Adjacent;
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const companyDisplay = d.anonymized ? 'Confidential' : d.companyOrClient;
const overview = d.overview ?? d.shortDescription;

// Metadata block — only rows with values render (role kept for its own section).
const facts: { label: string; value?: string }[] = [
  { label: 'Year', value: d.year },
  { label: 'Category', value: d.category },
  { label: 'Company', value: companyDisplay },
  { label: 'Tools', value: d.tools.length ? d.tools.join(', ') : undefined },
];

// Narrative sections that accept prose or a list.
const sections: { number: string; id: string; heading: string; value?: string | string[] }[] = [
  { number: '01', id: 'situation', heading: 'The situation', value: d.context },
  { number: '02', id: 'responsibility', heading: 'What I was responsible for', value: d.role },
  { number: '03', id: 'work', heading: 'What I did', value: d.approach },
  { number: '04', id: 'outcome', heading: 'What became possible', value: d.outcome },
];

const metaLine = [d.year, d.anonymized ? undefined : d.companyOrClient]
  .filter(Boolean)
  .join(' · ');
---

<EntryLayout
  title={d.title}
  description={d.shortDescription}
  eyebrow={d.category ? `Work · ${d.category}` : 'Work'}
  meta={metaLine}
  backHref="/work"
  backLabel="All work"
>
  <div class="opening">
    <div>
      <p class="opening__label">In brief</p>
      {overview && <p class="lede">{overview}</p>}
    </div>

    <dl class="facts">
      {
        facts
          .filter((f) => f.value)
          .map((f) => (
            <div class="facts__row">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
      }
    </dl>
  </div>

  {
    d.heroImage && (
      <figure class="cover">
        <Image src={d.heroImage} alt="" widths={[480, 800, 1200]} />
      </figure>
    )
  }

  <div class="story-index" aria-label="Case study sections">
    <p>Inside this story</p>
    <ol>
      {sections.filter((s) => s.value !== undefined).map((s) => <li><a href={`#${s.id}`}><span>{s.number}</span>{s.heading}</a></li>)}
    </ol>
  </div>

  {
    sections
      .filter((s) => s.value !== undefined)
      .map((s) => (
        <section class="story-section" id={s.id}>
          <p class="story-section__number">{s.number}</p>
          <h2>{s.heading}</h2>
          <div class="story-section__content">
            {Array.isArray(s.value) ? (
              <ul class="section__list">
                {s.value.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>{s.value}</p>
            )}
          </div>
        </section>
      ))
  }

  {
    d.metrics && d.metrics.length > 0 && (
      <section class="story-section" id="evidence">
        <p class="story-section__number">05</p>
        <h2>Selected evidence</h2>
        <div class="story-section__content">
          <ul class="section__list">
            {d.metrics.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.images && d.images.length > 0 && (
      <div class="gallery">
        {d.images.map((img) => (
          <figure>
            <Image src={img} alt="" widths={[480, 800]} />
          </figure>
        ))}
      </div>
    )
  }

  {
    d.confidentialityNote && (
      <p class="confidentiality-note">
        <strong>Confidentiality:</strong> {d.confidentialityNote}
      </p>
    )
  }

  <Content />

  {
    (prev || next) && (
      <nav class="adjacent" aria-label="More work">
        {prev ? (
          <a class="adjacent__link adjacent__prev" href={`/work/${prev.slug}`}>
            <span class="adjacent__dir">Previous</span>
            <span class="adjacent__title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="adjacent__link adjacent__next" href={`/work/${next.slug}`}>
            <span class="adjacent__dir">Next</span>
            <span class="adjacent__title">{next.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</EntryLayout>

<style>
  .lede {
    max-width: 43rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.2vw, 2.15rem);
    line-height: 1.4;
    color: var(--ink);
  }

  .opening {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, .6fr);
    gap: clamp(3rem, 9vw, 10rem);
    align-items: start;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .opening__label,
  .story-index > p {
    margin: 0 0 var(--space-md);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .cover {
    margin: var(--space-lg) 0;
  }

  .cover :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
  }

  .facts {
    margin: 0;
    padding: 0;
    border-top: var(--heavy-rule);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0;
  }

  .story-index {
    margin-bottom: clamp(5rem, 10vw, 10rem);
    padding: clamp(1.5rem, 3vw, 3rem);
    background: var(--yellow);
    border: var(--heavy-rule);
    box-shadow: .55rem .55rem 0 var(--ink);
  }

  .story-index ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-index a {
    display: grid;
    gap: .6rem;
    min-height: 7rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--paper) 48%, transparent);
    border: 1px solid var(--ink);
    font-size: .76rem;
    font-weight: 750;
    text-decoration: none;
  }

  .story-index a span {
    color: var(--ink-faint);
  }

  .story-section {
    display: grid;
    grid-template-columns: 4rem minmax(14rem, .5fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    margin: 0;
    padding-block: clamp(3rem, 7vw, 7rem);
    border-top: var(--heavy-rule);
    scroll-margin-top: 2rem;
  }

  .story-section__number {
    margin: 0;
    font-size: .74rem;
    font-weight: 800;
  }

  .story-section h2 {
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3vw, 3.6rem);
    font-weight: 740;
    letter-spacing: -.045em;
    line-height: 1;
  }

  .story-section__content {
    max-width: 48rem;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    line-height: 1.56;
  }

  .section__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section__list li {
    position: relative;
    margin: 0;
    padding: .75rem 0 .75rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .section__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--coral);
  }

  .gallery {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
  }

  .gallery :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
  }

  .confidentiality-note {
    max-width: 48rem;
    margin: var(--space-xl) 0 var(--space-xl) auto;
    padding: var(--space-md);
    border: 1px solid var(--ink);
    border-left: .65rem solid var(--coral);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .adjacent {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--heavy-rule);
  }

  .adjacent__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 45%;
  }

  .adjacent__next {
    text-align: right;
    margin-left: auto;
  }

  .adjacent__dir {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .adjacent__title {
    font-family: var(--font-serif);
    color: var(--ink);
  }

  .adjacent__link:hover .adjacent__title {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .opening {
      grid-template-columns: 1fr;
    }

    .facts__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .story-index ol {
      grid-template-columns: 1fr 1fr;
    }

    .story-section {
      grid-template-columns: 2rem 1fr;
    }

    .story-section__content {
      grid-column: 2;
    }
  }
</style>
