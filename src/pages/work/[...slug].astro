---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { hasCaseStudy } from '../../utils/work';

type WorkEntry = CollectionEntry<'work'>;
type Adjacent = { slug: string; title: string } | null;

export async function getStaticPaths() {
  // Only entries with narrative content get a detail page; listing-only
  // projects appear in listings but are never linked.
  const work = (await getCollection('work', ({ data }) => !data.draft))
    .filter(hasCaseStudy)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  return work.map((entry, i) => {
    const prev = work[i - 1];
    const next = work[i + 1];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prev: prev ? { slug: prev.slug, title: prev.data.title } : null,
        next: next ? { slug: next.slug, title: next.data.title } : null,
      },
    };
  });
}

interface Props {
  entry: WorkEntry;
  prev: Adjacent;
  next: Adjacent;
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const companyDisplay = d.anonymized ? 'Confidential' : d.companyOrClient;
const overview = d.overview ?? d.shortDescription;

// Metadata block — only rows with values render (role kept for its own section).
const facts: { label: string; value?: string }[] = [
  { label: 'Year', value: d.year },
  { label: 'Category', value: d.category },
  { label: 'Company', value: companyDisplay },
  { label: 'Tools', value: d.tools.length ? d.tools.join(', ') : undefined },
];

// Narrative sections that accept prose or a list.
const sections: { heading: string; value?: string | string[] }[] = [
  { heading: 'Context', value: d.context },
  { heading: 'My role', value: d.role },
  { heading: 'Approach', value: d.approach },
  { heading: 'Outcome', value: d.outcome },
];

const metaLine = [d.year, d.anonymized ? undefined : d.companyOrClient]
  .filter(Boolean)
  .join(' · ');
---

<EntryLayout
  title={d.title}
  description={d.shortDescription}
  eyebrow={d.category ? `Work · ${d.category}` : 'Work'}
  meta={metaLine}
  backHref="/work"
  backLabel="All work"
>
  {overview && <p class="lede">{overview}</p>}

  {
    d.heroImage && (
      <figure class="cover">
        <Image src={d.heroImage} alt="" widths={[480, 800, 1200]} />
      </figure>
    )
  }

  <dl class="facts">
    {
      facts
        .filter((f) => f.value)
        .map((f) => (
          <div class="facts__row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
    }
  </dl>

  {
    sections
      .filter((s) => s.value !== undefined)
      .map((s) => (
        <section class="section">
          <h2>{s.heading}</h2>
          {Array.isArray(s.value) ? (
            <ul class="section__list">
              {s.value.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{s.value}</p>
          )}
        </section>
      ))
  }

  {
    d.metrics && d.metrics.length > 0 && (
      <section class="section">
        <h2>Metrics</h2>
        <ul class="section__list">
          {d.metrics.map((m) => (
            <li>{m}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    d.images && d.images.length > 0 && (
      <div class="gallery">
        {d.images.map((img) => (
          <figure>
            <Image src={img} alt="" widths={[480, 800]} />
          </figure>
        ))}
      </div>
    )
  }

  {
    d.confidentialityNote && (
      <p class="confidentiality-note">
        <strong>Confidentiality:</strong> {d.confidentialityNote}
      </p>
    )
  }

  <Content />

  {
    (prev || next) && (
      <nav class="adjacent" aria-label="More work">
        {prev ? (
          <a class="adjacent__link adjacent__prev" href={`/work/${prev.slug}`}>
            <span class="adjacent__dir">Previous</span>
            <span class="adjacent__title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="adjacent__link adjacent__next" href={`/work/${next.slug}`}>
            <span class="adjacent__dir">Next</span>
            <span class="adjacent__title">{next.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</EntryLayout>

<style>
  .lede {
    font-size: var(--step-1);
    color: var(--ink);
  }

  .cover {
    margin: var(--space-lg) 0;
  }

  .cover :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
  }

  .facts {
    margin: var(--space-lg) 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0;
  }

  .section {
    margin-top: var(--space-lg);
  }

  .section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-sm);
  }

  .section__list {
    margin: 0;
    padding-left: 1.2em;
  }

  .section__list li {
    margin-bottom: 0.4em;
  }

  .gallery {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-md);
  }

  .gallery :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
  }

  .confidentiality-note {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    border-left: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .adjacent {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .adjacent__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 45%;
  }

  .adjacent__next {
    text-align: right;
    margin-left: auto;
  }

  .adjacent__dir {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .adjacent__title {
    font-family: var(--font-serif);
    color: var(--ink);
  }

  .adjacent__link:hover .adjacent__title {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
