---
import type { InferGetStaticPropsType } from 'astro';
import WorkCaseStudy from '../../components/WorkCaseStudy.astro';
import { getPublicCaseStudies } from '../../utils/work';

export async function getStaticPaths() {
  const work = await getPublicCaseStudies();
  return work.map((entry, index) => {
    const prev = work[index - 1];
    const next = work[index + 1];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prev: prev ? { slug: prev.slug, title: prev.data.title } : null,
        next: next ? { slug: next.slug, title: next.data.title } : null,
      },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
---

<WorkCaseStudy data={entry.data} {prev} {next}>
  <Content />
</WorkCaseStudy>
