---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/photos/archieval-portrait.jpg';
import singapore from '../assets/photos/archieval-singapore.jpg';
import { hero } from '../data/site';

const featuredWork = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const recentWriting = (await getCollection('writing', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.slug < b.slug ? -1 : 1))
  .slice(0, 3);

const projectVisuals = [
  {
    className: 'visual--audience',
    kicker: 'Decision interface',
    stat: '05',
    statLabel: 'source-labeled intelligence platforms',
    marks: ['GA4', 'Similarweb', 'Semrush', 'Chartbeat', 'Google Trends'],
  },
  {
    className: 'visual--editorial',
    kicker: 'Audience system',
    stat: '≈40',
    statLabel: 'targetable audience segments',
    marks: ['Automotive', 'Online shoppers', 'Gamers', 'Beauty', 'Entrepreneurs'],
  },
  {
    className: 'visual--commerce',
    kicker: 'Commerce system',
    stat: '01',
    statLabel: 'connected growth loop',
    marks: ['Social', 'Marketplace', 'Owned channel'],
  },
];
---

<BaseLayout
  title="Archieval Mariano | Digital Strategy, Audience Growth & Systems"
  description="Archieval Mariano is a digital strategy and audience growth professional based in the Philippines, working across strategy, content, analytics, e-commerce, and digital operations."
>
  <section class="cover wrap-wide">
    <div class="cover__copy">
      <p class="chapter-label"><span>00</span> Introduction</p>
      <p class="cover__eyebrow">{hero.eyebrow}</p>
      <h1>Have you heard of AI? Not that one.</h1>
      <p class="cover__statement">
        I work with AI. Audience intelligence, that is. I turn insight into better digital work.
      </p>
      <p class="cover__intro">
        Across strategy, content, analytics, e-commerce, and digital operations, I help
        teams understand their audiences, build useful systems, and turn ideas into
        scalable programs.
      </p>
      <div class="cover__actions">
        <a class="button button--ink" href="#selected-work">Explore my work</a>
        <a class="text-link" href="/about">A little about me <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <figure class="cover__portrait">
      <Image
        src={portrait}
        alt="Archieval Mariano seated at a table, resting his face on one hand"
        width={1120}
        widths={[560, 840, 1120]}
        sizes="(max-width: 760px) 100vw, 42vw"
        format="webp"
        quality={76}
        loading="eager"
      />
      <figcaption>
        <span>Archieval Mariano</span>
        <span>Personal archive</span>
      </figcaption>
    </figure>
  </section>

  <section class="thesis wrap-wide" aria-labelledby="thesis-title">
    <p class="chapter-label chapter-label--light"><span>01</span> The throughline</p>
    <div class="thesis__grid">
      <h2 id="thesis-title">The useful work often happens between the disciplines.</h2>
      <div class="thesis__body">
        <p>
          I started in digital publishing as a writer and editor. The questions eventually
          became larger: who are we trying to reach, why does something perform, and what
          kind of system would make the work repeatable?
        </p>
        <p>
          That path now runs through audience intelligence, content strategy, analytics,
          e-commerce and digital operations. The medium changes. The interest in making
          complicated work clearer does not.
        </p>
      </div>
    </div>
  </section>

  <section class="projects wrap-wide" id="selected-work" aria-labelledby="work-title">
    <header class="section-intro">
      <p class="chapter-label"><span>02</span> Selected work</p>
      <div class="section-intro__main">
        <h2 id="work-title">Selected stories about turning information into something people can use.</h2>
        <div class="section-intro__aside">
          <p>Data alone isn&rsquo;t enough. It needs to be actionable, too. These selected projects span audience intelligence, content strategy, and digital growth.</p>
          <a href="/work" class="text-link">See all work <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <div class="project-chapters">
      {
        featuredWork.map((entry, index) => {
          const d = entry.data;
          const visual = projectVisuals[index];
          return (
            <article class="project-chapter">
              <a class="project-chapter__visual" href={`/work/${entry.slug}`} aria-hidden="true" tabindex="-1">
                <div class:list={['evidence-visual', visual.className]}>
                  <p>{visual.kicker}</p>
                  <div class="evidence-visual__stat">
                    <strong>{visual.stat}</strong>
                    <span>{visual.statLabel}</span>
                  </div>
                  <ul>
                    {visual.marks.map((mark) => <li>{mark}</li>)}
                  </ul>
                </div>
              </a>
              <div class="project-chapter__copy">
                <p class="project-chapter__number">0{index + 1}</p>
                <p class="meta">{[d.year, d.category].filter(Boolean).join(' · ')}</p>
                <h3><a href={`/work/${entry.slug}`}>{d.title}</a></h3>
                <p class="project-chapter__description">{d.shortDescription}</p>
                <p class="project-chapter__org">{d.anonymized ? 'Confidential' : d.companyOrClient}</p>
                <a class="text-link" href={`/work/${entry.slug}`}>Read the story <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="panorama">
    <figure>
      <Image
        src={singapore}
        alt="Archieval Mariano seen from behind, looking toward the Singapore skyline"
        width={1600}
        widths={[768, 1280, 1600]}
        sizes="100vw"
        format="webp"
        quality={76}
      />
      <figcaption class="wrap-wide">
        <span>Personal archive · Singapore</span>
      </figcaption>
    </figure>
  </section>

  <section class="notes wrap-wide" aria-labelledby="notes-title">
    <header class="section-intro section-intro--compact">
      <p class="chapter-label"><span>03</span> Field notes</p>
      <div class="section-intro__main">
        <h2 id="notes-title">Some of my writing from before I was consumed by dashboards and moving lines and graphs.</h2>
        <div class="section-intro__aside">
          <p>Commissioned editorial and branded work for publications and clients, including pieces that ran without a byline.</p>
          <a href="/writing" class="text-link">All writing <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <ol class="notes__list">
      {
        recentWriting.map((entry, index) => {
          const d = entry.data;
          const href = d.externalURL ?? `/writing/${entry.slug}`;
          const isExternal = Boolean(d.externalURL);
          return (
            <li>
              <a href={href} {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="notes__number">0{index + 1}</span>
                <span class="notes__main">
                  <strong>{d.displayTitle ?? d.title}</strong>
                  <span>{d.description}</span>
                </span>
                <span class="notes__publisher">{d.publisher ?? 'Field note'}</span>
                <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="closing-panel wrap-wide">
    <p class="chapter-label chapter-label--light"><span>04</span> There&rsquo;s always more</p>
    <div>
      <h2>What happened IRL could not possibly fit in a two-page CV.</h2>
      <div class="closing-panel__copy">
        <p>
          The longer version includes editorial work, branded campaigns, audience systems,
          product experiments, and the operational details that make ideas survive contact
          with actual work.
        </p>
        <div class="closing-panel__actions">
          <a class="button button--paper" href="/about">Read about me</a>
          <a class="text-link text-link--light" href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(:root) {
    --home-display: clamp(3.2rem, 6vw, 6.5rem);
    --home-section: clamp(2.35rem, 4.2vw, 4.75rem);
    --home-subhead: clamp(1.65rem, 2.6vw, 2.75rem);
    --home-lede: clamp(1.25rem, 1.8vw, 1.65rem);
    --home-copy: clamp(1rem, 1.1vw, 1.12rem);
  }

  .wrap-wide { width: min(100%, 92rem); margin-inline: auto; padding-inline: var(--gutter); }
  .chapter-label { display: flex; gap: .75rem; align-items: center; margin: 0 0 var(--space-lg); font-family: var(--font-sans); font-size: .72rem; font-weight: 750; line-height: 1; letter-spacing: .13em; text-transform: uppercase; color: var(--ink-faint); }
  .chapter-label span { display: inline-grid; flex: 0 0 2rem; place-items: center; box-sizing: border-box; width: 2rem; height: 2rem; border: 1px solid currentColor; font-family: var(--font-sans); font-size: .72rem; font-weight: 750; line-height: 1; letter-spacing: 0; font-variant-numeric: tabular-nums; }
  .chapter-label--light { color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .cover { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(24rem, .75fr); min-height: calc(100svh - 5rem); padding-top: clamp(3.5rem, 8vw, 8rem); padding-bottom: clamp(3rem, 7vw, 7rem); gap: clamp(2.5rem, 7vw, 8rem); align-items: center; }
  .cover h1 { max-width: 12ch; font-family: var(--font-sans); font-size: var(--home-display); font-weight: 760; letter-spacing: -.06em; line-height: .98; }
  .cover__eyebrow { margin: 0 0 var(--space-md); font-size: var(--step--1); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-ink); }
  .cover__statement { max-width: 34rem; margin: var(--space-lg) 0 0; font-family: var(--font-serif); font-size: var(--home-lede); line-height: 1.4; }
  .cover__intro { max-width: 39rem; margin: var(--space-md) 0 0; font-size: var(--home-copy); line-height: 1.6; color: var(--ink-soft); }
  .cover__actions, .closing-panel__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem 2rem; margin-top: var(--space-lg); }
  .cover__portrait { position: relative; width: 100%; max-height: 42rem; aspect-ratio: 4 / 5; margin: 0; align-self: center; overflow: hidden; background: var(--blue-soft); border: var(--heavy-rule); box-shadow: .75rem .75rem 0 var(--yellow); }
  .cover__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 47% center; filter: saturate(.82) contrast(1.04); }
  .cover__portrait figcaption { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; gap: 1rem; padding: .7rem .9rem; background: var(--ink); color: var(--paper); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .button { display: inline-flex; align-items: center; min-height: 3.2rem; padding: .75rem 1.1rem; border: 2px solid currentColor; font-size: .76rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; text-decoration: none; box-shadow: .3rem .3rem 0 var(--coral); }
  .button--ink { background: var(--ink); color: var(--paper); }
  .button--paper { background: var(--paper); color: var(--ink); box-shadow: .3rem .3rem 0 var(--yellow); }
  .text-link { font-size: .77rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; text-decoration-thickness: 1px; text-underline-offset: .35em; }
  .text-link--light { color: var(--paper); }
  .thesis { padding-top: clamp(4rem, 8vw, 8rem); padding-bottom: clamp(4rem, 8vw, 8rem); background: var(--ink); color: var(--paper); box-shadow: 0 0 0 100vmax var(--ink); clip-path: inset(0 -100vmax); }
  .thesis__grid { display: grid; grid-template-columns: 1fr .8fr; gap: clamp(2rem, 8vw, 9rem); align-items: start; }
  .thesis h2 { max-width: 15ch; font-family: var(--font-sans); font-size: var(--home-section); font-weight: 750; letter-spacing: -.05em; line-height: .98; }
  .thesis__body { max-width: 38rem; font-family: var(--font-serif); font-size: var(--home-lede); line-height: 1.5; color: color-mix(in srgb, var(--paper) 82%, transparent); }
  .projects, .notes { padding-top: clamp(3.5rem, 6vw, 6rem); padding-bottom: clamp(3.5rem, 7vw, 7rem); }
  .section-intro { margin-bottom: clamp(2.5rem, 4vw, 4rem); }
  .section-intro .chapter-label { margin-bottom: clamp(3rem, 5vw, 5rem); }
  .section-intro__main { display: grid; grid-template-columns: minmax(0, .95fr) minmax(22rem, .75fr); gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .section-intro__aside { display: grid; justify-items: start; gap: var(--space-lg); }
  .section-intro h2 { max-width: 22ch; font-family: var(--font-sans); font-size: var(--home-section); font-weight: 740; letter-spacing: -.045em; line-height: 1; }
  .section-intro__aside p { max-width: 36rem; margin: 0; font-family: var(--font-serif); font-size: var(--home-lede); line-height: 1.5; color: var(--ink-soft); }
  .project-chapters { border-top: var(--heavy-rule); }
  .project-chapter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, .82fr); border-bottom: var(--heavy-rule); }
  .project-chapter__visual { display: block; padding: clamp(1.5rem, 4vw, 4rem); color: var(--ink); text-decoration: none; border-right: var(--heavy-rule); }
  .project-chapter__copy { padding: clamp(2rem, 5vw, 5rem); }
  .project-chapter__number { margin: 0 0 var(--space-xl); font-size: .78rem; font-weight: 800; }
  .project-chapter h3 { margin: var(--space-sm) 0; font-family: var(--font-sans); font-size: var(--home-subhead); font-weight: 750; letter-spacing: -.04em; line-height: 1.03; }
  .project-chapter h3 a { text-decoration: none; }
  .project-chapter__description { margin: var(--space-md) 0; font-family: var(--font-serif); font-size: var(--home-copy); line-height: 1.58; color: var(--ink-soft); }
  .project-chapter__org { margin: 0 0 var(--space-lg); font-size: var(--step--1); font-weight: 700; }
  .evidence-visual { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 34rem; padding: clamp(1.4rem, 3vw, 3rem); overflow: hidden; border: var(--heavy-rule); box-shadow: .65rem .65rem 0 var(--ink); }
  .evidence-visual > p { position: relative; z-index: 1; margin: 0; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .evidence-visual__stat { position: relative; z-index: 1; display: flex; align-items: end; gap: 1rem; }
  .evidence-visual__stat strong { font-size: clamp(5rem, 10vw, 10rem); letter-spacing: -.09em; line-height: .72; }
  .evidence-visual__stat span { max-width: 9rem; font-size: .78rem; font-weight: 750; line-height: 1.2; text-transform: uppercase; }
  .evidence-visual ul { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .45rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .evidence-visual li { padding: .35rem .6rem; background: var(--paper); border: 1px solid var(--ink); font-size: .68rem; font-weight: 700; }
  .visual--audience { background: var(--blue-soft); }
  .visual--audience::after { content: ''; position: absolute; width: 24rem; aspect-ratio: 1; right: -6rem; top: -6rem; border: 5rem solid var(--blue); border-radius: 50%; opacity: .58; }
  .visual--editorial { background: var(--yellow); }
  .visual--editorial::after { content: '20'; position: absolute; right: -.03em; top: -.15em; color: color-mix(in srgb, var(--paper) 55%, transparent); font-size: 22rem; font-weight: 850; letter-spacing: -.12em; line-height: 1; }
  .visual--commerce { background: var(--coral); }
  .visual--commerce::after { content: ''; position: absolute; inset: 13% 10%; background: repeating-linear-gradient(90deg, transparent 0 4rem, color-mix(in srgb, var(--ink) 16%, transparent) 4rem 4.1rem), repeating-linear-gradient(0deg, transparent 0 4rem, color-mix(in srgb, var(--ink) 16%, transparent) 4rem 4.1rem); }
  .panorama { border-block: var(--heavy-rule); }
  .panorama figure { margin: 0; }
  .panorama :global(img) { width: 100%; max-height: 82vh; object-fit: cover; object-position: center; filter: saturate(.8) contrast(1.04); }
  .panorama figcaption { display: flex; justify-content: space-between; gap: 2rem; padding-top: .8rem; padding-bottom: .8rem; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .section-intro--compact { margin-bottom: clamp(2.5rem, 4vw, 4rem); }
  .notes__list { margin: 0; padding: 0; border-top: var(--heavy-rule); list-style: none; }
  .notes__list li { border-bottom: var(--heavy-rule); }
  .notes__list a { display: grid; grid-template-columns: 3rem minmax(0, 1fr) 11rem 1rem; gap: clamp(1rem, 3vw, 3rem); align-items: start; padding-block: clamp(1.5rem, 3vw, 2.5rem); text-decoration: none; }
  .notes__number, .notes__publisher { font-size: .72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); }
  .notes__main { display: grid; gap: .55rem; }
  .notes__main strong { max-width: 32ch; font-family: var(--font-serif); font-size: var(--home-subhead); font-weight: 550; letter-spacing: -.02em; line-height: 1.08; }
  .notes__main > span { max-width: 60ch; font-size: var(--home-copy); color: var(--ink-soft); }
  .closing-panel { padding-top: clamp(4rem, 6vw, 6rem); padding-bottom: clamp(4rem, 6vw, 6rem); background: var(--blue-dark); color: var(--paper); box-shadow: 0 0 0 100vmax var(--blue-dark); clip-path: inset(0 -100vmax); }
  .closing-panel > div { display: grid; grid-template-columns: minmax(0, .95fr) minmax(22rem, .75fr); gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .closing-panel h2 { max-width: 19ch; font-family: var(--font-sans); font-size: clamp(2.5rem, 3.6vw, 4rem); font-weight: 750; letter-spacing: -.045em; line-height: 1; }
  .closing-panel__copy > p { max-width: 36rem; font-family: var(--font-serif); font-size: var(--home-lede); line-height: 1.52; color: color-mix(in srgb, var(--paper) 86%, transparent); }
  .closing-panel > .chapter-label { font-family: var(--font-sans); font-size: .72rem; font-weight: 750; line-height: 1; letter-spacing: .13em; }
  @media (max-width: 64rem) {
    .cover, .thesis__grid, .closing-panel > div { grid-template-columns: 1fr; }
    .cover__portrait { width: min(100%, 42rem); max-height: none; aspect-ratio: 4 / 3; }
    .section-intro__main { grid-template-columns: 1fr; align-items: start; }
    .project-chapter { grid-template-columns: 1fr; }
    .project-chapter__visual { border-right: 0; border-bottom: var(--heavy-rule); }
  }
  @media (max-width: 44rem) {
    .cover { min-height: auto; padding-top: 3rem; }
    .cover__portrait { aspect-ratio: 16 / 10; }
    .section-intro .chapter-label { margin-bottom: 2.5rem; }
    .evidence-visual { min-height: 27rem; }
    .project-chapter__copy { padding-inline: 0; }
    .notes__list a { grid-template-columns: 2rem minmax(0, 1fr) 1rem; }
    .notes__publisher { display: none; }
    .panorama :global(img) { height: 72vh; object-position: 53% center; }
    .panorama figcaption { display: grid; gap: .25rem; }
  }
</style>
