---
// Homepage — "Quiet Personal Site" (exploration D, approved at 37b8416 on
// redesign/home-explorations). Ported from the gated preview component with
// its markup, copy, and styles intact; the header and footer now live in the
// shared Nav/Footer components.
//
// Information architecture (every link points at an existing URL):
//   Desk     Projects       /desk/projects/  (published)
//            Artifacts      gated by src/data/desk.ts — no link until launched
//            Field Notes    gated by src/data/desk.ts — no link until launched
//   Work     Case studies   /work/  · Prototypes /pinned-shop/, /pinned-travel/
//            Commissioned writing  /writing/
//            Services       /services/
//
// DESK rows: a row EXPANDS (identity, description, link, one featured item)
// only when its subsection has published content; otherwise it stays COMPACT
// (name, subtitle, description — no link, URL, notice, or empty media area).
// Artifacts / Field Notes use the existing gate (isPublished, read-only) and
// unpublished collections are never queried.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { deskCollections, isPublished, type DeskCollectionKey } from '../data/desk';
import { siteLinks } from '../data/site';
import { hasCaseStudy } from '../utils/work';
import portrait from '../assets/photos/archieval-portrait.jpg';
import taipeiStreet from '../assets/photos/about-taipei-street.jpg';
import baywalkCat from '../assets/photos/about-baywalk-cat.jpg';
import esplanadeBridge from '../assets/photos/about-esplanade-bridge.jpg';
import onPointBoard from '../assets/photos/onpoint-01-board.jpg';
import gotoStory from '../assets/photos/goto-edition-01-story.jpg';
// Screenshots of the Pinned prototypes (provenance: docs/redesign/production-candidate/).
import pinnedShopShot from '../assets/prototypes/pinned-shop-mobile.jpg';
import pinnedTravelShot from '../assets/prototypes/pinned-travel-mobile.jpg';

const HOME_CASE_STUDIES = 2;

// ── Existing copy reused from the previous homepage, About, and Work pages ──
const portraitAlt = 'Archieval Mariano seated at a table, resting his face on one hand';
const closing = {
  title: 'What happened IRL could not possibly fit in a two-page CV.',
  body:
    'The longer version includes editorial work, branded campaigns, audience systems, product experiments, and the operational details that make ideas survive contact with actual work.',
};
const workIntroTitle = 'Selected stories about turning information into something people can use.';
const writingAside =
  'Commissioned editorial and branded work for publications and clients, including pieces that ran without a byline.';
// Photographs and captions as published on /about/.
const tall = {
  src: taipeiStreet,
  alt: "A vertical view along Chang'an West Road in Taipei, framed by buildings and road markings",
  caption: 'A very vertical panorama somewhere in Taipei',
};
const upper = {
  src: baywalkCat,
  alt: 'A black-and-white cat walking beside Manila Bay on a bright Sunday morning',
  caption: 'Sunday morning along the Pasay Baywalk',
};
const lower = {
  src: esplanadeBridge,
  alt: 'A brightly lit convenience store framed by the dark underside of Esplanade Bridge in Singapore',
  caption: 'Beneath Esplanade Bridge in Singapore',
};

// ── Prototypes (Work) ── titles, labels, and descriptions mirror /work/.
const prototypeNote =
  'Independent prototypes exploring product ideas and interactions. These are not launched products or claims of measured outcomes.';
const prototypes: { title: string; label: string; description: string; path: string; shot: { src: ImageMetadata; alt: string } }[] = [
  {
    title: 'Pinned Shop',
    label: 'Commerce prototype',
    description:
      'A concept storefront for enamel pins and small collectibles, exploring how voice, collections, saving, cart, and checkout can make a fictional brand feel complete.',
    path: '/pinned-shop/',
    shot: {
      src: pinnedShopShot,
      alt: 'The Pinned Shop prototype’s home page on a phone, showing a limited enamel pin drop called “Last Trip Home.”',
    },
  },
  {
    title: 'Pinned Travel',
    label: 'Travel check-in prototype',
    description:
      'A private trip check-in concept built around routes, check-in windows, and sharing the latest plan with people you trust.',
    path: '/pinned-travel/',
    shot: {
      src: pinnedTravelShot,
      alt: 'The Pinned Travel prototype’s home page on a phone, headed “Let someone know the plan,” with three steps: map the trip, place check-in pins, and choose who knows.',
    },
  },
];

const caseStudies = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, HOME_CASE_STUDIES);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

// ── DESK rows ───────────────────────────────────────────────────────────────
type Featured = {
  title: string;
  subtitle?: string;
  description: string;
  meta?: string;
  href: string;
  linkLabel: string;
  image?: { src: ImageMetadata; alt: string };
  frame?: string; // CSS custom properties for a framed (cropped) screen
};
type Row = {
  key: string;
  name: string;
  subtitle?: string;
  description: string;
  href?: string; // only for published destinations
  linkLabel?: string;
  featured?: Featured;
};

// Projects: data-driven featured project.
const eligibleProjects = projects.filter((p) => p.data.homepage && p.data.heroImage); // sorted by `order`
const featuredProject = eligibleProjects.find((p) => p.data.featured) ?? eligibleProjects[0];

// Optional presentation hints, used only if one of these projects becomes the
// featured one: frame an existing, unmodified photograph to its screen (crop
// box in source pixels) so the image shows what the project does.
const framing: Record<string, { src: ImageMetadata; alt: string; box: [number, number, number, number] }> = {
  'on-point': {
    src: onPointBoard,
    alt: 'ON POINT showing 15 minutes until the 09:30 bus from Balagtas to TriNoma, with the next trip at 10:00 and the last at 20:00.',
    box: [262, 178, 846, 1075],
  },
  goto: {
    src: gotoStory,
    alt: 'The top story of a GOTO morning edition: Carlos Yulo shows support for Alex Eala, EJ Obiena ahead of Asian Games campaigns.',
    box: [198, 146, 918, 634],
  },
};

function projectFeature(): Featured | undefined {
  if (!featuredProject) return undefined;
  const d = featuredProject.data;
  const f = framing[d.slug];
  return {
    title: d.name,
    subtitle: d.subtitle && d.subtitle !== d.name ? d.subtitle : undefined,
    description: d.purpose,
    meta: d.facts.join(' · '),
    href: `/desk/${d.slug}/`,
    linkLabel: `Open ${d.name}`,
    image: f ? { src: f.src, alt: f.alt } : { src: d.heroImage!, alt: d.heroAlt ?? '' },
    frame: f
      ? `--iw:${f.src.width};--cx:${f.box[0]};--cy:${f.box[1]};--cw:${f.box[2] - f.box[0]};--ch:${f.box[3] - f.box[1]}`
      : undefined,
  };
}

// ── APPROVED COPY ───────────────────────────────────────────────────────────
// Reproduced exactly as approved by the author; apostrophes are typographic ’.
// Do not paraphrase.
const copy = {
  hero: {
    headline: 'Have you heard of AI? Not that one.',
    statement: 'I work with AI. Audience intelligence, that is. Turning insight into better digital work.',
  },
  desk: {
    intro:
      'Things from my digital desk that I’ve decided to share. Some can be useful, definitely specific, and occasionally unnecessary.',
    projects: { subtitle: 'Works in Progress', description: 'Independent applications, utilities, and experiments.' },
    artifacts: {
      subtitle: 'As Things Stand',
      description: 'Notes on objects I’ve lived with as they turn from purchases into artifacts (and sometimes back).',
    },
    fieldNotes: { subtitle: 'From the Margins', description: 'Thoughts that have managed to escape from my numerous draft folders.' },
  },
  away: {
    heading: 'Away from the dashboards',
    subheading: 'The bored storyteller pretending to be a photographer and a good writer.',
    body: [
      'That is how I describe myself on Instagram, where I put photographs and the occasional poem or piece of prose. It captures my discomfort with calling myself a photographer, or even a good writer, despite spending years taking photographs and writing.',
      'I’ve been told I’m an amazing conversationalist. I choose to interpret that as being an acquired taste.',
    ],
  },
  work: {
    heading: 'Work',
    subheading: 'The heart of it has always been writing.',
    body: [
      'When I write, I often know the ending before I’ve written the opening. Sometimes it’s the final line, sometimes a kicker, sometimes a quote. The interesting part is figuring out how to get there.',
      'I approach other work much the same way. I start with an outcome in mind and work backward through the decisions needed to reach it.',
      'Of course, the result still has to survive contact with actual work. It has to make sense to the people using it, respect the limits they work within, and remain useful long after the presentation ends.',
    ],
  },
} as const;

async function editorialFeature(key: DeskCollectionKey, slug: string): Promise<Featured | undefined> {
  const all = await getCollection(key as any, ({ data }: any) => !data.draft);
  const sorted = [...all].sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const e: any = sorted.find((x: any) => x.data.featured) ?? sorted[0];
  if (!e) return undefined;
  return {
    title: e.data.title,
    subtitle: e.data.subtitle,
    description: e.data.description,
    href: `/desk/${slug}/${e.slug}/`,
    linkLabel: 'Read',
    image: e.data.heroImage ? { src: e.data.heroImage, alt: e.data.heroAlt ?? '' } : undefined,
  };
}

const rows: Row[] = [
  {
    key: 'projects',
    name: 'Projects',
    subtitle: copy.desk.projects.subtitle,
    description: copy.desk.projects.description,
    href: '/desk/projects/',
    linkLabel: 'All projects',
    featured: projectFeature(),
  },
];
for (const c of deskCollections) {
  // Unpublished → compact row; the collection is not queried at all.
  const featured = isPublished(c.key) ? await editorialFeature(c.key, c.slug) : undefined;
  rows.push(
    featured
      ? { key: c.slug, name: c.label, subtitle: copy.desk[c.key].subtitle, description: copy.desk[c.key].description, href: `/desk/${c.slug}/`, linkLabel: `All ${c.label}`, featured }
      : { key: c.slug, name: c.label, subtitle: copy.desk[c.key].subtitle, description: copy.desk[c.key].description }
  );
}

// ── Photographs: one tall image beside a stack of two. The tall column's
// width is solved from the photos' own proportions (and the one caption row
// inside the stack) so the tall image ends where the lower landscape ends and
// the two bottom captions share a line. No image is cropped.
const invTall = tall.src.height / tall.src.width; // 1 / aspect
const invStack = upper.src.height / upper.src.width + lower.src.height / lower.src.width;
const photoVars = `--inv-stack:${invStack};--solve:${1 / (invTall + invStack)}`;
---

<BaseLayout
  title="Archieval Mariano | Digital Strategy, Audience Growth & Systems"
  description="Archieval Mariano is a digital strategy and audience growth professional based in the Philippines, working across strategy, content, analytics, e-commerce, and digital operations."
>
<div class="qs">
  <!-- 1 · Introduction -->
  <section class="qs-wrap qs-intro" aria-labelledby="qs-title">
    <div class="qs-intro__copy">
      <h1 id="qs-title">{copy.hero.headline}</h1>
      <p class="qs-intro__statement">{copy.hero.statement}</p>
      <p class="qs-links">
        <a href="#qs-work">Explore my work <span aria-hidden="true">→</span></a>
        <a href="/about/">A little about me <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <figure class="qs-intro__portrait">
      <Image
        src={portrait}
        alt={portraitAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 52rem) min(100vw, 30rem), 28rem"
        format="webp"
        quality={76}
        loading="eager"
      />
    </figure>
  </section>

  <!-- 2 · Desk -->
  <section class="qs-section qs-desk" aria-labelledby="qs-desk-title">
    <div class="qs-wrap">
      <header class="qs-section__head">
        <h2 id="qs-desk-title"><a href="/desk/">Desk</a></h2>
        <p>{copy.desk.intro}</p>
      </header>

      <div class="qs-rows">
        {
          rows.map((r) => (
            <section class:list={['qs-row', r.featured ? 'qs-row--featured' : 'qs-row--compact']} aria-label={r.name}>
              <div class="qs-row__id">
                <h3 class="qs-row__name">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</h3>
                {r.subtitle && <p class="qs-row__subtitle">{r.subtitle}</p>}
              </div>
              <div class="qs-row__about">
                <p class="qs-row__desc">{r.description}</p>
                {r.href && r.linkLabel && (
                  <p class="qs-go"><a href={r.href}>{r.linkLabel} <span aria-hidden="true">→</span></a></p>
                )}
              </div>
              {r.featured && (
                <article class:list={['qs-feature', { 'qs-feature--text': !r.featured.image }]}>
                  {r.featured.image && (
                    <figure class:list={['qs-feature__figure', { 'qs-frame': r.featured.frame }]} style={r.featured.frame}>
                      <Image src={r.featured.image.src} alt={r.featured.image.alt} widths={[240, 360, 480, 720]} sizes="(max-width: 36rem) 40vw, 11rem" format="webp" quality={76} />
                    </figure>
                  )}
                  <div class="qs-feature__text">
                    <h4>{r.featured.title}</h4>
                    {r.featured.subtitle && <p class="qs-feature__subtitle">{r.featured.subtitle}</p>}
                    <p class="qs-feature__desc">{r.featured.description}</p>
                    {r.featured.meta && <p class="qs-meta">{r.featured.meta}</p>}
                    <p class="qs-go">
                      <a href={r.featured.href}>
                        {r.featured.linkLabel}
                        {r.featured.linkLabel === 'Read' && <span class="visually-hidden"> {r.featured.title}</span>}
                        <span aria-hidden="true"> →</span>
                      </a>
                    </p>
                  </div>
                </article>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 · Away from the dashboards -->
  <section class="qs-section qs-away" aria-labelledby="qs-away-title">
    <div class="qs-wrap qs-away__grid">
      <div class="qs-away__copy">
        <h2 id="qs-away-title">{copy.away.heading}</h2>
        <p class="qs-away__lead">{copy.away.subheading}</p>
        {copy.away.body.map((p) => <p>{p}</p>)}
        <p class="qs-go"><a href="/about/">More about me <span aria-hidden="true">→</span></a></p>
      </div>

      <div class="qs-photos-wrap" style={photoVars}>
        <div class="qs-photos" aria-label="Selected photographs from my personal archive" oncontextmenu="return false">
          <figure class="qs-photo qs-photo--tall">
            <Image src={tall.src} alt={tall.alt} widths={[300, 450, 600]} sizes="(max-width: 36rem) 55vw, 14rem" format="webp" quality={76} draggable="false" />
            <figcaption>{tall.caption}</figcaption>
          </figure>
          <figure class="qs-photo qs-photo--upper">
            <Image src={upper.src} alt={upper.alt} widths={[480, 720, 960]} sizes="(max-width: 36rem) 90vw, 26rem" format="webp" quality={76} draggable="false" />
            <figcaption>{upper.caption}</figcaption>
          </figure>
          <figure class="qs-photo qs-photo--lower">
            <Image src={lower.src} alt={lower.alt} widths={[480, 720, 960]} sizes="(max-width: 36rem) 90vw, 26rem" format="webp" quality={76} draggable="false" />
            <figcaption>{lower.caption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Work -->
  <section class="qs-section qs-work" id="qs-work" aria-labelledby="qs-work-title">
    <div class="qs-wrap">
      <!-- Introduction: one continuous reading column, in source order -->
      <header class="qs-work__intro">
        <div class="qs-work__title">
          <h2 id="qs-work-title"><a href="/work/">{copy.work.heading}</a></h2>
          <p class="qs-work__through">{copy.work.subheading}</p>
        </div>
        <div class="qs-work__body">
          {copy.work.body.map((p) => <p class="qs-work__para">{p}</p>)}
        </div>
      </header>

      <!-- A · Case studies: full-width row, two entries side by side -->
      <section class="qs-group" aria-labelledby="qs-cases-title">
        <div class="qs-group__head">
          <h3 id="qs-cases-title"><a href="/work/">Case studies</a></h3>
          <p>{workIntroTitle}</p>
        </div>
        <ul class="qs-pair qs-cases">
          {
            caseStudies.map((e) => (
              <li>
                <p class="qs-meta">{[e.data.year, e.data.category].filter(Boolean).join(' · ')}</p>
                <h4>{hasCaseStudy(e) && !e.data.privateCaseStudy ? <a href={`/work/${e.slug}`}>{e.data.title}</a> : e.data.title}</h4>
                <p>{e.data.shortDescription}</p>
                <p class="qs-meta">{e.data.anonymized ? 'Confidential' : e.data.companyOrClient}</p>
              </li>
            ))
          }
        </ul>
        <p class="qs-go qs-group__more"><a href="/work/">All case studies <span aria-hidden="true">→</span></a></p>
      </section>

      <!-- B · Prototypes: two proofs of concept, with real screenshots -->
      <section class="qs-group" aria-labelledby="qs-protos-title">
        <div class="qs-group__head">
          <h3 id="qs-protos-title">Prototypes</h3>
          <p>{prototypeNote}</p>
        </div>
        <ul class="qs-pair qs-protos">
          {
            prototypes.map((x) => (
              <li class="qs-proto">
                {x.shot && (
                  <figure class="qs-proto__shot">
                    <Image src={x.shot.src} alt={x.shot.alt} widths={[240, 360, 480]} sizes="(max-width: 36rem) 38vw, 10rem" format="webp" quality={80} />
                  </figure>
                )}
                <div class="qs-proto__text">
                  <p class="qs-meta">{x.label}</p>
                  <h4>{x.title}</h4>
                  <p>{x.description}</p>
                  <p class="qs-go">
                    <a href={x.path}>
                      Open prototype<span class="visually-hidden">: {x.title}</span> <span aria-hidden="true">→</span>
                    </a>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- C · Commissioned writing / D · Services: a compact shared row -->
      <div class="qs-pair qs-pair--final">
        <section class="qs-final" aria-labelledby="qs-writing-title">
          <h3 id="qs-writing-title"><a href="/writing/">Commissioned writing</a></h3>
          <p>{writingAside}</p>
          <p class="qs-go"><a href="/writing/">All commissioned writing <span aria-hidden="true">→</span></a></p>
        </section>
        <section class="qs-final" aria-labelledby="qs-services-title">
          <h3 id="qs-services-title"><a href="/services/">Services</a></h3>
          <p>
            Audience intelligence, digital strategy and growth, and content and digital
            operations for teams that need clearer decisions and working systems.
          </p>
          <p class="qs-go"><a href="/services/">How I can help <span aria-hidden="true">→</span></a></p>
        </section>
      </div>
    </div>
  </section>

  <!-- 5 · Closing -->
  <section class="qs-section qs-closing" aria-labelledby="qs-closing-title">
    <div class="qs-wrap qs-closing__inner">
      <h2 id="qs-closing-title">{closing.title}</h2>
      <div>
        <p>{closing.body}</p>
        <p class="qs-links">
          <a href="/about/">Read about me <span aria-hidden="true">→</span></a>
          <a href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
          <a href={siteLinks.linkedin} target="_blank" rel="noopener" data-ga-event="linkedin_click">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>
        </p>
      </div>
    </div>
  </section>

</div>
</BaseLayout>

<style>
  .qs { color: var(--ink); }
  /* Site grid (same as .wrap), so content aligns with the shared header/footer. */
  .qs-wrap { width: 100%; max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); }

  .qs h2 { font-family: var(--font-sans); font-size: clamp(1.7rem, 2.6vw, 2.5rem); font-weight: 740; letter-spacing: -.04em; line-height: 1.05; }
  .qs h2 a, .qs h3 a, .qs h4 a { text-decoration: none; }
  .qs h3, .qs h4 { font-family: var(--font-sans); font-weight: 720; letter-spacing: -.025em; line-height: 1.15; }
  .qs h2 a:hover, .qs h3 a:hover, .qs h4 a:hover { color: var(--accent); }
  .qs-meta { margin: 0; font-size: .74rem; font-weight: 650; letter-spacing: .02em; color: var(--ink-faint); }
  .qs-links { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; margin: 1.75rem 0 0; }
  .qs-links a, .qs-go a { font-size: .86rem; font-weight: 700; text-decoration-color: var(--rule); text-underline-offset: .3em; }
  .qs-links a:hover, .qs-go a:hover { text-decoration-color: var(--accent); }
  .qs-go { margin: .9rem 0 0; }

  /* 1 · Introduction — the full landscape portrait beside the headline */
  .qs-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem); gap: clamp(2rem, 6vw, 5.5rem); align-items: end; padding-top: clamp(3rem, 8vw, 6.5rem); padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .qs-intro h1 { max-width: 16ch; font-family: var(--font-sans); font-size: clamp(2.4rem, 4.6vw, 4.1rem); font-weight: 740; letter-spacing: -.05em; line-height: 1; }
  .qs-intro__statement { max-width: 32rem; margin: 1.5rem 0 0; font-family: var(--font-serif); font-size: clamp(1.25rem, 1.8vw, 1.55rem); line-height: 1.42; }
  .qs-intro__portrait { margin: 0; }
  /* The whole 3:2 photograph at its native proportions: no crop, no cover. */
  .qs-intro__portrait :global(img) { display: block; width: 100%; height: auto; filter: saturate(.85) contrast(1.03); border-radius: 2px; }

  /* Sections */
  .qs-section { padding-block: clamp(3.5rem, 7vw, 5.5rem); border-top: 1px solid var(--rule); }
  .qs-section__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1rem clamp(2rem, 6vw, 6rem); align-items: baseline; margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem); }
  .qs-section__head > p { max-width: 36rem; margin: 0; font-family: var(--font-serif); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; color: var(--ink-soft); }

  /* 2 · Desk rows: identity | about | featured. Compact rows use only the
     first two columns' worth of height; the featured column simply isn't there. */
  .qs-desk { background: var(--paper-raised); border-top: 0; }
  .qs-rows { border-top: 2px solid var(--ink); }
  .qs-row { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 17rem) minmax(0, 1fr); gap: .5rem clamp(1.5rem, 3.5vw, 3rem); align-items: start; padding-block: 1.75rem; border-bottom: 1px solid var(--rule); }
  .qs-row--compact { padding-block: 1rem; align-items: baseline; }
  .qs-row--compact .qs-row__about { grid-column: 2 / -1; }
  .qs-row__name { margin: 0; font-size: 1.2rem; }
  .qs-row--compact .qs-row__name { font-size: 1.02rem; font-weight: 680; color: var(--ink-soft); }
  .qs-row--compact .qs-row__subtitle { font-size: .92rem; }
  .qs-row__subtitle { margin: .2rem 0 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); }
  .qs-row__desc { max-width: 34rem; margin: 0; font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.5; color: var(--ink-soft); }
  .qs-row--compact .qs-row__desc { font-size: 1rem; }

