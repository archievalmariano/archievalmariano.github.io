---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { hero, services } from '../data/site';

const featuredWork = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 6);

const recentWriting = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => (a.slug < b.slug ? -1 : 1))
  .slice(0, 3);
---

<BaseLayout
  title="Archieval Mariano — Digital Strategy & Audience Growth"
  description="Archieval Mariano is a digital strategy and audience growth professional based in the Philippines, working across strategy, content, analytics, e-commerce, and digital operations."
>
  <section class="wrap intro">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 class="intro__lede">{hero.headline}</h1>
    <p class="intro__body">{hero.intro}</p>
    <p class="intro__ctas">
      <a href="/work">View my work <span aria-hidden="true">&rarr;</span></a>
      <a href="/contact">Work with me <span aria-hidden="true">&rarr;</span></a>
      {/* Download CV link temporarily hidden until a real CV is added; siteLinks.cv preserved in src/data/site.ts */}
    </p>
  </section>

  <section class="wrap section section--first">
    <div class="section__head">
      <h2>Selected work</h2>
      <a href="/work" class="section__more">All work &rarr;</a>
    </div>
    <ul class="work-list">
      {featuredWork.map((entry) => <WorkCard entry={entry} />)}
    </ul>
  </section>

  <section class="wrap section">
    <div class="section__head">
      <h2>What I can help with</h2>
      <a href="/services" class="section__more">All services &rarr;</a>
    </div>
    <ul class="services-preview">
      {
        services.map((service) => (
          <li class="services-preview__item">
            <h3 class="services-preview__title">{service.title}</h3>
            <p class="services-preview__desc">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section">
    <div class="section__head">
      <h2>Recent writing</h2>
      <a href="/writing" class="section__more">All writing &rarr;</a>
    </div>
    <ul class="entry-list">
      {
        recentWriting.map((entry) => {
          const d = entry.data;
          const href = d.externalURL ?? `/writing/${entry.slug}`;
          const isExternal = Boolean(d.externalURL);
          const attribution = [d.publisher, d.clientOrCampaign].filter(Boolean).join(' · ');
          return (
            <li class="entry-list__item">
              <a
                href={href}
                class="entry-list__link"
                data-ga-event="writing_click"
                {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <div class="entry-list__title">
                  {d.title}
                  {isExternal && <span class="ext" aria-hidden="true"> ↗</span>}
                  {isExternal && <span class="visually-hidden"> (opens in new tab)</span>}
                </div>
                <p class="entry-list__summary">{d.description}</p>
                {attribution && <p class="meta">{attribution}</p>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="wrap closing">
    <p class="closing__text">
      Have a digital problem, an opportunity, or a pile of data and aren&rsquo;t
      sure what to do next?
    </p>
    <a class="closing__link" href="/contact">Get in touch <span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    max-width: 54rem;
  }

  .intro__lede {
    margin-top: var(--space-md);
    font-size: var(--step-4);
    line-height: 1.08;
  }

  .intro__body {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .intro__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .intro__ctas a {
    text-decoration: none;
    color: var(--ink);
  }

  .intro__ctas a:hover {
    color: var(--accent);
  }

  .intro__cv {
    color: var(--ink-faint) !important;
  }

  .section {
    padding-top: var(--space-lg);
  }

  /* First section sits directly below the hero now that the proof row is gone. */
  .section--first {
    padding-top: var(--space-md);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--rule);
  }

  .section__more {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .section__more:hover {
    color: var(--accent);
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Services preview — compact editorial rows, not cards. */
  .services-preview {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-preview__item {
    padding-block: var(--space-md);
  }

  .services-preview__item + .services-preview__item {
    border-top: 1px solid var(--rule);
  }

  .services-preview__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .services-preview__desc {
    margin: var(--space-xs) 0 0;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry-list__item + .entry-list__item {
    border-top: 1px solid var(--rule);
  }

  .entry-list__link {
    display: block;
    padding-block: var(--space-md);
    text-decoration: none;
  }

  .entry-list__title {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.15;
  }

  .entry-list__link:hover .entry-list__title {
    color: var(--accent);
  }

  .ext {
    font-family: var(--font-sans);
    font-size: 0.7em;
    color: var(--ink-faint);
  }

  .entry-list__link:hover .ext {
    color: var(--accent);
  }

  .entry-list__summary {
    margin: var(--space-xs) 0;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .closing {
    padding-top: var(--space-xl);
    max-width: 54rem;
  }

  .closing__text {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--ink);
    max-width: var(--measure);
    margin: 0;
  }

  .closing__link {
    display: inline-block;
    margin-top: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
  }
</style>
