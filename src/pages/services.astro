---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';
---

<BaseLayout
  title="Services — Archieval Mariano"
  description="Digital strategy, audience and performance, and content and digital operations — how Archieval Mariano can help teams turn ideas and data into working programs."
>
  <section class="wrap page-head">
    <p class="page-head__chapter"><span>04</span> Services</p>
    <h1>Problems I can help make clearer.</h1>
    <p class="page-head__intro">
      I work with teams that have a digital problem, an opportunity, or a pile of
      data and aren&rsquo;t quite sure what to do next.
    </p>
  </section>

  <div class="wrap services">
    {
      services.map((service) => (
        <section class="service">
          <h2 class="service__title">{service.title}</h2>
          <p class="service__desc">{service.description}</p>
          <p class="service__label">Typical work</p>
          <ul class="service__work">
            {service.work.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="services-close">
      <p>
        Need something that doesn&rsquo;t fit neatly into one category?
        That&rsquo;s usually fine. Much of my work sits between strategy, content,
        analytics, and execution.
      </p>
      <a class="services-close__link" href="/contact">
        Get in touch <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
    max-width: var(--wrap);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(3.3rem, 7vw, 7.8rem);
    font-weight: 760;
    letter-spacing: -.065em;
    line-height: .9;
  }

  .page-head__intro {
    grid-column: 2;
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__chapter { grid-row: 1 / span 2; margin: 0; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  .page-head__chapter span { display: block; width: fit-content; margin-bottom: .65rem; padding: .35rem .5rem; background: var(--yellow); border: 1px solid var(--ink); color: var(--ink); }

  .service {
    display: grid;
    grid-template-columns: minmax(14rem, .55fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 7vw, 8rem);
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: var(--heavy-rule);
  }

  .service__title {
    grid-row: 1 / span 3;
    max-width: 11ch;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4vw, 4.4rem);
    font-weight: 740;
    letter-spacing: -.05em;
    line-height: .96;
  }

  .service__desc {
    margin: var(--space-sm) 0 var(--space-md);
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .service__label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 var(--space-sm);
  }

  .service__work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem var(--space-lg);
    max-width: var(--measure);
  }

  .service__work li {
    position: relative;
    padding-left: 1rem;
    padding-block: .45rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .service__work li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-faint);
  }

  .services-close {
    padding: clamp(3rem, 6vw, 6rem);
    border: var(--heavy-rule);
    background: var(--coral);
    max-width: none;
  }

  .services-close p {
    max-width: 32ch;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    color: var(--ink);
  }

  .services-close__link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .page-head, .service { grid-template-columns: 1fr; }
    .page-head h1, .page-head__intro, .page-head__chapter { grid-column: 1; grid-row: auto; }
    .service__title { grid-row: auto; }
    .service__work {
      grid-template-columns: 1fr;
    }
  }
</style>
