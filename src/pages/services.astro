---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';
---

<BaseLayout
  title="Services — Archieval Mariano"
  description="Audience intelligence, digital strategy and growth, and content and digital operations for teams that need clearer decisions and working systems."
>
  <section class="wrap page-head">
    <p class="page-head__chapter"><span>04</span> Services</p>
    <h1>What I can help you figure out.</h1>
    <p class="page-head__intro">
      Some problems need a strategy. Others need a system, a second pair of eyes,
      or someone willing to trace what is actually happening. My work usually
      falls into three areas.
    </p>
  </section>

  <div class="wrap services">
    {
      services.map((service) => (
        <section class="service">
          <h2 class="service__title">{service.title}</h2>
          <div class="service__details">
            <div class="service__detail">
              <p class="service__label">When this is useful</p>
              <p>{service.need}</p>
            </div>
            <div class="service__detail">
              <p class="service__label">How I help</p>
              <p>{service.approach}</p>
            </div>
            <div class="service__detail">
              <p class="service__label">What changes</p>
              <p>{service.outcome}</p>
            </div>
          </div>
        </section>
      ))
    }

    <section class="services-close">
      <p>
        Not every problem fits neatly into one category. That is usually where
        the interesting work begins.
      </p>
      <a class="services-close__link" href="/contact">
        Tell me what you&rsquo;re working on <span aria-hidden="true">&rarr;</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(3rem, 7vw, 7rem);
    max-width: var(--wrap);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(3.3rem, 7vw, 7.8rem);
    font-weight: 760;
    letter-spacing: -.065em;
    line-height: .9;
  }

  .page-head__intro {
    grid-column: 2;
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__chapter { grid-row: 1 / span 2; margin: 0; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  .page-head__chapter span { display: block; width: fit-content; margin-bottom: .65rem; padding: .35rem .5rem; background: var(--yellow); border: 1px solid var(--ink); color: var(--ink); }

  .service {
    display: grid;
    grid-template-columns: minmax(14rem, .55fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 7vw, 8rem);
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: var(--heavy-rule);
  }

  .service__title {
    max-width: 11ch;
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4vw, 4.4rem);
    font-weight: 740;
    letter-spacing: -.05em;
    line-height: .96;
  }

  .service__details {
    display: grid;
    gap: var(--space-lg);
  }

  .service__detail {
    display: grid;
    grid-template-columns: minmax(7.5rem, .28fr) minmax(0, 1fr);
    gap: 1rem var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .service__detail > p:last-child {
    margin: 0;
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.55vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .service__label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
  }

  .services-close {
    padding: clamp(3rem, 6vw, 6rem);
    border: var(--heavy-rule);
    background: var(--coral);
    max-width: none;
  }

  .services-close p {
    max-width: 32ch;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    color: var(--ink);
  }

  .services-close__link {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    margin-top: var(--space-md);
    padding: .75rem 1.1rem;
    background: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: .3rem .3rem 0 var(--yellow);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
  }

  .services-close__link:hover {
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }

  @media (max-width: 34rem) {
    .page-head, .service { grid-template-columns: 1fr; }
    .page-head h1, .page-head__intro, .page-head__chapter { grid-column: 1; grid-row: auto; }
    .service__title { grid-row: auto; }
    .service__detail {
      grid-template-columns: 1fr;
    }
  }
</style>
