---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteLinks } from '../data/site';
---

<BaseLayout
  title="Contact — Archieval Mariano"
  description="Get in touch with Archieval Mariano about consulting, project work, or full-time opportunities in digital strategy and audience growth."
>
  <section class="wrap contact">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="contact__intro">
      For consulting, project work, or full-time opportunities, email is the best
      way to reach me.
    </p>

    <p class="contact__email">
      <a href={`mailto:${siteLinks.email}`} data-ga-event="email_click">{siteLinks.email}</a>
    </p>

    <ul class="contact__links">
      <li>
        <a href={siteLinks.linkedin} target="_blank" rel="noopener" data-ga-event="linkedin_click">
          LinkedIn <span aria-hidden="true">&rarr;</span>
        </a>
      </li>
      {/* Download CV link temporarily hidden until a real CV is added; siteLinks.cv preserved in src/data/site.ts */}
    </ul>

    <p class="meta contact__note">Based in the Philippines · PHT (UTC+8)</p>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: var(--space-xl);
    max-width: 54rem;
  }

  .contact h1 {
    margin-top: var(--space-sm);
  }

  .contact__intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .contact__email {
    margin-top: var(--space-lg);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    letter-spacing: -0.01em;
  }

  .contact__email a {
    text-decoration: none;
  }

  .contact__email a:hover {
    color: var(--accent);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact__links a {
    text-decoration: none;
    color: var(--ink);
  }

  .contact__links a:hover {
    color: var(--accent);
  }

  .contact__note {
    margin-top: var(--space-lg);
  }
</style>
