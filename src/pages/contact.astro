---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteLinks } from '../data/site';
---

<BaseLayout
  title="Contact — Archieval Mariano"
  description="Get in touch with Archieval Mariano about consulting, project work, or full-time opportunities in digital strategy and audience growth."
>
  <section class="wrap contact">
    <p class="contact__chapter"><span>05</span> Contact</p>
    <div class="contact__main">
    <h1>Tell me what you&rsquo;re working on.</h1>
    <p class="contact__intro">
      If you have a project, a role, or a problem worth thinking through, I&rsquo;d
      like to hear about it. Email is the best way to reach me.
    </p>

    <p class="contact__email">
      <a href={`mailto:${siteLinks.email}`} data-ga-event="email_click">{siteLinks.email}</a>
    </p>

    <ul class="contact__links">
      <li>
        <a href={siteLinks.linkedin} target="_blank" rel="noopener" data-ga-event="linkedin_click">
          LinkedIn <span aria-hidden="true">&rarr;</span><span class="visually-hidden"> (opens in new tab)</span>
        </a>
      </li>
      {/* Download CV link temporarily hidden until a real CV is added; siteLinks.cv preserved in src/data/site.ts */}
    </ul>

    <p class="meta contact__note">Based in the Philippines · PHT (UTC+8)</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(9rem, .3fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 8vw, 9rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(4rem, 9vw, 9rem);
    max-width: var(--wrap);
  }

  .contact h1 {
    max-width: 12ch;
    font-family: var(--font-sans);
    font-size: clamp(3.5rem, 8vw, 8.5rem);
    font-weight: 760;
    letter-spacing: -.07em;
    line-height: .87;
  }

  .contact__chapter { margin: 0; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  .contact__chapter span { display: block; width: fit-content; margin-bottom: .65rem; padding: .35rem .5rem; background: var(--coral); border: 1px solid var(--ink); color: var(--ink); }

  .contact__intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .contact__email {
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 3vw, 2.8rem);
    font-weight: 760;
    letter-spacing: -.04em;
  }

  .contact__email a {
    display: inline-block;
    padding: .75rem 1rem;
    background: var(--yellow);
    border: var(--heavy-rule);
    box-shadow: .4rem .4rem 0 var(--ink);
    text-decoration: none;
  }

  .contact__email a:hover {
    color: var(--accent);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact__links a {
    text-decoration: none;
    color: var(--ink);
  }

  .contact__links a:hover {
    color: var(--accent);
  }

  .contact__note {
    margin-top: var(--space-lg);
  }

  @media (max-width: 44rem) {
    .contact { grid-template-columns: 1fr; }
  }
</style>
