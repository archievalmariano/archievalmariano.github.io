---
import { getCollection, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const writing = await getCollection('writing', ({ data }) => !data.draft);
  return writing.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const classificationLabel =
  d.classification === 'commissioned' ? 'Commissioned' : 'Personal';
const bylineLabel: Record<string, string> = {
  bylined: 'Bylined',
  ghostwritten: 'Ghostwritten',
  uncredited: 'Uncredited',
};

const facts: { label: string; value?: string }[] = [
  { label: 'Type', value: classificationLabel },
  { label: 'Published', value: dateFmt.format(d.pubDate) },
  { label: 'Publisher', value: d.publisher },
  { label: 'Client / campaign', value: d.clientOrCampaign },
  { label: 'Format', value: d.format },
  { label: 'Contribution', value: d.contribution },
  { label: 'Byline', value: bylineLabel[d.byline] },
];
---

<EntryLayout
  title={d.title}
  description={d.description}
  eyebrow={`Writing · ${classificationLabel}`}
  meta={dateFmt.format(d.pubDate)}
  backHref="/writing"
  backLabel="All writing"
>
  <p class="lede">{d.description}</p>

  <dl class="facts">
    {
      facts.map((f) => (
        <div class="facts__row">
          <dt>{f.label}</dt>
          <dd>{f.value ?? <span class="tbd">To be provided</span>}</dd>
        </div>
      ))
    }
  </dl>

  {
    d.externalURL && (
      <p class="link-row">
        <a href={d.externalURL} rel="noopener">
          Read the published piece &rarr;
        </a>
      </p>
    )
  }

  <Content />
</EntryLayout>

<style>
  .lede {
    font-size: var(--step-1);
    color: var(--ink);
  }

  .facts {
    margin: var(--space-lg) 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }

  .facts dt {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 0;
  }

  .link-row {
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tbd {
    color: var(--ink-faint);
    font-style: italic;
  }

  @media (max-width: 34rem) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
