---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Writing — Archieval Mariano"
  description="Selected commissioned work and occasional personal writing on digital strategy, audience, content, and analytics."
>
  <section class="wrap page-head">
    <p class="eyebrow">Writing</p>
    <h1>Essays &amp; notes</h1>
    <p class="page-head__intro">
      Selected commissioned work and occasional personal writing.
    </p>
  </section>

  <section class="wrap">
    <ul class="entry-list">
      {
        writing.map((entry) => (
          <li class="entry-list__item">
            <a href={`/writing/${entry.slug}`} class="entry-list__link">
              <p class="meta entry-list__date">
                <time datetime={entry.data.pubDate.toISOString()}>
                  {dateFmt.format(entry.data.pubDate)}
                </time>
                <span> · {entry.data.classification === 'commissioned' ? 'Commissioned' : 'Personal'}</span>
                {entry.data.format && <span> · {entry.data.format}</span>}
              </p>
              <div class="entry-list__title">{entry.data.title}</div>
              <p class="entry-list__summary">{entry.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    max-width: 54rem;
  }

  .page-head h1 {
    margin-top: var(--space-sm);
  }

  .page-head__intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .entry-list__item {
    border-bottom: 1px solid var(--rule);
  }

  .entry-list__link {
    display: block;
    padding-block: var(--space-lg);
    text-decoration: none;
  }

  .entry-list__date {
    margin-bottom: var(--space-xs);
  }

  .entry-list__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .entry-list__link:hover .entry-list__title {
    color: var(--accent);
  }

  .entry-list__summary {
    margin: var(--space-sm) 0 0;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
</style>
