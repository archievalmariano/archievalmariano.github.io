---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import imgTerminal from '../../../assets/photos/onpoint-05-terminal.jpg';
import imgBoard from '../../../assets/photos/onpoint-01-board.jpg';
import imgCountdown from '../../../assets/photos/onpoint-06-countdown.jpg';
import imgCubao from '../../../assets/photos/onpoint-03-cubao-clark.jpg';
import imgNuvali from '../../../assets/photos/onpoint-09-nuvali.jpg';
import imgCollectionsFirst from '../../../assets/photos/onpoint-10-collections-page-1.jpg';
import imgCollectionsSecond from '../../../assets/photos/onpoint-11-collections-page-2.jpg';
import imgApps from '../../../assets/photos/tools-06-apps-x4pro.jpg';

const release = 'https://github.com/archievalmariano/crosspoint-reader/releases';

const version = 'v1.6.0';
const releaseNotes = `${release}/tag/${version}`;
const downloads = `${release}/download/${version}`;
const routeNotes = 'https://github.com/archievalmariano/crosspoint-reader/blob/v1.6.0/docs/releases/v1.6.0.md';

// Route pairs in the order of the v1.6.0 collection picker. Timetables are
// provisional when sourced secondhand or not currently confirmed by the operator.
const collections = [
  {
    name: 'BULACAN',
    routes: [
      { route: 'Balagtas ↔ TriNoma', operator: 'Bulacan P2P', timetable: 'Provisional' },
      { route: 'Caypombo ↔ SM North EDSA', operator: 'Precious Grace', timetable: 'Mixed' },
      { route: 'Pandi ↔ TriNoma', operator: 'Bulacan P2P', timetable: 'Provisional' },
      { route: 'Plaridel ↔ TriNoma', operator: 'Bulacan P2P', timetable: 'Provisional' },
      { route: 'Malolos ↔ TriNoma', operator: 'Precious Grace', timetable: 'Mixed' },
      { route: 'Guiguinto ↔ TriNoma', operator: 'Bulacan P2P', timetable: 'Provisional' },
    ],
  },
  {
    name: 'NORTH LUZON',
    routes: [
      { route: 'Cubao ↔ Clark Airport', operator: 'Genesis', timetable: 'Published' },
      { route: 'TriNoma ↔ Clark Airport', operator: 'Genesis', timetable: 'Published' },
      { route: 'Clark Airport ↔ Baguio', operator: 'Genesis', timetable: 'Published' },
      { route: 'Cubao ↔ Baguio', operator: 'Genesis', timetable: 'Published' },
      { route: 'Pasay ↔ Baguio', operator: 'Genesis', timetable: 'Published' },
      { route: 'Clark Airport ↔ Balanga', operator: 'Genesis', timetable: 'Published' },
    ],
  },
  {
    name: 'AIRPORT TRANSFERS',
    routes: [
      { route: 'Clark Airport ↔ NAIA T3', operator: 'Genesis', timetable: 'Published' },
      { route: 'NAIA T3 ↔ PITX', operator: 'UBE Express', timetable: 'Provisional' },
      { route: 'PITX ↔ Clark Airport', operator: 'Genesis', timetable: 'Published' },
    ],
  },
  {
    name: 'METRO MANILA',
    routes: [
      { route: 'ATC Alabang ↔ Greenbelt', operator: 'RRCG', timetable: 'Provisional' },
      { route: 'VTX Alabang ↔ Starmall Shaw', operator: 'RRCG', timetable: 'Provisional' },
      { route: 'ATC Alabang ↔ SM Megamall', operator: 'RRCG', timetable: 'Provisional' },
    ],
  },
  {
    name: 'LAGUNA',
    routes: [
      { route: 'Nuvali ↔ One Ayala', operator: 'TAS Trans', timetable: 'Provisional' },
      { route: 'WM Cabuyao ↔ Makati', operator: 'Calamba P2P', timetable: 'Provisional' },
      { route: 'WM Cabuyao ↔ Market Market', operator: 'Calamba P2P', timetable: 'Provisional' },
    ],
  },
  {
    name: 'SOUTH LUZON',
    routes: [
      { route: 'Batangas ↔ Newport', operator: 'RRCG', timetable: 'Provisional' },
      { route: 'SM Lipa ↔ Newport', operator: 'RRCG', timetable: 'Provisional' },
      { route: 'SM Masinag ↔ One Ayala', operator: 'RRCG', timetable: 'Provisional' },
      { route: 'Sierra Valley ↔ One Ayala', operator: 'RRCG', timetable: 'Provisional' },
    ],
  },
];

const timetableLabel = {
  Published: 'PUBLISHED',
  Provisional: 'PROVISIONAL',
};

const gallery = [
  {
    src: imgNuvali,
    alt: 'The Nuvali to One Ayala board showing 51 minutes until the noon departure and the PROVISIONAL label at the bottom.',
    caption: 'Nuvali → One Ayala in the Laguna collection, with its timetable marked PROVISIONAL.',
  },
  {
    src: imgBoard,
    alt: 'ON POINT showing 15 minutes until the 09:30 bus from Balagtas to TriNoma, with the next trip at 10:00 and the last at 20:00.',
    caption: 'An earlier Balagtas → TriNoma board showing the scheduled, next and last trips. See the route table for its current timetable status.',
  },
  {
    src: imgCubao,
    alt: 'ON POINT showing 115 minutes until the 11:10 bus from Cubao to Clark Airport, with trips every 120 minutes.',
    caption: 'Less frequent routes show the gap between trips.',
  },
  {
    src: imgCountdown,
    alt: 'A close view of the ON POINT board on an XTEINK X4 Pro: TriNoma to Balagtas, 15 minutes until the 13:30 departure, next at 14:00 and last at 22:30, marked PROVISIONAL and dated 4 November 2026.',
    caption: 'The reverse direction, TriNoma → Balagtas. Left and Right switch direction.',
  },
];

const galleryWidths = [240, 360, 520, 720];
const gallerySizes = '(max-width: 40rem) 45vw, 20rem';

const packages = [
  {
    name: 'ON POINT',
    file: 'firmware-x4pro-p.factory.bin',
    identity: '2.0.0-A1.6.0-P',
    sha256: 'f4d1f451ae8c8067a4f7076394da4e5a7816f7e5ef45c129cff5e1f340b3142a',
  },
  {
    name: 'GOTO + ON POINT',
    file: 'firmware-x4pro-gp.factory.bin',
    identity: '2.0.0-A1.6.0-GP',
    sha256: 'fa5ac92527feb5258327719fe848c771ea5c85654f0487f6cea2be37180be047',
  },
];
---

<BaseLayout
  title="ON POINT — Archieval Mariano"
  description="ON POINT is an offline departure board for the XTEINK X4 Pro. Version 1.6.0 covers 25 bus route pairs and 50 directions in six collections, with published and provisional timetables."
>
  <section class="wrap op">
    <p class="op__back"><a href="/desk/">&larr; Desk</a></p>
    <header class="op__head">
      <p class="eyebrow">Project</p>
      <h1>ON POINT</h1>
      <p class="op__tagline">An offline departure board for scheduled bus routes.</p>
    </header>

    <p class="op__lede">
      ON POINT keeps bus timetables on the XTEINK X4 Pro and tells you what leaves
      next and how long you have, without a network connection. Version 1.6.0 covers
      25 route pairs (50 directions) in six collections, from local P2P routes to airport
      transfers. Each direction shows a PUBLISHED or PROVISIONAL label so you can see
      how much confidence to place in the timetable.
    </p>

    <figure class="op__hero">
      <Image
        src={imgTerminal}
        alt="An XTEINK X4 Pro running ON POINT at a P2P terminal, held in front of a yellow Bulacan P2P bus: the Balagtas to TriNoma board, 14 minutes until the 13:30 departure, marked PROVISIONAL and dated 4 November 2026."
        widths={[480, 720, 960]}
        sizes="(max-width: 40rem) 92vw, 30rem"
        format="webp"
        quality={76}
      />
      <figcaption>ON POINT at the terminal, counting down to the next Balagtas → TriNoma bus. Photographed 4 November 2026.</figcaption>
    </figure>

    <div class="op__gallery">
      {
        gallery.map((photo) => (
          <figure>
            <Image src={photo.src} alt={photo.alt} widths={galleryWidths} sizes={gallerySizes} format="webp" quality={74} loading="lazy" />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <section class="op__section">
      <h2>Why it exists</h2>
      <p>
        It started with one commute. P2P buses here run to fixed timetables, but those
        timetables mostly live in operator posts and on terminal signs, and the question
        at the stop is always the same: when does the next one leave, and is it the last?
        ON POINT answers that for the routes it carries, from the device’s own clock,
        with no signal needed.
      </p>
      <p>
        I also touched on the commute, and the uncomfortable business of building apps with AI, in
        <a href="/desk/field-notes/make-no-mistakes-adds-the-monkey/" style="--accent: var(--accent-ink); --rule: currentColor">“Make no mistakes,” adds the monkey</a>.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section">
      <h2>What it shows</h2>
      <ul class="op__list">
        <li>The next departure, with a countdown in minutes.</li>
        <li>The departures after it, plus the first and last trip of the day.</li>
        <li>A clear warning when the next bus is the final trip.</li>
        <li>
          <strong>Service ended</strong> or <strong>No service today</strong>, with the
          next scheduled trip.
        </li>
        <li>Both directions of each route. Left and Right switch direction.</li>
        <li>
          Six route collections. Open SELECT COLLECTION to switch between them using
          the two-page picker.
        </li>
        <li>
          A main route in each collection, at the top of its route list. Hold a route to
          make it the main route; ON POINT opens on the active collection’s main route.
        </li>
      </ul>
      <p class="op__aside">
        ON POINT never guesses the time. It reads the X4 Pro’s built-in clock, and if the
        clock has not been set it says so instead of showing a countdown. Each board is
        labelled <strong>PUBLISHED</strong> when it follows the operator’s own schedule,
        or <strong>PROVISIONAL</strong> where the source is secondary or the timetable has
        not been confirmed with the operator.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section" id="routes">
      <h2>Routes</h2>
      <p>
        Version 1.6.0 carries 25 route pairs across six collections. A direction is
        <strong>PUBLISHED</strong> when it follows the operator’s own schedule and
        <strong>PROVISIONAL</strong> when it relies on a secondary source or lacks current
        operator confirmation. Of the 50 directions, 18 are published and 32 are
        provisional. All 20 new directions are provisional: they draw on operator listings
        whose current times have not been confirmed. Check with the operator before travelling.
      </p>
      <div class="op__collection-photos">
        <figure>
          <Image src={imgCollectionsFirst} alt="ON POINT collections page 1 of 2: Bulacan, North Luzon, Airport Transfers and Metro Manila." widths={galleryWidths} sizes={gallerySizes} format="webp" quality={80} loading="lazy" />
          <figcaption>Page 1 of 2: Bulacan, North Luzon, Airport Transfers and Metro Manila.</figcaption>
        </figure>
        <figure>
          <Image src={imgCollectionsSecond} alt="ON POINT collections page 2 of 2: Laguna and South Luzon." widths={galleryWidths} sizes={gallerySizes} format="webp" quality={80} loading="lazy" />
          <figcaption>Page 2 of 2: Laguna and South Luzon.</figcaption>
        </figure>
      </div>
      {
        collections.map((c) => (
          <div class="op__collection">
            <h3 class="op__collection-name">{c.name}</h3>
            <table class="op__routes" aria-label={`${c.name} route pairs`}>
              <thead>
                <tr><th scope="col">Route</th><th scope="col">Operator</th><th scope="col">Timetable</th></tr>
              </thead>
              <tbody>
                {c.routes.map((r) => (
                  <tr>
                    <th scope="row">{r.route}</th>
                    <td>{r.operator}</td>
                    <td>{r.timetable === 'Mixed' ? (
                      <><span class="op__direction">PUBLISHED →</span><span class="op__direction">← PROVISIONAL</span></>
                    ) : timetableLabel[r.timetable]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      }
      <p class="op__aside">
        Each timetable label applies to both directions unless arrows show otherwise.
        Caypombo and Malolos read PUBLISHED leaving Bulacan and PROVISIONAL on the return,
        and Guiguinto ↔ TriNoma is an editorial reconstruction. Bulacan P2P routes follow a
        separate Saturday, Sunday and holiday timetable, and the Cubao → Baguio and
        Pasay → Baguio services run fewer trips on Tuesdays and Wednesdays than from Thursday
        to Monday. The other routes in those three collections run daily. The release notes
        (<a href={`${release}/tag/v1.3.0`} target="_blank" rel="noopener">v1.3.0</a> for the
        Bulacan and earlier routes,
        <a href={`${release}/tag/v1.5.0`} target="_blank" rel="noopener">v1.5.0</a> for the
        later Genesis additions) set out each route’s sources and limits.
      </p>
      <h3 class="op__schedule-heading">Service days and holidays</h3>
      <ul class="op__list op__schedule-notes">
        <li>ATC Alabang ↔ SM Megamall has no Sunday service. Both WM Cabuyao routes, SM Masinag ↔ One Ayala and Sierra Valley ↔ One Ayala run Monday to Friday only.</li>
        <li>For Sierra Valley ↔ One Ayala, evening departures from One Ayala follow one schedule on Monday and Friday and a different one from Tuesday to Thursday.</li>
        <li>Batangas ↔ Newport and SM Lipa ↔ Newport use RRCG’s posted daily boards. Its website lists fewer trips at different times, so both routes remain provisional.</li>
        <li>Nuvali ↔ One Ayala shows no service on nationwide regular holidays and special non-working days in 2026 and 2027. Including special non-working days is an interpretation of the operator’s holiday notice. This release does not include Eid’l Fitr or Eid’l Adha in those rules, and shows the ordinary schedule for that day on Metro Manila-only special days.</li>
        <li>RRCG and both WM Cabuyao routes use their normal day-of-week timetables on holidays, as do the Genesis routes. Actual holiday service may differ. Bulacan P2P uses its separate holiday timetable where applicable.</li>
      </ul>
      <p class="op__aside">
        Device labels use VTX Alabang for Starmall Alabang, WM Cabuyao for WalterMart
        Cabuyao, Makati for One Ayala / Landmark, Market Market for BGC Taguig,
        Batangas for Batangas Grand Terminal, and Newport for Newport World Resorts
        (NAIA Terminal 3). See the <a href={routeNotes}>v1.6.0 route notes</a> for
        timetable sources and limitations.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section" id="your-routes">
      <h2>Your own routes</h2>
      <p>
        For now, routes come bundled with the firmware. Custom route support is planned.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section">
      <h2>Supported hardware</h2>
      <p>
        Version 1.6.0 is for the <strong>XTEINK X4 Pro only</strong>. ON POINT
        needs a real-time clock to count down to departures, and the original XTEINK X4
        does not have one, so it is not offered for the X4.
      </p>
      <p class="op__install-more">
        <a href="https://go.sjv.io/0G7zZN" target="_blank" rel="sponsored noopener noreferrer">XTEINK official store <span aria-hidden="true">↗</span></a><br />
        Affiliate link. I may earn a commission on qualifying purchases.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section" id="download">
      <h2>Download</h2>
      <p>
        For a new installation, choose ON POINT on its own or together with
        <a href="/desk/goto/">GOTO</a>. Both factory images install over USB on the
        X4 Pro. ON POINT appears in <strong>Apps</strong> on the CrossPoint home screen.
      </p>

      <div class="op__packages">
        {
          packages.map((pkg) => (
            <article class="op__package">
              <h3 class="op__package-name">
                {pkg.name} <span class="op__package-method">· XTEINK X4 Pro · USB flashing</span>
              </h3>
              <dl class="op__meta">
                <div><dt>Release</dt><dd>{version} · CrossPoint 2.0.0 + Apps 1.6.0</dd></div>
                <div><dt>On-device identity</dt><dd>{pkg.identity}</dd></div>
              </dl>
              <p class="op__actions">
                <a class="op__download" href={`${downloads}/${pkg.file}`}>
                  Download {pkg.name}
                </a>
              </p>
              <p class="op__links">
                <code>{pkg.file}</code>
                <span aria-hidden="true">·</span>
                <a href={releaseNotes} target="_blank" rel="noopener">Release notes</a>
              </p>
              <p class="op__sha">
                <span class="op__sha-label">SHA-256</span>
                <code>{pkg.sha256}</code>
              </p>
            </article>
          ))
        }
      </div>
      <p class="op__install-more">
        Verify these downloads against the
        <a href={`${downloads}/SHA256SUMS-X4PRO-SHIPPED.txt`}>shipped X4 Pro checksum manifest</a>.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section" id="update">
      <h2>Updating an existing X4 Pro</h2>
      <p>
        If you already run v1.5.0 on an X4 Pro, connect to Wi-Fi and open
        <strong>Settings → System → Check for Updates</strong> to install v1.6.0.
        The update keeps your installed package. If it already includes ON POINT,
        your collection and main route selections carry over. To add ON POINT to
        a package that lacks it, install one of the factory images over USB.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section">
      <h2>Installing over USB on the X4 Pro</h2>
      <ol class="op__steps">
        <li>Download the factory image for the package you want.</li>
        <li>
          Connect the X4 Pro over USB and find its port. On macOS it looks like
          <code>/dev/cu.usbmodem101</code>; the guide below covers Linux and Windows.
        </li>
        <li>
          In the folder that holds the download, flash the file for your package at
          <code>0x0</code> with esptool, replacing the port with yours.
          <p class="op__cmd-label">ON POINT</p>
          <pre class="op__code"><code>esptool --chip esp32s3 --port /dev/cu.usbmodem101 --baud 921600 write_flash 0x0 firmware-x4pro-p.factory.bin</code></pre>
          <p class="op__cmd-label">GOTO + ON POINT</p>
          <pre class="op__code"><code>esptool --chip esp32s3 --port /dev/cu.usbmodem101 --baud 921600 write_flash 0x0 firmware-x4pro-gp.factory.bin</code></pre>
        </li>
        <li>After it restarts, connect to Wi-Fi once. The X4 Pro sets its clock and keeps it.</li>
        <li>Open Apps → ON POINT.</li>
      </ol>
      <figure class="op__figure">
        <Image src={imgApps} alt="The CrossPoint Apps screen on an XTEINK X4 Pro listing TOGO and ON POINT, then a Tools heading above Calculator, Calendar and Clock." widths={galleryWidths} sizes="(max-width: 40rem) 60vw, 260px" format="webp" quality={74} loading="lazy" />
        <figcaption>ON POINT in the Apps menu, installed here alongside GOTO, with <a href="/desk/tools/">Tools</a> below.</figcaption>
      </figure>
      <p class="op__install-more">
        The <a href="/desk/goto/install/x4-pro/">X4 Pro USB guide</a> covers installing
        esptool, finding the port and troubleshooting. It is written for GOTO, and the
        steps are the same with the ON POINT file.
      </p>
      <p class="op__limitation">
        Flashing a factory image replaces the internal firmware and may reset settings
        and saved Wi-Fi. Your microSD card is not affected.
      </p>
    </section>

    <hr class="rule" />
    <section class="op__section">
      <h2>Notes</h2>
      <p>
        ON POINT is an independent project and is not affiliated with the bus operators.
        Timetables are subject to change by the operators without notice.
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .op {
    max-width: var(--measure);
    padding-block: var(--space-lg) var(--space-xl);
  }
  .op__back {
    font-size: var(--step--1);
    margin: 0 0 var(--space-md);
  }
  .op__head {
    border-bottom: var(--heavy-rule);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .op__head h1 {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    margin-top: var(--space-xs);
  }
  .op__tagline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin: var(--space-sm) 0 0;
  }
  .op__lede {
    font-size: var(--step-0);
    line-height: 1.72;
    color: var(--ink);
    max-width: 42rem;
    margin-bottom: var(--space-lg);
  }
  .op__hero {
    margin: 0 0 var(--space-lg);
    max-width: 30rem;
  }
  .op__collection {
    margin-top: var(--space-md);
  }
  .op__collection-name {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: var(--space-md) 0 0;
  }
  .op__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0 0 var(--space-lg);
  }
  .op__gallery figure {
    margin: 0;
  }
  .op__hero img,
  .op__gallery img,
  .op__collection-photos img,
  .op__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .op__collection-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    max-width: 42rem;
    margin: var(--space-lg) 0 0;
  }
  .op__collection-photos figure {
    margin: 0;
  }
  .op__hero figcaption,
  .op__gallery figcaption,
  .op__collection-photos figcaption,
  .op__figure figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-faint);
  }
  .op__cmd-label {
    margin: var(--space-sm) 0 0 !important;
    font-size: .72rem;
    font-weight: 750;
    letter-spacing: .075em;
    text-transform: uppercase;
    color: var(--ink-faint) !important;
  }
  .op__figure {
    margin: var(--space-md) 0 0;
    max-width: 260px;
  }
  .op__section {
    margin-block: var(--space-lg);
  }
  .op__section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .op__section p {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
  }
  .op__section p + p,
  .op__section .op__aside {
    margin-top: var(--space-sm);
  }
  .op__list,
  .op__steps {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }
  .op__schedule-heading {
    font-size: var(--step-0);
    margin: var(--space-md) 0 var(--space-xs);
  }
  .op__schedule-notes li + li { margin-top: var(--space-xs); }
  .op__aside {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-faint) !important;
  }

  /* Routes */
  .op__routes {
    width: 100%;
    margin: var(--space-md) 0 0;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .op__routes th,
  .op__routes td {
    padding: .6rem .75rem .6rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }
  .op__routes thead th {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-size: .68rem;
    color: var(--ink-faint);
    border-bottom: var(--heavy-rule);
  }
  .op__routes tbody th {
    font-weight: 650;
    color: var(--ink);
  }
  .op__routes td {
    color: var(--ink-soft);
  }

  .op__direction { display: block; }

  /* Download */
  .op__packages {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  .op__package {
