---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeskNav from '../../components/DeskNav.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { isPublished, deskCollections } from '../../data/desk';

// DESK is the front page / table of contents: a restrained, sectioned list that
// points into each collection, not a grid of large cards. The full set of a
// collection lives at its index; the homepage shows a short selection.
type Entry = {
  href: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt: string;
};

// Shared homepage-selection rule for every collection:
//   • at most HOMEPAGE_MAX entries;
//   • one designated `featured` entry first, if any;
//   • then the latest remaining entries by the collection's recency order,
//     excluding the featured one (so no duplicates);
//   • if none is featured, just the latest eligible entries;
//   • fewer than the max → show only what's available.
// `featured` affects selection and position ONLY — every row uses identical
// styling (no oversized treatment, no badge).
const HOMEPAGE_MAX = 3;

function selectHomepage<T extends { featured: boolean }>(
  eligible: T[],
  byRecency: (a: T, b: T) => number
): T[] {
  const sorted = [...eligible].sort(byRecency);
  const featured = sorted.find((e) => e.featured);
  const picks: T[] = [];
  if (featured) picks.push(featured);
  for (const e of sorted) {
    if (picks.length >= HOMEPAGE_MAX) break;
    if (e === featured) continue; // the pinned featured entry is already included
    picks.push(e);
  }
  return picks;
}

// PROJECTS — homepage-eligible = registry entries where `homepage` is not false,
// ordered by the registry's editorial `order` (no invented publication dates).
// `featured` is independent: it pins at most one entry first; non-featured
// eligible projects still fill the remaining slots. Tools sets `homepage: false`,
// so it stays in the full directory at /desk/projects/ only. To change the
// homepage selection, toggle `homepage` / `featured` / `order` — no copy here.
const projectCandidates = (
  await getCollection('projects', ({ data }) => !data.draft && data.homepage)
).map((p) => ({
  featured: p.data.featured,
  order: p.data.order,
  item: {
    href: `/desk/${p.data.slug}/`,
    title: p.data.name,
    description: p.data.purpose,
    image: p.data.heroImage,
    imageAlt: p.data.heroAlt ?? '',
  } as Entry,
}));
const projectItems: Entry[] = selectHomepage(
  projectCandidates,
  (a, b) => a.order - b.order
).map((c) => c.item);

// Ordered homepage sections. PROJECTS always shows. Editorial collections appear
// ONLY once launched (publish flag on) AND they contain published, non-draft
// entries — so ARTIFACTS / FIELD NOTES are entirely absent until then.
type Section = { label: string; subtitle: string; allHref: string; items: Entry[] };

const sections: Section[] = [
  { label: 'Projects', subtitle: 'Works in Progress', allHref: '/desk/projects/', items: projectItems },
];

for (const c of deskCollections) {
  if (!isPublished(c.key)) continue;
  // Editorial collections: eligible = all published, non-draft entries. "Latest"
  // means most recently PUBLISHED (pubDate), never updatedDate — a dated
  // ownership update must not promote an older essay into the latest slots.
  const candidates = (await getCollection(c.key as any, ({ data }: any) => !data.draft)).map(
    (e: any) => ({
      featured: Boolean(e.data.featured),
      pub: e.data.pubDate.valueOf(),
      item: {
        href: `/desk/${c.slug}/${e.slug}/`,
        title: e.data.title,
        description: e.data.description,
        image: e.data.heroImage,
        imageAlt: e.data.heroAlt ?? '',
      } as Entry,
    })
  );
  const items: Entry[] = selectHomepage(candidates, (a, b) => b.pub - a.pub).map((x) => x.item);
  if (items.length === 0) continue; // launched but nothing published yet → omit
  sections.push({ label: c.label, subtitle: c.subtitle, allHref: `/desk/${c.slug}/`, items });
}
---

<BaseLayout
  title="Desk — Archieval Mariano"
  description="Things from my digital desk that I’ve decided to share: GOTO, a limited news reader, ON POINT, an offline departure board, and Tools, a calendar, calculator and clock, for XTEINK e-ink devices."
>
  <section class="wrap page-head">
    <p class="page-head__chapter"><span>04</span> Desk</p>
    <h1>Desk</h1>
    <p class="page-head__intro">
      Things from my digital desk that I’ve decided to share. Some can be useful,
      definitely specific, and occasionally unnecessary.
    </p>
  </section>

  <div class="wrap">
    <DeskNav />
  </div>

  <div class="wrap desk">
    {
      sections.map((section) => (
        <section class="desk-section">
          <header class="desk-section__head">
            <h2 class="desk-section__title">{section.label}</h2>
            <p class="desk-section__subtitle">{section.subtitle}</p>
          </header>

          <ul class="desk-entries">
            {section.items.map((item) => (
              <li class="desk-entry">
                <a class="desk-entry__link" href={item.href}>
                  <div class="desk-entry__thumb">
                    {item.image ? (
                      <Image
                        src={item.image}
                        alt={item.imageAlt}
                        widths={[120, 200, 280]}
                        sizes="(max-width: 40rem) 24vw, 120px"
                        format="webp"
                        quality={72}
                        loading="lazy"
                      />
                    ) : (
                      <MediaPlaceholder label={item.title} orientation="landscape" />
                    )}
                  </div>
                  <div class="desk-entry__body">
                    <h3 class="desk-entry__title">{item.title}</h3>
                    <p class="desk-entry__desc">{item.description}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <p class="desk-section__all">
            <a href={section.allHref}>
              See all {section.label} <span aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      ))
    }

    <p class="desk__context">
      The current projects run on CrossPoint Reader, an open firmware for XTEINK e-ink
      readers. Each project page covers its own downloads and installation.
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 7vw, 8rem);
    padding-top: clamp(4rem, 9vw, 9rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: var(--wrap);
  }

  .page-head h1 {
    grid-column: 2;
    max-width: 14ch;
    font-family: var(--font-sans);
    font-size: clamp(3.3rem, 7vw, 7.8rem);
    font-weight: 760;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .page-head__intro {
    grid-column: 2;
    max-width: 44rem;
    margin: var(--space-md) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .page-head__chapter {
    grid-row: 1 / span 2;
    margin: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .page-head__chapter span {
    display: block;
    width: fit-content;
    margin-bottom: 0.65rem;
    padding: 0.35rem 0.5rem;
    background: var(--yellow);
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .desk {
    padding-bottom: var(--space-xxl);
  }

  /* Each collection is a clearly separated vertical section with generous
     spacing — a table of contents, not a card grid. */
  .desk-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--heavy-rule);
  }

  .desk-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem clamp(0.85rem, 2vw, 1.5rem);
    margin-bottom: var(--space-md);
  }

  .desk-section__title {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .desk-section__subtitle {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-faint);
  }

  /* Compact horizontal entry rows: a modest thumbnail, a serif title and a
     restrained description. */
  .desk-entries {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .desk-entry {
    border-bottom: 1px solid var(--rule);
  }

  .desk-entry__link {
    display: grid;
    grid-template-columns: clamp(84px, 20vw, 116px) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    padding-block: clamp(1.1rem, 2.5vw, 1.6rem);
    text-decoration: none;
    color: inherit;
  }

  .desk-entry__thumb :global(img),
  .desk-entry__thumb :global(.media-placeholder) {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  .desk-entry__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.6vw, 1.95rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .desk-entry__desc {
    margin: 0.35rem 0 0;
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .desk-entry__link:hover .desk-entry__title {
    color: var(--accent);
  }

  /* Understated "see all" link into the collection index. */
  .desk-section__all {
    margin: var(--space-md) 0 0;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .desk-section__all a {
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 0.15rem;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .desk-section__all a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .desk__context {
    max-width: 44rem;
    margin: var(--space-xl) 0 0;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .page-head {
      grid-template-columns: 1fr;
    }

    .page-head h1,
    .page-head__intro {
      grid-column: 1;
    }

    .page-head__chapter {
      grid-row: auto;
    }
  }
</style>
