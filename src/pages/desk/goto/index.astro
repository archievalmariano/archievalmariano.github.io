---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import imgStory from '../../../assets/photos/goto-edition-01-story.jpg';
import imgQr from '../../../assets/photos/goto-edition-02-qr.jpg';
import imgScan from '../../../assets/photos/goto-edition-03-scan.jpg';
import imgPhone from '../../../assets/photos/goto-edition-04-phone.jpg';

// One morning edition, from the first story to reading it on a phone.
const edition = [
  {
    src: imgStory,
    alt: 'The top story of a GOTO morning edition on an XTEINK X4 Pro, story 1 of 10, with a Full Story link.',
    caption: 'Each edition is a fixed set of story leads.',
  },
  {
    src: imgQr,
    alt: 'The GOTO screen after the last story, reading Your GOTO is ready above a QR code and Scan for this edition.',
    caption: 'After the last story, one QR code carries the whole edition.',
  },
  {
    src: imgScan,
    alt: 'A Samsung Galaxy Z Fold 7 camera scanning the GOTO edition QR code on the X4 Pro and detecting goto.archievalmariano.com.',
    caption: 'Scan it with your phone’s camera.',
  },
  {
    src: imgPhone,
    alt: 'The GOTO morning edition page for 27 September 2026 open in a browser on a Samsung Galaxy Z Fold 7, listing the same stories with links to GMA News.',
    caption: 'The 27 September 2026 morning edition on a phone, with a link to each full story.',
  },
];
---

<BaseLayout
  title="Project GOTO — Archieval Mariano"
  description="GOTO is a limited morning (GOTO) and evening (TOGO) news reader for e-ink devices running CrossPoint Reader."
>
  <section class="wrap goto">
    <p class="goto__back"><a href="/desk/">&larr; Desk</a></p>
    <header class="goto__head">
      <p class="eyebrow">Project</p>
      <h1>GOTO</h1>
      <p class="goto__tagline">A limited news reader for e-ink devices.</p>
    </header>

    <p class="goto__lede">
      GOTO/TOGO delivers a limited morning (GOTO) and evening (TOGO) news briefing
      to e-ink readers running CrossPoint Reader. Open an edition, read a
      fixed set of story leads, and scan a QR code if you want to continue a story
      on your phone. That’s it. No endless feed, and no need to read every story in
      full.
    </p>

    <section class="goto__section">
      <h2>Concept</h2>
      <p>
        Each edition is a fixed set of stories chosen for that morning or evening.
        GOTO is the morning paper. TOGO is the evening takeaway. The names play on
        something being prepared and ready to pick up, with the edition waiting for
        you when you open it. Once you reach the end, you are done.
      </p>
    </section>

    <hr class="rule" />
    <section class="goto__section">
      <h2>From the e-ink screen to your phone</h2>
      <p>
        Each story has its own Full Story QR code, and the edition ends with one that
        opens the edition page, with links to every story. Scan it and the whole
        edition is on your phone.
      </p>
      <div class="goto__edition">
        {
          edition.map((photo) => (
            <figure>
              <Image src={photo.src} alt={photo.alt} widths={[360, 520, 720]} sizes="(max-width: 40rem) 45vw, 330px" format="webp" quality={74} loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <hr class="rule" />
    <section class="goto__section">
      <h2>Supported hardware</h2>
      <p>
        Runs on the <strong>XTEINK X4</strong> and the <strong>XTEINK X4 Pro</strong>
        running CrossPoint Reader. Not sure which you have? The X4 Pro has a
        touchscreen and a warm/cool frontlight; the original X4 does not. Support for
        other CrossPoint-compatible e-ink devices may follow as the project develops.
      </p>
    </section>

    <hr class="rule" />
    <section class="goto__section" id="download">
      <h2>Download</h2>
      <p>
        Project GOTO runs on two devices, each with its own installer. Choose your
        hardware below. After installing, GOTO lives in the <strong>Apps</strong>
        menu on the CrossPoint home screen, and later releases install over Wi-Fi
        from Settings → System → Check for updates.
      </p>

      <div class="goto__devices">
        <article class="goto__device">
          <h3 class="goto__device-name">XTEINK X4 <span class="goto__device-method">· microSD update</span></h3>
          <dl class="goto__meta">
            <div><dt>Release</dt><dd>v1.0.3 · CrossPoint 1.6.0 + Apps 1.0.3</dd></div>
            <div><dt>On-device identity</dt><dd>1.6.0-A1.0.3-G</dd></div>
          </dl>
          <p class="goto__actions">
            <a
              class="goto__download"
              href="https://github.com/archievalmariano/crosspoint-reader/releases/download/v1.0.3/firmware-x4-g.bin"
            >Download for XTEINK X4</a>
          </p>
          <p class="goto__links">
            <a href="/desk/goto/install/">Installation guide</a> · microSD updater
            <span aria-hidden="true">·</span>
            <a href="https://github.com/archievalmariano/crosspoint-reader/releases/tag/v1.0.3" target="_blank" rel="noopener">Release notes</a>
          </p>
          <p class="goto__sha">
            <span class="goto__sha-label">SHA-256</span>
            <code>3e50954f514e09fe70603be95a40a4e1f8024b09db66cade5b465e888f8fc0aa</code>
          </p>
        </article>

        <article class="goto__device">
          <h3 class="goto__device-name">XTEINK X4 Pro <span class="goto__device-method">· USB flashing</span></h3>
          <dl class="goto__meta">
            <div><dt>Release</dt><dd>v1.0.3 · CrossPoint 1.6.0 + Apps 1.0.3</dd></div>
            <div><dt>On-device identity</dt><dd>1.6.0-A1.0.3-G</dd></div>
          </dl>
          <p class="goto__actions">
            <a
              class="goto__download"
              href="https://github.com/archievalmariano/crosspoint-reader/releases/download/v1.0.3/firmware-x4pro-g.factory.bin"
            >Download for XTEINK X4 Pro</a>
          </p>
          <p class="goto__links">
            <a href="/desk/goto/install/x4-pro/">Installation guide</a> · USB (esptool)
            <span aria-hidden="true">·</span>
            <a href="https://github.com/archievalmariano/crosspoint-reader/releases/tag/v1.0.3" target="_blank" rel="noopener">Release notes</a>
          </p>
          <p class="goto__sha">
            <span class="goto__sha-label">SHA-256</span>
            <code>4654ad66d75cc64f91e4b76d2b5e10e40236c9dc976d7e84b4c533ca3633360f</code>
          </p>
          <p class="goto__install-more">
            Also want ON POINT, a P2P bus departure board? The X4 Pro has a combined
            GOTO + ON POINT package, <code>firmware-x4pro-gp.factory.bin</code>, in the
            same release.
          </p>
        </article>
      </div>
    </section>

    <hr class="rule" />
    <section class="goto__section">
      <h2>Installing on the XTEINK X4</h2>
      <ol class="goto__steps">
        <li>Download <code>firmware-x4-g.bin</code>.</li>
        <li>Copy it to the root of a microSD card.</li>
        <li>On the X4, open Settings → System → SD Card Firmware Update.</li>
        <li>Select the GOTO firmware and install it.</li>
        <li>Open Apps → GOTO.</li>
      </ol>
      <p class="goto__install-more">
        See the <a href="/desk/goto/install/">full X4 installation guide</a> for details.
      </p>
      <p class="goto__install-more">
        On the <strong>XTEINK X4 Pro</strong>, installation is over USB (direct
        flashing) instead — see the <a href="/desk/goto/install/x4-pro/">X4 Pro installation
        guide</a>.
      </p>
      <p class="goto__limitation">
        If Wi-Fi is not connected when you open GOTO, it opens CrossPoint’s Wi-Fi
        screen first. Connect for the latest edition, or press Back to read the last
        saved one.
      </p>
    </section>

    <hr class="rule" />
    <section class="goto__section">
      <h2>Notes</h2>
      <p>
        Project GOTO is still in active development. The current version uses GMA
        News as its source.
      </p>
    </section>

    <p class="goto__note">
      Part of Archieval Mariano’s e-ink / CrossPoint projects. Stories and reporting
      remain with their original publishers.
    </p>
  </section>
</BaseLayout>

<style>
  .goto {
    max-width: var(--measure);
    padding-block: var(--space-lg) var(--space-xl);
  }
  .goto__back {
    font-size: var(--step--1);
    margin: 0 0 var(--space-md);
  }
  .goto__head {
    border-bottom: var(--heavy-rule);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .goto__head h1 {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    margin-top: var(--space-xs);
  }
  .goto__tagline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin: var(--space-sm) 0 0;
  }
  .goto__lede {
    font-size: var(--step-0);
    line-height: 1.72;
    color: var(--ink);
    max-width: 42rem;
    margin-bottom: var(--space-lg);
  }
  .goto__section {
    margin-block: var(--space-lg);
  }
  .goto__section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .goto__section p {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
  }
  .goto__edition {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    max-width: 42rem;
    margin-top: var(--space-md);
  }
  .goto__edition figure {
    margin: 0;
  }
  .goto__edition img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .goto__edition figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-faint);
  }
  .goto__note {
    margin-top: var(--space-lg);
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* Release / download */
  .goto__devices {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  .goto__device {
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }
  .goto__device:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .goto__device-name {
    font-size: var(--step-0);
    margin: 0;
  }
  .goto__device-method {
    color: var(--ink-faint);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .goto__meta {
    margin: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-xs) var(--space-md);
  }
  .goto__meta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em var(--space-sm);
    align-items: baseline;
  }
  .goto__meta dt {
    color: var(--ink-faint);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    min-width: 12rem;
  }
  .goto__meta dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-0);
  }
  .goto__actions {
    margin: var(--space-md) 0 0;
  }
  .goto__download {
    display: inline-block;
    padding: 0.7rem 1.15rem;
    border: var(--heavy-rule);
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .goto__download:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .goto__links {
    margin: var(--space-md) 0 0;
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
  .goto__links span {
    margin: 0 0.5em;
    color: var(--rule);
  }
  .goto__sha {
    margin: var(--space-md) 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .goto__sha-label {
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-right: 0.6em;
  }
  .goto__sha code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82em;
    word-break: break-all;
    color: var(--ink);
  }
  .goto__steps {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }
  .goto__steps code,
  .goto__install-more code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
  }
  .goto__install-more {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: var(--space-sm) 0 0;
  }
  .goto__limitation {
    margin: var(--space-md) 0 0;
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 42rem;
  }
</style>
