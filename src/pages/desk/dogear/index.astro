---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import imgIssue from '../../../assets/photos/dogear-01-issue-x4-x4pro.jpg';
import imgEntryX4Pro from '../../../assets/photos/dogear-02-entry-x4pro.jpg';
import imgEntryX4 from '../../../assets/photos/dogear-03-entry-x4.jpg';
import imgScan from '../../../assets/photos/dogear-04-scan.jpg';
import imgApps from '../../../assets/photos/dogear-05-apps-x4pro.jpg';
import imgWeb from '../../../assets/photos/dogear-06-web-edition.jpg';

const release = 'https://github.com/archievalmariano/crosspoint-reader/releases';

// One issue, an entry on each device.
const entries = [
  {
    src: imgEntryX4Pro,
    alt: 'A DOGEAR entry on an XTEINK X4 Pro: 14 October, born 1988, Ocean Vuong is born in Saigon, page 4 of 6.',
    caption: 'One writer, book or anniversary per screen, here on the X4 Pro.',
  },
  {
    src: imgEntryX4,
    alt: 'A DOGEAR entry on an XTEINK X4: 17 October, born 1948, Robert Jordan is born in Charleston, page 5 of 6.',
    caption: 'The same issue on the X4, laid out for its screen.',
  },
];

// From the last screen to the web edition.
const web = [
  {
    src: imgScan,
    alt: 'A phone camera pointed at an XTEINK X4 showing the DOGEAR QR code for the full edition, detecting dogear.archievalmariano.com, with an X4 Pro showing the issue cover beside it.',
    caption: 'Scan the QR code on the last screen with your phone’s camera.',
  },
  {
    src: imgWeb,
    alt: 'The DOGEAR web edition for 26 October to 1 November 2026 in a phone browser at dogear.archievalmariano.com, with the quiet-week note and the four entries listed under In this issue.',
    caption: 'The full edition opens in your browser, with each entry’s sources and reading links.',
  },
];

// The DOGEAR packages in the current release (they always include GOTO, ON POINT or both).
const packages = [
  {
    name: 'GOTO + DOGEAR',
    device: 'XTEINK X4',
    method: 'microSD update',
    file: 'firmware-x4-gd.bin',
    identity: '1.6.5-A1.2.0-GD',
    sha256: '8d9b99806676925fc04d603ddb2b62a064c0be6acf1b17e042a4613b03321302',
    guide: { href: '/desk/goto/install/', label: 'Installation guide', via: 'microSD updater' },
  },
  {
    name: 'GOTO + DOGEAR',
    device: 'XTEINK X4 Pro',
    method: 'USB flashing',
    file: 'firmware-x4pro-gd.factory.bin',
    identity: '1.6.5-A1.2.0-GD',
    sha256: '34730b4808358daba3d1ccbcaaa0b8123ce5285d380911b84e7b80961c80dfe1',
    guide: { href: '/desk/goto/install/x4-pro/', label: 'Installation guide', via: 'USB (esptool)' },
  },
  {
    name: 'ON POINT + DOGEAR',
    device: 'XTEINK X4 Pro',
    method: 'USB flashing',
    file: 'firmware-x4pro-pd.factory.bin',
    identity: '1.6.5-A1.2.0-PD',
    sha256: 'b1e4d993b69628fc9dc03e4ced8411e2c1160609b6cbfc458b48f13690547074',
    guide: { href: '/desk/goto/install/x4-pro/', label: 'Installation guide', via: 'USB (esptool)' },
  },
  {
    name: 'GOTO + ON POINT + DOGEAR',
    device: 'XTEINK X4 Pro',
    method: 'USB flashing',
    file: 'firmware-x4pro-gpd.factory.bin',
    identity: '1.6.5-A1.2.0-GPD',
    sha256: '73a769c3e93881b686ecf48238b5b5b6de7fc286cf46b70202b0e7dc9e29a774',
    guide: { href: '/desk/goto/install/x4-pro/', label: 'Installation guide', via: 'USB (esptool)' },
  },
];
const x4ProPackages = packages.filter((pkg) => pkg.device === 'XTEINK X4 Pro');
---

<BaseLayout
  title="DOGEAR — Archieval Mariano"
  description="DOGEAR is a limited weekly reading digest of writers, books, literary anniversaries and discoveries, published every Monday for the web and for XTEINK X4 and X4 Pro e-ink readers running CrossPoint Reader."
>
  <section class="wrap dg">
    <p class="dg__back"><a href="/desk/">&larr; Desk</a></p>
    <header class="dg__head">
      <p class="eyebrow">Project</p>
      <h1>DOGEAR</h1>
      <p class="dg__tagline">A limited weekly reading digest.</p>
    </header>

    <p class="dg__lede">
      DOGEAR is a short weekly issue about books and the people who write them:
      writers, books, literary anniversaries and discoveries worth revisiting. It is
      published on the web and for the XTEINK X4 and X4 Pro, in compact reading
      screens made for their e-ink displays. Read the week’s handful of entries, and
      scan a QR code if you want the full edition on your phone.
    </p>

    <figure class="dg__hero">
      <Image
        src={imgIssue}
        alt="Two e-ink readers showing the DOGEAR issue for 26 October to 1 November 2026: an XTEINK X4 with the cover, listing Arthur Miller, Orhan Pamuk, Ocean Vuong and Robert Jordan, and an XTEINK X4 Pro with the last screen, a QR code for the full edition and the next issue on Monday 2 November 2026."
        widths={[480, 720, 960]}
        sizes="(max-width: 40rem) 92vw, 30rem"
        format="webp"
        quality={76}
      />
      <figcaption>The 26 October 2026 issue: the cover on the X4, and the last screen, with its QR code, on the X4 Pro.</figcaption>
    </figure>

    <section class="dg__section">
      <h2>Concept</h2>
      <p>
        A new issue arrives every Monday, covering that week. Each one is a small,
        chosen set of entries from a curated calendar of literary dates: writers’
        births and deaths, books and their publication, prizes and other literary
        anniversaries, and the occasional discovery. The cover lists the week, and each
        entry gets a screen of its own. Some weeks are quieter than others, and the
        issue says so rather than filling the space. Once you reach the end, you are done
        until next Monday.
      </p>
      <div class="dg__entries">
        {
          entries.map((photo) => (
            <figure>
              <Image src={photo.src} alt={photo.alt} widths={[360, 520, 720]} sizes="(max-width: 40rem) 45vw, 330px" format="webp" quality={74} loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <hr class="rule" />
    <section class="dg__section">
      <h2>From the e-ink screen to your phone</h2>
      <p>
        The issue ends with one QR code that opens the week’s full edition on the web:
        the stories in full, their sources, and reading links. You can also read every
        issue at
        <a href="https://dogear.archievalmariano.com/" target="_blank" rel="noopener">dogear.archievalmariano.com <span aria-hidden="true">↗</span></a>.
      </p>
      <div class="dg__entries">
        {
          web.map((photo) => (
            <figure>
              <Image src={photo.src} alt={photo.alt} widths={[360, 520, 720]} sizes="(max-width: 40rem) 45vw, 330px" format="webp" quality={74} loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="dg__more">
        Some entries go further than the story. When a book is free to read online,
        the entry links straight to it: in the
        <a href="https://dogear.archievalmariano.com/2026-10-19/#birth-oscar-wilde" target="_blank" rel="noopener">19 October 2026 issue <span aria-hidden="true">↗</span></a>,
        Oscar Wilde’s entry carried a <strong>READ ONLINE</strong> link to
        <a href="https://www.gutenberg.org/ebooks/174" target="_blank" rel="noopener"><em>The Picture of Dorian Gray</em> on Project Gutenberg <span aria-hidden="true">↗</span></a>,
        which on the device opens as a QR code of its own. Other entries lead somewhere
        worth reading next, such as the Nobel Prize page for that year’s laureate or a
        biography, and some have no link at all.
      </p>
      <p class="dg__limitation">
        A free-reading link is offered only for an edition that is in the public domain
        everywhere. Some books on Project Gutenberg are public domain in the United States
        but not in every country, and DOGEAR doesn’t link those.
      </p>
    </section>

    <hr class="rule" />
    <section class="dg__section">
      <h2>Supported hardware</h2>
      <p>
        Runs on the <strong>XTEINK X4</strong> and <strong>XTEINK X4 Pro</strong> running
        CrossPoint Reader. DOGEAR presents the same weekly literary digest in layouts
        adapted to each device’s screen. Not sure which you have? The X4 Pro has a
        touchscreen and a warm/cool frontlight; the original X4 does not.
      </p>
      <p class="dg__install-more">
        <a href="https://go.sjv.io/0G7zZN" target="_blank" rel="sponsored noopener noreferrer">XTEINK official store <span aria-hidden="true">↗</span></a><br />
        Affiliate link. I may earn a commission on qualifying purchases.
      </p>
    </section>

    <hr class="rule" />
    <section class="dg__section" id="download">
      <h2>Download</h2>
      <p>
        DOGEAR comes in the packages that name it, together with
        <a href="/desk/goto/">GOTO</a>, <a href="/desk/on-point/">ON POINT</a> or both.
        On the X4 that is GOTO + DOGEAR, installed from a microSD card; on the X4 Pro,
        choose any of the three, installed over USB. After installing, DOGEAR lives in
        the <strong>Apps</strong> menu on the CrossPoint home screen, and later releases
        install over Wi-Fi from Settings → System → Check for updates, keeping the
        package you chose. If you already run GOTO or ON POINT, install a DOGEAR package
        once by hand to add it.
      </p>

      <div class="dg__devices">
        {
          packages.map((pkg) => (
            <article class="dg__device">
              <h3 class="dg__device-name">
                {pkg.name} <span class="dg__device-method">· {pkg.device} · {pkg.method}</span>
              </h3>
              <dl class="dg__meta">
                <div><dt>Release</dt><dd>v1.2.0 · CrossPoint 1.6.5 + Apps 1.2.0</dd></div>
                <div><dt>On-device identity</dt><dd>{pkg.identity}</dd></div>
              </dl>
              <p class="dg__actions">
                <a class="dg__download" href={`${release}/download/v1.2.0/${pkg.file}`}>
                  Download for {pkg.device}
                </a>
              </p>
              <p class="dg__links">
                <code>{pkg.file}</code>
                <span aria-hidden="true">·</span>
                <a href={pkg.guide.href}>{pkg.guide.label}</a> · {pkg.guide.via}
                <span aria-hidden="true">·</span>
                <a href={`${release}/tag/v1.2.0`} target="_blank" rel="noopener">Release notes</a>
              </p>
              <p class="dg__sha">
                <span class="dg__sha-label">SHA-256</span>
                <code>{pkg.sha256}</code>
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <hr class="rule" />
    <section class="dg__section">
      <h2>Installing on the XTEINK X4</h2>
      <ol class="dg__steps">
        <li>Download <code>firmware-x4-gd.bin</code>.</li>
        <li>Copy it to the root of a microSD card.</li>
        <li>On the X4, open Settings → System → SD Card Firmware Update.</li>
        <li>Select the DOGEAR firmware and install it.</li>
        <li>Open Apps → DOGEAR.</li>
      </ol>
      <p class="dg__install-more">
        The <a href="/desk/goto/install/">X4 installation guide</a> covers each step with
        photos. It is written for GOTO, and the steps are the same with the DOGEAR file.
      </p>
    </section>

    <hr class="rule" />
    <section class="dg__section">
      <h2>Installing on the XTEINK X4 Pro</h2>
      <ol class="dg__steps">
        <li>Download the factory image for the package you want.</li>
        <li>
          Connect the X4 Pro over USB and find its port. On macOS it looks like
          <code>/dev/cu.usbmodem101</code>; the guide below covers Linux and Windows.
        </li>
        <li>
          In the folder that holds the download, flash the file for your package at
          <code>0x0</code> with esptool, replacing the port with yours.
          {
            x4ProPackages.map((pkg) => (
              <>
                <p class="dg__cmd-label">{pkg.name}</p>
                <pre class="dg__code"><code>esptool --chip esp32s3 --port /dev/cu.usbmodem101 --baud 921600 write_flash 0x0 {pkg.file}</code></pre>
              </>
            ))
          }
        </li>
        <li>After it restarts, connect to Wi-Fi.</li>
        <li>Open Apps → DOGEAR.</li>
      </ol>
      <figure class="dg__figure">
        <Image src={imgApps} alt="The CrossPoint Apps screen on an XTEINK X4 Pro listing DOGEAR, GOTO and ON POINT, then a Tools heading above Calculator, Calendar and Clock." widths={[360, 520, 720]} sizes="(max-width: 40rem) 60vw, 260px" format="webp" quality={74} loading="lazy" />
        <figcaption>DOGEAR in the Apps menu on the X4 Pro, installed here with GOTO and ON POINT, with <a href="/desk/tools/">Tools</a> below.</figcaption>
      </figure>
      <p class="dg__install-more">
        The <a href="/desk/goto/install/x4-pro/">X4 Pro USB guide</a> covers installing
        esptool, finding the port and troubleshooting. It is written for GOTO, and the
        steps are the same with the DOGEAR file.
      </p>
      <p class="dg__limitation">
        Flashing a factory image replaces the internal firmware and may reset settings
        and saved Wi-Fi. Your microSD card is not affected.
      </p>
      <p class="dg__limitation">
        DOGEAR downloads the week’s issue over Wi-Fi. If Wi-Fi is not connected when you
        open it, it opens CrossPoint’s Wi-Fi screen first. Connect for the latest issue,
        or press Back to read the last saved one, marked <strong>CACHED</strong>.
      </p>
    </section>

    <hr class="rule" />
    <section class="dg__section">
      <h2>Notes</h2>
      <p>
        DOGEAR is an independent project. The web edition lists the sources for each
        entry, and the books and pages it links to remain with their publishers.
      </p>
    </section>

    <p class="dg__note">
      Part of Archieval Mariano’s e-ink / CrossPoint projects.
    </p>
  </section>
</BaseLayout>

<style>
  .dg {
    max-width: var(--measure);
    padding-block: var(--space-lg) var(--space-xl);
  }
  .dg__back {
    font-size: var(--step--1);
    margin: 0 0 var(--space-md);
  }
  .dg__head {
    border-bottom: var(--heavy-rule);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .dg__head h1 {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    margin-top: var(--space-xs);
  }
  .dg__tagline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin: var(--space-sm) 0 0;
  }
  .dg__lede {
    font-size: var(--step-0);
    line-height: 1.72;
    color: var(--ink);
    max-width: 42rem;
    margin-bottom: var(--space-lg);
  }
  .dg__hero {
    margin: 0 0 var(--space-lg);
    max-width: 30rem;
  }
  .dg__section {
    margin-block: var(--space-lg);
  }
  .dg__section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .dg__section p {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
  }
  .dg__entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    max-width: 42rem;
    margin-top: var(--space-md);
  }
  .dg__entries figure,
  .dg__figure {
    margin: 0;
  }
  .dg__figure {
    margin-top: var(--space-md);
    max-width: 260px;
  }
  .dg__hero img,
  .dg__entries img,
  .dg__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .dg__hero figcaption,
  .dg__entries figcaption,
  .dg__figure figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-faint);
  }
  .dg__note {
    margin-top: var(--space-lg);
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  /* Release / download */
  .dg__devices {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  .dg__device {
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }
  .dg__device:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .dg__device-name {
    font-size: var(--step-0);
    margin: 0;
  }
  .dg__device-method {
    color: var(--ink-faint);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .dg__meta {
    margin: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-xs) var(--space-md);
  }
  .dg__meta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em var(--space-sm);
    align-items: baseline;
  }
  .dg__meta dt {
    color: var(--ink-faint);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    min-width: 12rem;
  }
  .dg__meta dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-0);
  }
  .dg__actions {
    margin: var(--space-md) 0 0;
  }
  .dg__download {
    display: inline-block;
    padding: 0.7rem 1.15rem;
    border: var(--heavy-rule);
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dg__download:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .dg__links {
    margin: var(--space-md) 0 0;
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
  .dg__links span {
    margin: 0 0.5em;
    color: var(--rule);
  }
  .dg__links code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
    word-break: break-all;
  }
  .dg__sha {
    margin: var(--space-md) 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .dg__sha-label {
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    margin-right: 0.6em;
  }
  .dg__sha code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82em;
    word-break: break-all;
    color: var(--ink);
  }
  .dg__steps {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }
  .dg__steps code,
  .dg__install-more code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
  }
  .dg__section .dg__cmd-label {
    margin: var(--space-sm) 0 0;
    font-size: .72rem;
    font-weight: 750;
    letter-spacing: .075em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .dg__code {
    display: block;
    margin: var(--space-xs) 0;
    padding: var(--space-sm);
    background: var(--paper-raised);
    white-space: pre-wrap;
  }
  .dg__code code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82em;
    word-break: break-all;
    color: var(--ink);
  }
  .dg__section .dg__more {
    margin: var(--space-md) 0 0;
  }
  .dg__section .dg__install-more {
    color: var(--ink-soft);
    max-width: 42rem;
    margin: var(--space-sm) 0 0;
  }
  .dg__section .dg__limitation {
    margin: var(--space-md) 0 0;
    color: var(--ink-faint);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 42rem;
  }
</style>
