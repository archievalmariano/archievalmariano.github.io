---
import type { CollectionEntry } from 'astro:content';
import { hasCaseStudy } from '../utils/work';

interface Props {
  entry: CollectionEntry<'work'>;
  variant?: 'selected' | 'archive';
  number?: number;
}

const { entry, variant = 'selected', number } = Astro.props;
const d = entry.data;

const org = d.anonymized ? 'Confidential' : d.companyOrClient;
const metaTop = [d.year, d.category].filter(Boolean).join(' · ');

// Listing-only projects render as static content, not links.
const clickable = hasCaseStudy(entry) && !d.privateCaseStudy;
const Wrapper = clickable ? 'a' : 'div';
---

<li class:list={['work-card', `work-card--${variant}`]} data-number={number ? String(number).padStart(2, '0') : undefined}>
  <Wrapper
    class:list={['work-card__link', { 'work-card__link--static': !clickable }]}
    {...(clickable ? { href: `/work/${entry.slug}` } : {})}
  >
    {metaTop && <p class="meta work-card__meta">{metaTop}</p>}
    <h3 class="work-card__title">{d.title}</h3>
    <p class="work-card__desc">{d.shortDescription}</p>
    {org && <p class="meta work-card__org">{org}</p>}
    {
      d.tags.length > 0 && (
        <ul class="tags">
          {d.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {clickable && <span class="work-card__arrow" aria-hidden="true">Read the story →</span>}
    {d.privateCaseStudy && <span class="work-card__status">Private case study</span>}
  </Wrapper>
</li>

<style>
  .work-card {
    position: relative;
    display: flex;
    border-right: var(--heavy-rule);
    border-bottom: var(--heavy-rule);
  }

  .work-card::before {
    content: attr(data-number);
    position: absolute;
    padding: 1.1rem;
    font-size: .7rem;
    font-weight: 800;
  }

  .work-card__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 31rem;
    padding: clamp(3.5rem, 6vw, 6rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    text-decoration: none;
  }

  .work-card__meta {
    margin-bottom: var(--space-xs);
  }

  .work-card__title {
    max-width: 15ch;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3vw, 3.3rem);
    font-weight: 740;
    letter-spacing: -.045em;
    line-height: 1;
  }

  a.work-card__link:hover .work-card__title {
    color: var(--accent);
  }

  /* Static (listing-only) cards give no clickable affordance. */
  .work-card__link--static {
    cursor: default;
  }

  .work-card__desc {
    margin: var(--space-sm) 0;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.46;
  }

  .work-card__org {
    margin-top: var(--space-xs);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    border: 1px solid var(--ink);
    padding: 0.15em 0.75em;
  }

  .work-card__arrow {
    display: block;
    width: fit-content;
    margin-top: auto;
    padding-top: var(--space-lg);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .work-card__status {
    display: block;
    width: fit-content;
    margin-top: auto;
    padding-top: var(--space-lg);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .work-card:nth-child(4n + 1) { background: var(--blue-soft); }
  .work-card:nth-child(4n + 2) { background: var(--yellow); }
  .work-card:nth-child(4n + 3) { background: var(--coral); }
  .work-card:nth-child(4n) { background: color-mix(in srgb, var(--coral) 76%, var(--paper)); }

  .work-card.work-card--archive {
    background: var(--paper);
  }

  .work-card--archive .work-card__link {
    min-height: 25rem;
  }

  .work-card--archive .work-card__title {
    font-size: clamp(1.75rem, 2.6vw, 2.8rem);
  }

  @media (max-width: 44rem) {
    .work-card {
      border-right: 0;
    }

    .work-card__link {
      min-height: 27rem;
    }
  }
</style>
