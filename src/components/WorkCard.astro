---
import type { CollectionEntry } from 'astro:content';
import { hasCaseStudy } from '../utils/work';

interface Props {
  entry: CollectionEntry<'work'>;
  variant?: 'selected' | 'archive';
}

const { entry, variant = 'selected' } = Astro.props;
const d = entry.data;
const organization = d.anonymized ? 'Confidential' : d.companyOrClient;
const metadata = [d.year, d.category].filter(Boolean).join(' · ');

// Private and listing-only entries remain visible without a detail link.
const clickable = hasCaseStudy(entry) && !d.privateCaseStudy;
const Wrapper = clickable ? 'a' : 'div';
const titleId = `work-${entry.slug}`;
const actionId = `${titleId}-action`;
---

<li class:list={['work-card', `work-card--${variant}`]}>
  <Wrapper
    class="work-card__row"
    {...(clickable ? { href: `/work/${entry.slug}`, 'aria-labelledby': `${titleId} ${actionId}` } : {})}
  >
    <div class="work-card__body">
      <h3 class="work-card__title" id={titleId}>{d.title}</h3>
      <p class="work-card__desc">{d.shortDescription}</p>
    </div>
    <div class="work-card__details">
      {metadata && <p class="meta">{metadata}</p>}
      {organization && <p class="meta">{organization}</p>}
      {clickable && <span class="work-card__action" id={actionId}>Read the story <span aria-hidden="true">→</span></span>}
      {d.privateCaseStudy && <span class="work-card__status">Private case study</span>}
    </div>
  </Wrapper>
</li>

<style>
  .work-card {
    border-bottom: 1px solid var(--rule);
  }

  .work-card__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, .3fr);
    align-items: start;
    gap: var(--space-sm) clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.15rem, 2.4vw, 1.85rem) var(--space-sm);
    color: var(--ink);
    text-decoration: none;
  }

  .work-card--selected .work-card__row {
    border-inline-start: 2px solid var(--coral);
    padding-inline-start: var(--space-md);
  }

  .work-card__title {
    max-width: 36ch;
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 740;
    letter-spacing: -.04em;
    line-height: 1.08;
  }

  .work-card__desc {
    max-width: 64ch;
    margin: var(--space-xs) 0 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .work-card__details {
    display: grid;
    gap: .35rem;
  }

  .work-card__details p { margin: 0; }

  .work-card__action,
  .work-card__status {
    margin-top: .3rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 720;
  }

  .work-card__status { color: var(--ink-soft); }

  a.work-card__row:is(:hover, :focus-visible) .work-card__title {
    text-decoration: underline;
    text-decoration-thickness: .06em;
    text-underline-offset: .14em;
  }

  a.work-card__row:focus-visible {
    outline-color: var(--ink);
    outline-offset: -3px;
  }

  @media (max-width: 44rem) {
    .work-card__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .work-card--selected .work-card__row {
      padding-inline-start: var(--space-sm);
    }
  }
</style>
