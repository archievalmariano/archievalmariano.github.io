---
// Primary navigation: Desk · Work · About · Contact (approved homepage design,
// exploration D). Writing and Services keep their URLs and are reached from
// the Work section of the homepage and from the footer directory.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/desk/', label: 'Desk' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) => {
  const base = href.replace(/\/$/, '');
  return pathname === base || pathname.startsWith(base + '/');
};
---

<header class="site-head">
  <div class="wrap site-head__inner">
    <a href="/" class="wordmark" aria-label="Archieval Mariano — home">Archieval&nbsp;Mariano</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head { border-bottom: 1px solid var(--rule); }
  .site-head__inner { display: flex; align-items: center; justify-content: space-between; gap: .75rem 2rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .wordmark { font-size: 1.02rem; font-weight: 780; letter-spacing: -.03em; text-decoration: none; }
  .wordmark::before { content: ''; display: inline-block; width: .55rem; aspect-ratio: 1; margin-right: .5rem; border-radius: 50%; background: var(--coral); }
  .wordmark:hover { color: var(--accent); }
  nav ul { display: flex; flex-wrap: wrap; gap: .3rem 1.75rem; margin: 0; padding: 0; list-style: none; }
  nav a { display: inline-block; padding-block: .25rem; font-size: .9rem; font-weight: 580; color: var(--ink-soft); text-decoration: none; }
  nav a:hover { color: var(--accent); }
  /* Current section (not shown on the homepage, which is not in the nav). */
  nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: .4em; }

  @media (max-width: 36rem) {
    nav ul { gap: .3rem 1.4rem; }
  }
</style>
