---
// DIRECTION D — QUIET PERSONAL SITE (iteration 4: adaptive Desk, composition)
//
// Selected foundation. A restrained evolution of the production homepage:
// same palette, Inter + Newsreader, rules, portrait, photography, and dark
// closing panel.
//
// Information architecture (preview only — no route, collection, or
// production navigation is changed; every link points at an existing URL):
//
//   Desk     Projects       /desk/projects/  (published)
//            Artifacts      gated by src/data/desk.ts — no link until launched
//            Field Notes    gated by src/data/desk.ts — no link until launched
//   Work     Case studies   /work/
//            Commissioned writing  /writing/  (URLs unchanged)
//            Services       /services/
//   About    /about/
//   Contact  /contact/
//
// DESK is a stack of rows, one per subsection. A row EXPANDS (identity,
// description, link, and one featured item) only when that subsection has
// published content; otherwise it stays COMPACT (name and description only —
// no link, no URL, no status notice, no empty media area). So the page is
// complete with Projects alone, and Artifacts / Field Notes expand on their own
// once launched through the existing gate (isPublished, read-only here).
//
//   • Projects' featured item: the registry's `featured` project (falling back
//     to the first homepage-eligible project by `order`). Rotating it is a data
//     change in src/content/projects/*.json.
//   • Artifacts / Field Notes' featured item: featured entry first, then latest
//     by pubDate; never drafts. Unpublished collections are never queried.
//
// All copy is reused from existing pages, except the two provisional
// descriptions for Artifacts and Field Notes (marked below).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deskCollections, isPublished, type DeskCollectionKey } from '../../data/desk';
import onPointBoard from '../../assets/photos/onpoint-01-board.jpg';
import gotoStory from '../../assets/photos/goto-edition-01-story.jpg';
import {
  closing,
  cover,
  loadArchive,
  photos,
  portraitPhoto,
  siteLinks,
  throughline,
  workHref,
  writingIntro,
} from './archive';

const HOME_CASE_STUDIES = 2;

const { featuredWork, projects } = await loadArchive();
const caseStudies = featuredWork.slice(0, HOME_CASE_STUDIES); // ordered by `order`

// ── DESK rows ───────────────────────────────────────────────────────────────
type Featured = {
  title: string;
  subtitle?: string;
  description: string;
  meta?: string;
  href: string;
  linkLabel: string;
  image?: { src: ImageMetadata; alt: string };
  frame?: string; // CSS custom properties for a framed (cropped) screen
};
type Row = {
  key: string;
  name: string;
  subtitle?: string;
  description: string;
  href?: string; // only for published destinations
  linkLabel?: string;
  featured?: Featured;
};

// Projects: data-driven featured project.
const eligibleProjects = projects.filter((p) => p.data.homepage && p.data.heroImage); // sorted by `order`
const featuredProject = eligibleProjects.find((p) => p.data.featured) ?? eligibleProjects[0];

// Optional presentation hints, used only if one of these projects becomes the
// featured one: frame an existing, unmodified photograph to its screen (crop
// box in source pixels) so the image shows what the project does.
const framing: Record<string, { src: ImageMetadata; alt: string; box: [number, number, number, number] }> = {
  'on-point': {
    src: onPointBoard,
    alt: 'ON POINT showing 15 minutes until the 09:30 bus from Balagtas to TriNoma, with the next trip at 10:00 and the last at 20:00.',
    box: [262, 178, 846, 1075],
  },
  goto: {
    src: gotoStory,
    alt: 'The top story of a GOTO morning edition: Carlos Yulo shows support for Alex Eala, EJ Obiena ahead of Asian Games campaigns.',
    box: [198, 146, 918, 634],
  },
};

function projectFeature(): Featured | undefined {
  if (!featuredProject) return undefined;
  const d = featuredProject.data;
  const f = framing[d.slug];
  return {
    title: d.name,
    subtitle: d.subtitle && d.subtitle !== d.name ? d.subtitle : undefined,
    description: d.purpose,
    meta: d.facts.join(' · '),
    href: `/desk/${d.slug}/`,
    linkLabel: `Open ${d.name}`,
    image: f ? { src: f.src, alt: f.alt } : { src: d.heroImage!, alt: d.heroAlt ?? '' },
    frame: f
      ? `--iw:${f.src.width};--cx:${f.box[0]};--cy:${f.box[1]};--cw:${f.box[2] - f.box[0]};--ch:${f.box[3] - f.box[1]}`
      : undefined,
  };
}

// PROVISIONAL descriptions for the editorial categories (paraphrased from the
// redesign brief; for the author to approve or rewrite). Plain text.
const editorialCopy: Record<DeskCollectionKey, string> = {
  artifacts: 'Personal writing about gadgets, objects, and products.',
  fieldNotes: 'Essays, reflections, and observations.',
};

async function editorialFeature(key: DeskCollectionKey, slug: string): Promise<Featured | undefined> {
  const all = await getCollection(key as any, ({ data }: any) => !data.draft);
  const sorted = [...all].sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const e: any = sorted.find((x: any) => x.data.featured) ?? sorted[0];
  if (!e) return undefined;
  return {
    title: e.data.title,
    subtitle: e.data.subtitle,
    description: e.data.description,
    href: `/desk/${slug}/${e.slug}/`,
    linkLabel: 'Read',
    image: e.data.heroImage ? { src: e.data.heroImage, alt: e.data.heroAlt ?? '' } : undefined,
  };
}

const rows: Row[] = [
  {
    key: 'projects',
    name: 'Projects',
    subtitle: 'Works in Progress',
    description:
      'Independent applications, utilities and experiments. Some are useful, definitely specific, and occasionally unnecessary.',
    href: '/desk/projects/',
    linkLabel: 'All projects',
    featured: projectFeature(),
  },
];
for (const c of deskCollections) {
  // Unpublished → compact row; the collection is not queried at all.
  const featured = isPublished(c.key) ? await editorialFeature(c.key, c.slug) : undefined;
  rows.push(
    featured
      ? { key: c.slug, name: c.label, subtitle: c.subtitle, description: editorialCopy[c.key], href: `/desk/${c.slug}/`, linkLabel: `All ${c.label}`, featured }
      : { key: c.slug, name: c.label, description: editorialCopy[c.key] }
  );
}

// ── Portrait: wider (square) framing of the 3:2 source ─────────────────────
// ── Photographs: one tall image beside a stack of two. The tall column's
// width is solved from the photos' own proportions (and the one caption row
// inside the stack) so the tall image ends where the lower landscape ends and
// the two bottom captions share a line. No image is cropped.
const photo = (k: string) => photos.find((p) => p.key === k)!;
const tall = photo('taipei');
const [upper, lower] = [photo('baywalk'), photo('esplanade')];
const invTall = tall.src.height / tall.src.width; // 1 / aspect
const invStack = upper.src.height / upper.src.width + lower.src.height / lower.src.width;
const photoVars = `--inv-stack:${invStack};--solve:${1 / (invTall + invStack)}`;

// ── Footer directory (destinations only) ────────────────────────────────────
const directory = [
  { head: { href: '/desk/', label: 'Desk' }, links: rows.filter((r) => r.href).map((r) => ({ href: r.href!, label: r.name })) },
  {
    head: { href: '/work/', label: 'Work' },
    links: [
      { href: '/work/', label: 'Case studies' },
      { href: '/writing/', label: 'Commissioned writing' },
      { href: '/services/', label: 'Services' },
    ],
  },
  { head: { href: '/about/', label: 'About' }, links: [] },
  { head: { href: '/contact/', label: 'Contact' }, links: [] },
];

const nav = [
  { href: '/desk/', label: 'Desk' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<div class="qs">
  <header class="qs-head">
    <div class="qs-wrap qs-head__inner">
      <a href="/preview/home/quiet/" class="qs-name">Archieval Mariano</a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <!-- 1 · Introduction -->
  <section class="qs-wrap qs-intro" aria-labelledby="qs-title">
    <div class="qs-intro__copy">
      <h1 id="qs-title">{cover.headline}</h1>
      <p class="qs-intro__statement">{cover.statement}</p>
      <p class="qs-intro__body">{cover.intro}</p>
      <p class="qs-links">
        <a href="/about/">A little about me <span aria-hidden="true">→</span></a>
        <a href="#qs-work">Explore my work <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <figure class="qs-intro__portrait">
      <Image
        src={portraitPhoto.src}
        alt={portraitPhoto.alt}
        widths={[400, 600, 800, 1000]}
        sizes="(max-width: 36rem) 13rem, (max-width: 52rem) 17rem, 20rem"
        format="webp"
        quality={76}
        loading="eager"
      />
    </figure>
  </section>

  <!-- 2 · Desk -->
  <section class="qs-section qs-desk" aria-labelledby="qs-desk-title">
    <div class="qs-wrap">
      <header class="qs-section__head">
        <h2 id="qs-desk-title"><a href="/desk/">Desk</a></h2>
        <p>
          Things from my digital desk that I’ve decided to share. Some can be useful,
          definitely specific, and occasionally unnecessary.
        </p>
      </header>

      <div class="qs-rows">
        {
          rows.map((r) => (
            <section class:list={['qs-row', r.featured ? 'qs-row--featured' : 'qs-row--compact']} aria-label={r.name}>
              <div class="qs-row__id">
                <h3 class="qs-row__name">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</h3>
                {r.featured && r.subtitle && <p class="qs-row__subtitle">{r.subtitle}</p>}
              </div>
              <div class="qs-row__about">
                <p class="qs-row__desc">{r.description}</p>
                {r.href && r.linkLabel && (
                  <p class="qs-go"><a href={r.href}>{r.linkLabel} <span aria-hidden="true">→</span></a></p>
                )}
              </div>
              {r.featured && (
                <article class:list={['qs-feature', { 'qs-feature--text': !r.featured.image }]}>
                  {r.featured.image && (
                    <figure class:list={['qs-feature__figure', { 'qs-frame': r.featured.frame }]} style={r.featured.frame}>
                      <Image src={r.featured.image.src} alt={r.featured.image.alt} widths={[240, 360, 480, 720]} sizes="(max-width: 36rem) 40vw, 11rem" format="webp" quality={76} />
                    </figure>
                  )}
                  <div class="qs-feature__text">
                    <h4>{r.featured.title}</h4>
                    {r.featured.subtitle && <p class="qs-feature__subtitle">{r.featured.subtitle}</p>}
                    <p class="qs-feature__desc">{r.featured.description}</p>
                    {r.featured.meta && <p class="qs-meta">{r.featured.meta}</p>}
                    <p class="qs-go">
                      <a href={r.featured.href}>
                        {r.featured.linkLabel}
                        {r.featured.linkLabel === 'Read' && <span class="visually-hidden"> {r.featured.title}</span>}
                        <span aria-hidden="true"> →</span>
                      </a>
                    </p>
                  </div>
                </article>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 · Away from the dashboards -->
  <section class="qs-section qs-away" aria-labelledby="qs-away-title">
    <div class="qs-wrap qs-away__grid">
      <div class="qs-away__copy">
        <h2 id="qs-away-title">Away from the dashboards</h2>
        <p class="qs-away__lead">Pretends to be a photographer and a good writer.</p>
        <p>
          That is how I describe myself on Instagram, where I post photographs and the
          occasional poem or piece of prose. It captures my discomfort with calling myself
          a photographer, or even a good writer, despite spending years taking photographs
          and writing.
        </p>
        <p>
          In my twenties, I built trips around hostels and long journeys over land, saving
          on comfort so I could spend more on experience. I still travel, but I no longer
          treat discomfort as proof that a trip mattered. I move more slowly now, chase
          fewer attractions, and leave more room to notice what is actually there.
        </p>
        <p class="qs-go"><a href="/about/">More about me <span aria-hidden="true">→</span></a></p>
      </div>

      <div class="qs-photos-wrap" style={photoVars}>
        <div class="qs-photos" aria-label="Selected photographs from my personal archive" oncontextmenu="return false">
          <figure class="qs-photo qs-photo--tall">
            <Image src={tall.src} alt={tall.alt} widths={[300, 450, 600]} sizes="(max-width: 36rem) 55vw, 14rem" format="webp" quality={76} draggable="false" />
            <figcaption>{tall.caption}</figcaption>
          </figure>
          <figure class="qs-photo qs-photo--upper">
            <Image src={upper.src} alt={upper.alt} widths={[480, 720, 960]} sizes="(max-width: 36rem) 90vw, 26rem" format="webp" quality={76} draggable="false" />
            <figcaption>{upper.caption}</figcaption>
          </figure>
          <figure class="qs-photo qs-photo--lower">
            <Image src={lower.src} alt={lower.alt} widths={[480, 720, 960]} sizes="(max-width: 36rem) 90vw, 26rem" format="webp" quality={76} draggable="false" />
            <figcaption>{lower.caption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Work -->
  <section class="qs-section qs-work" id="qs-work" aria-labelledby="qs-work-title">
    <div class="qs-wrap">
      <header class="qs-work__head">
        <div>
          <h2 id="qs-work-title"><a href="/work/">Work</a></h2>
          <p class="qs-work__through">{throughline.title}</p>
        </div>
        {throughline.paragraphs.map((p) => <p class="qs-work__para">{p}</p>)}
      </header>

      <div class="qs-work__grid">
        <section class="qs-work__cat qs-work__cat--cases" aria-labelledby="qs-cases-title">
          <h3 id="qs-cases-title"><a href="/work/">Case studies</a></h3>
          <ul class="qs-cases">
            {
              caseStudies.map((e) => (
                <li>
                  <p class="qs-meta">{[e.data.year, e.data.category].filter(Boolean).join(' · ')}</p>
                  <h4><a href={workHref(e.slug)}>{e.data.title}</a></h4>
                  <p>{e.data.shortDescription}</p>
                  <p class="qs-meta">{e.data.anonymized ? 'Confidential' : e.data.companyOrClient}</p>
                </li>
              ))
            }
          </ul>
          <p class="qs-go"><a href="/work/">All case studies <span aria-hidden="true">→</span></a></p>
        </section>

        <section class="qs-work__cat" aria-labelledby="qs-writing-title">
          <h3 id="qs-writing-title"><a href="/writing/">Commissioned writing</a></h3>
          <p>{writingIntro.aside}</p>
          <p class="qs-go"><a href="/writing/">All commissioned writing <span aria-hidden="true">→</span></a></p>
        </section>

        <section class="qs-work__cat" aria-labelledby="qs-services-title">
          <h3 id="qs-services-title"><a href="/services/">Services</a></h3>
          <p>
            Audience intelligence, digital strategy and growth, and content and digital
            operations for teams that need clearer decisions and working systems.
          </p>
          <p class="qs-go"><a href="/services/">How I can help <span aria-hidden="true">→</span></a></p>
        </section>
      </div>
    </div>
  </section>

  <!-- 5 · Closing -->
  <section class="qs-section qs-closing" aria-labelledby="qs-closing-title">
    <div class="qs-wrap qs-closing__inner">
      <h2 id="qs-closing-title">{closing.title}</h2>
      <div>
        <p>{closing.body}</p>
        <p class="qs-links">
          <a href="/about/">Read about me <span aria-hidden="true">→</span></a>
          <a href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
          <a href={siteLinks.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>
        </p>
      </div>
    </div>
  </section>

  <footer class="qs-foot">
    <div class="qs-wrap">
      <nav class="qs-foot__dir" aria-label="Site directory">
        {
          directory.map((d) => (
            <div>
              <p class="qs-foot__head"><a href={d.head.href}>{d.head.label}</a></p>
              {d.links.length > 0 && (
                <ul>
                  {d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
      <div class="qs-foot__base">
        <p>Archieval Mariano <span>© {year}</span></p>
        <p><a href={`mailto:${siteLinks.email}`}>{siteLinks.email}</a></p>
        <p><a href="#main">Back to top ↑</a></p>
      </div>
    </div>
  </footer>
</div>

<style>
  .qs { color: var(--ink); }
  .qs-wrap { width: min(100%, 76rem); margin-inline: auto; padding-inline: var(--gutter); }

  .qs h2 { font-family: var(--font-sans); font-size: clamp(1.7rem, 2.6vw, 2.5rem); font-weight: 740; letter-spacing: -.04em; line-height: 1.05; }
  .qs h2 a, .qs h3 a, .qs h4 a { text-decoration: none; }
  .qs h3, .qs h4 { font-family: var(--font-sans); font-weight: 720; letter-spacing: -.025em; line-height: 1.15; }
  .qs h2 a:hover, .qs h3 a:hover, .qs h4 a:hover { color: var(--accent); }
  .qs-meta { margin: 0; font-size: .74rem; font-weight: 650; letter-spacing: .02em; color: var(--ink-faint); }
  .qs-links { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; margin: 1.75rem 0 0; }
  .qs-links a, .qs-go a { font-size: .86rem; font-weight: 700; text-decoration-color: var(--rule); text-underline-offset: .3em; }
  .qs-links a:hover, .qs-go a:hover { text-decoration-color: var(--accent); }
  .qs-go { margin: .9rem 0 0; }

  /* Header */
  .qs-head { border-bottom: 1px solid var(--rule); }
  .qs-head__inner { display: flex; align-items: center; justify-content: space-between; gap: .75rem 2rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .qs-name { font-size: 1.02rem; font-weight: 780; letter-spacing: -.03em; text-decoration: none; }
  .qs-name::before { content: ''; display: inline-block; width: .55rem; aspect-ratio: 1; margin-right: .5rem; border-radius: 50%; background: var(--coral); }
  .qs-head ul { display: flex; flex-wrap: wrap; gap: .3rem 1.75rem; margin: 0; padding: 0; list-style: none; }
  .qs-head nav a { display: inline-block; padding-block: .25rem; font-size: .9rem; font-weight: 580; color: var(--ink-soft); text-decoration: none; }
  .qs-head nav a:hover { color: var(--accent); }

  /* 1 · Introduction — square framing of the 3:2 portrait (wider than 4:5) */
  .qs-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem); gap: clamp(2rem, 7vw, 7rem); align-items: end; padding-top: clamp(3rem, 8vw, 6.5rem); padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .qs-intro h1 { max-width: 16ch; font-family: var(--font-sans); font-size: clamp(2.4rem, 4.6vw, 4.1rem); font-weight: 740; letter-spacing: -.05em; line-height: 1; }
  .qs-intro__statement { max-width: 32rem; margin: 1.5rem 0 0; font-family: var(--font-serif); font-size: clamp(1.25rem, 1.8vw, 1.55rem); line-height: 1.42; }
  .qs-intro__body { max-width: 36rem; margin: 1rem 0 0; line-height: 1.65; color: var(--ink-soft); }
  .qs-intro__portrait { margin: 0; }
  .qs-intro__portrait :global(img) { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: 46% 40%; filter: saturate(.85) contrast(1.03); border-radius: 2px; }

  /* Sections */
  .qs-section { padding-block: clamp(3.5rem, 7vw, 5.5rem); border-top: 1px solid var(--rule); }
  .qs-section__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1rem clamp(2rem, 6vw, 6rem); align-items: baseline; margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem); }
  .qs-section__head > p { max-width: 36rem; margin: 0; font-family: var(--font-serif); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; color: var(--ink-soft); }

  /* 2 · Desk rows: identity | about | featured. Compact rows use only the
     first two columns' worth of height; the featured column simply isn't there. */
  .qs-desk { background: var(--paper-raised); border-top: 0; }
  .qs-rows { border-top: 2px solid var(--ink); }
  .qs-row { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 17rem) minmax(0, 1fr); gap: .5rem clamp(1.5rem, 3.5vw, 3rem); align-items: start; padding-block: 1.75rem; border-bottom: 1px solid var(--rule); }
  .qs-row--compact { padding-block: 1rem; align-items: baseline; }
  .qs-row--compact .qs-row__about { grid-column: 2 / -1; }
  .qs-row__name { margin: 0; font-size: 1.2rem; }
  .qs-row--compact .qs-row__name { font-size: 1.02rem; font-weight: 680; color: var(--ink-soft); }
  .qs-row__subtitle { margin: .2rem 0 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); }
  .qs-row__desc { max-width: 34rem; margin: 0; font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.5; color: var(--ink-soft); }
  .qs-row--compact .qs-row__desc { font-size: 1rem; }

  .qs-feature { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: clamp(1.25rem, 2.5vw, 2rem); align-items: start; }
  .qs-feature--text { grid-template-columns: 1fr; }
  .qs-feature--text h4 { font-family: var(--font-serif); font-weight: 520; letter-spacing: -.015em; line-height: 1.2; }
  .qs-feature__figure { margin: 0; }
  .qs-feature__figure :global(img) { display: block; width: 100%; height: auto; border-radius: 2px; }
  .qs-feature h4 { font-size: clamp(1.4rem, 2vw, 1.75rem); }
  .qs-feature__subtitle { margin: .2rem 0 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); }
  .qs-feature__desc { max-width: 32rem; margin: .55rem 0 .5rem; font-family: var(--font-serif); font-size: 1.12rem; line-height: 1.45; }
  /* AA contrast on the darker Desk band: --ink-faint is only 4.15:1 here */
  .qs-desk .qs-meta { color: var(--ink-soft); }

  /* Framed screen crop (used only if a framed project is featured) */
  .qs-frame { position: relative; overflow: hidden; aspect-ratio: var(--cw) / var(--ch); border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent); border-radius: 2px; }
  .qs-frame :global(img) { position: absolute; max-width: none; width: calc(var(--iw) / var(--cw) * 100%) !important; left: calc(var(--cx) / var(--cw) * -100%); top: calc(var(--cy) / var(--ch) * -100%); border-radius: 0; }

  /* 3 · Away from the dashboards */
  .qs-away__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
