---
// DIRECTION D — QUIET PERSONAL SITE (iteration 3: restrained homepage)
//
// Selected foundation. A restrained evolution of the production homepage:
// same palette, Inter + Newsreader, rules, portrait, photography, and dark
// closing panel.
//
// Information architecture (preview only — no route, collection, or
// production navigation is changed; every link points at an existing URL):
//
//   Desk     Projects       /desk/projects/  (published)
//            Artifacts      gated by src/data/desk.ts — no link until launched
//            Field Notes    gated by src/data/desk.ts — no link until launched
//   Work     Case studies   /work/
//            Commissioned writing  /writing/  (URLs unchanged)
//            Services       /services/
//   About    /about/
//   Contact  /contact/
//
// The homepage shows ONE item per Desk section at most:
//   • Projects: the registry's `featured` project (falling back to the first
//     homepage-eligible project by `order`). Rotating it is a data change in
//     src/content/projects/*.json — nothing here names a project.
//   • Artifacts / Field Notes: read the SAME publication gate the DESK pages
//     use (isPublished). Unpublished → plain text only: no link, no URL, no
//     entry, and the collection is never queried. Launched → a link and one
//     entry (featured first, then latest by pubDate; never drafts).
//
// All copy is reused from existing pages, except the two short category
// descriptions for Artifacts and Field Notes (draft, marked below).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { deskCollections, isPublished, type DeskCollectionKey } from '../../data/desk';
import onPointBoard from '../../assets/photos/onpoint-01-board.jpg';
import gotoStory from '../../assets/photos/goto-edition-01-story.jpg';
import {
  closing,
  cover,
  isExternal,
  loadArchive,
  photos,
  portraitPhoto,
  siteLinks,
  throughline,
  workHref,
  workIntro,
  writingHref,
  writingIntro,
  writingTitle,
} from './archive';

const HOME_CASE_STUDIES = 2;
const HOME_WRITING = 1;

const { featuredWork, featuredWriting, projects } = await loadArchive();
const caseStudies = featuredWork.slice(0, HOME_CASE_STUDIES); // ordered by `order`
const writingPicks = featuredWriting.slice(0, HOME_WRITING);

// ── Featured project (data-driven) ──────────────────────────────────────────
const eligibleProjects = projects.filter((p) => p.data.homepage && p.data.heroImage); // sorted by `order`
const featuredProject = eligibleProjects.find((p) => p.data.featured) ?? eligibleProjects[0];

// Optional presentation hints, used only if a project with a hint becomes the
// featured one. Each frames an existing, unmodified photograph to its screen
// (crop box in source pixels) so the image shows what the project does.
type Frame = { src: ImageMetadata; alt: string; box: [number, number, number, number] };
const framing: Record<string, Frame> = {
  'on-point': {
    src: onPointBoard,
    alt: 'ON POINT showing 15 minutes until the 09:30 bus from Balagtas to TriNoma, with the next trip at 10:00 and the last at 20:00.',
    box: [262, 178, 846, 1075],
  },
  goto: {
    src: gotoStory,
    alt: 'The top story of a GOTO morning edition: Carlos Yulo shows support for Alex Eala, EJ Obiena ahead of Asian Games campaigns.',
    box: [198, 146, 918, 634],
  },
};
const frame = featuredProject ? framing[featuredProject.data.slug] : undefined;
const featuredImage = frame
  ? { src: frame.src, alt: frame.alt }
  : featuredProject
    ? { src: featuredProject.data.heroImage!, alt: featuredProject.data.heroAlt ?? '' }
    : undefined;
const frameStyle = frame
  ? `--iw:${frame.src.width};--cx:${frame.box[0]};--cy:${frame.box[1]};--cw:${frame.box[2] - frame.box[0]};--ch:${frame.box[3] - frame.box[1]}`
  : undefined;

// ── Desk directory ──────────────────────────────────────────────────────────
type Entry = { href: string; title: string; description: string };
type Sub = { name: string; subtitle?: string; description: string; href?: string; entry?: Entry };

// DRAFT descriptions for the unpublished categories (paraphrased from the
// redesign brief; for the author to approve or rewrite). Plain text only.
const reservedCopy: Record<DeskCollectionKey, string> = {
  artifacts: 'Personal writing about gadgets, objects, and products.',
  fieldNotes: 'Essays, reflections, and observations.',
};

async function homepageEntry(key: DeskCollectionKey, slug: string): Promise<Entry | undefined> {
  const all = await getCollection(key as any, ({ data }: any) => !data.draft);
  const sorted = [...all].sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const pick: any = sorted.find((e: any) => e.data.featured) ?? sorted[0];
  return pick ? { href: `/desk/${slug}/${pick.slug}/`, title: pick.data.title, description: pick.data.description } : undefined;
}

const deskSubs: Sub[] = [
  {
    name: 'Projects',
    subtitle: 'Works in Progress',
    description:
      'Independent applications, utilities and experiments. Some are useful, definitely specific, and occasionally unnecessary.',
    href: '/desk/projects/',
  },
];
for (const c of deskCollections) {
  if (isPublished(c.key)) {
    const entry = await homepageEntry(c.key, c.slug);
    deskSubs.push({
      name: c.label,
      subtitle: entry ? c.subtitle : undefined,
      description: reservedCopy[c.key],
      href: entry ? `/desk/${c.slug}/` : undefined,
      entry,
    });
  } else {
    // Unpublished: description only. The collection is not queried.
    deskSubs.push({ name: c.label, description: reservedCopy[c.key] });
  }
}

// ── Photographs: one tall image beside a stack of two, sized from their own
// proportions so the columns meet without cropping any of them.
const photo = (k: string) => photos.find((p) => p.key === k)!;
const tall = photo('taipei');
const stack = [photo('baywalk'), photo('esplanade')];
const tallAR = tall.src.width / tall.src.height;
const stackAR = 1 / stack.reduce((sum, p) => sum + p.src.height / p.src.width, 0);

// ── Footer directory (destinations only) ────────────────────────────────────
const directory = [
  {
    head: { href: '/desk/', label: 'Desk' },
    links: deskSubs.filter((s) => s.href).map((s) => ({ href: s.href!, label: s.name })),
  },
  {
    head: { href: '/work/', label: 'Work' },
    links: [
      { href: '/work/', label: 'Case studies' },
      { href: '/writing/', label: 'Commissioned writing' },
      { href: '/services/', label: 'Services' },
    ],
  },
  { head: { href: '/about/', label: 'About' }, links: [] },
  { head: { href: '/contact/', label: 'Contact' }, links: [] },
];

const nav = [
  { href: '/desk/', label: 'Desk' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<div class="qs">
  <header class="qs-head">
    <div class="qs-wrap qs-head__inner">
      <a href="/preview/home/quiet/" class="qs-name">Archieval Mariano</a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <!-- 1 · Introduction -->
  <section class="qs-wrap qs-intro" aria-labelledby="qs-title">
    <div class="qs-intro__copy">
      <h1 id="qs-title">{cover.headline}</h1>
      <p class="qs-intro__statement">{cover.statement}</p>
      <p class="qs-intro__body">{cover.intro}</p>
      <p class="qs-links">
        <a href="/about/">A little about me <span aria-hidden="true">→</span></a>
        <a href="#qs-work">Explore my work <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <figure class="qs-intro__portrait">
      <Image
        src={portraitPhoto.src}
        alt={portraitPhoto.alt}
        widths={[400, 600, 800]}
        sizes="(max-width: 52rem) 70vw, 22rem"
        format="webp"
        quality={76}
        loading="eager"
      />
    </figure>
  </section>

  <!-- 2 · Desk -->
  <section class="qs-section qs-desk" aria-labelledby="qs-desk-title">
    <div class="qs-wrap">
      <header class="qs-section__head">
        <h2 id="qs-desk-title"><a href="/desk/">Desk</a></h2>
        <p>
          Things from my digital desk that I’ve decided to share. Some can be useful,
          definitely specific, and occasionally unnecessary.
        </p>
      </header>

      <!-- Directory: descriptions are text; only published destinations link -->
      <ul class="qs-dir" aria-label="Desk sections">
        {
          deskSubs.map((s) => (
            <li class:list={['qs-dir__item', { 'is-reserved': !s.href }]}>
              <p class="qs-dir__name">{s.href ? <a href={s.href}>{s.name}</a> : s.name}</p>
              {s.subtitle && <p class="qs-dir__subtitle">{s.subtitle}</p>}
              <p class="qs-dir__desc">{s.description}</p>
              {s.entry && (
                <p class="qs-dir__entry">
                  <a href={s.entry.href}>{s.entry.title}</a>
                  <span>{s.entry.description}</span>
                </p>
              )}
              {s.href ? (
                <p class="qs-go"><a href={s.href}>Open {s.name} <span aria-hidden="true">→</span></a></p>
              ) : (
                <p class="qs-dir__status">Nothing published yet.</p>
              )}
            </li>
          ))
        }
      </ul>

      <!-- One featured project -->
      {featuredProject && featuredImage && (
        <article class="qs-feature" aria-labelledby="qs-feature-title">
          <figure class:list={['qs-feature__figure', { 'qs-frame': frame }]} style={frameStyle}>
            <Image src={featuredImage.src} alt={featuredImage.alt} widths={[360, 540, 720, 1080]} sizes="(max-width: 36rem) 70vw, 17rem" format="webp" quality={76} />
          </figure>
          <div class="qs-feature__text">
            <p class="qs-feature__label">From Projects</p>
            <h3 id="qs-feature-title"><a href={`/desk/${featuredProject.data.slug}/`}>{featuredProject.data.name}</a></h3>
            {featuredProject.data.subtitle && featuredProject.data.subtitle !== featuredProject.data.name && (
              <p class="qs-feature__subtitle">{featuredProject.data.subtitle}</p>
            )}
            <p class="qs-feature__purpose">{featuredProject.data.purpose}</p>
            <p class="qs-meta">{featuredProject.data.facts.join(' · ')}</p>
            <p class="qs-go"><a href="/desk/projects/">All projects <span aria-hidden="true">→</span></a></p>
          </div>
        </article>
      )}
    </div>
  </section>

  <!-- 3 · Away from the dashboards -->
  <section class="qs-section qs-away" aria-labelledby="qs-away-title">
    <div class="qs-wrap qs-away__grid">
      <div class="qs-away__copy">
        <h2 id="qs-away-title">Away from the dashboards</h2>
        <p class="qs-away__lead">Pretends to be a photographer and a good writer.</p>
        <p>
          That is how I describe myself on Instagram, where I post photographs and the
          occasional poem or piece of prose. It captures my discomfort with calling myself
          a photographer, or even a good writer, despite spending years taking photographs
          and writing.
        </p>
        <p>
          In my twenties, I built trips around hostels and long journeys over land, saving
          on comfort so I could spend more on experience. I still travel, but I no longer
          treat discomfort as proof that a trip mattered. I move more slowly now, chase
          fewer attractions, and leave more room to notice what is actually there.
        </p>
        <p class="qs-go"><a href="/about/">More about me <span aria-hidden="true">→</span></a></p>
      </div>

      <div class="qs-photos" aria-label="Selected photographs from my personal archive" oncontextmenu="return false">
        <figure class="qs-photo" style={`--ar:${tallAR}`}>
          <Image src={tall.src} alt={tall.alt} widths={[300, 450, 600]} sizes="(max-width: 52rem) 30vw, 13rem" format="webp" quality={76} draggable="false" />
          <figcaption>{tall.caption}</figcaption>
        </figure>
        <div class="qs-photos__stack" style={`--ar:${stackAR}`}>
          {
            stack.map((p) => (
              <figure class="qs-photo">
                <Image src={p.src} alt={p.alt} widths={[480, 720, 960]} sizes="(max-width: 52rem) 60vw, 26rem" format="webp" quality={76} draggable="false" />
                <figcaption>{p.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Work -->
  <section class="qs-section qs-work" id="qs-work" aria-labelledby="qs-work-title">
    <div class="qs-wrap">
      <header class="qs-section__head">
        <h2 id="qs-work-title"><a href="/work/">Work</a></h2>
        <div class="qs-work__lede">
          <p class="qs-work__through">{throughline.title}</p>
          {throughline.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </header>

      <div class="qs-work__cases">
        <div class="qs-work__label">
          <h3><a href="/work/">Case studies</a></h3>
          <p>{workIntro.title}</p>
          <p class="qs-go"><a href="/work/">All case studies <span aria-hidden="true">→</span></a></p>
        </div>
        <ul class="qs-cases">
          {
            caseStudies.map((e) => (
              <li>
                <p class="qs-meta">{[e.data.year, e.data.category].filter(Boolean).join(' · ')}</p>
                <h4><a href={workHref(e.slug)}>{e.data.title}</a></h4>
                <p>{e.data.shortDescription}</p>
                <p class="qs-meta">{e.data.anonymized ? 'Confidential' : e.data.companyOrClient}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="qs-work__pair">
        <div class="qs-work__item">
          <h3><a href="/writing/">Commissioned writing</a></h3>
          <p>{writingIntro.aside}</p>
          {
            writingPicks.map((e) => (
              <p class="qs-work__pick">
                <a href={writingHref(e)} {...(isExternal(e) ? { target: '_blank', rel: 'noopener' } : {})}>
                  {writingTitle(e)}
                  {isExternal(e) && (
                    <>
                      <span aria-hidden="true"> ↗</span>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </>
                  )}
                </a>
                <span class="qs-meta">{[e.data.publisher, e.data.format].filter(Boolean).join(' · ')}</span>
              </p>
            ))
          }
          <p class="qs-go"><a href="/writing/">All commissioned writing <span aria-hidden="true">→</span></a></p>
        </div>
        <div class="qs-work__item">
          <h3><a href="/services/">Services</a></h3>
          <p>
            Audience intelligence, digital strategy and growth, and content and digital
            operations for teams that need clearer decisions and working systems.
          </p>
          <p class="qs-go"><a href="/services/">How I can help <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Closing -->
  <section class="qs-section qs-closing" aria-labelledby="qs-closing-title">
    <div class="qs-wrap qs-closing__inner">
      <h2 id="qs-closing-title">{closing.title}</h2>
      <div>
        <p>{closing.body}</p>
        <p class="qs-links">
          <a href="/about/">Read about me <span aria-hidden="true">→</span></a>
          <a href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
          <a href={siteLinks.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>
        </p>
      </div>
    </div>
  </section>

  <footer class="qs-foot">
    <div class="qs-wrap">
      <nav class="qs-foot__dir" aria-label="Site directory">
        {
          directory.map((d) => (
            <div>
              <p class="qs-foot__head"><a href={d.head.href}>{d.head.label}</a></p>
              {d.links.length > 0 && (
                <ul>
                  {d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
      <div class="qs-foot__base">
        <p>Archieval Mariano <span>© {year}</span></p>
        <p><a href={`mailto:${siteLinks.email}`}>{siteLinks.email}</a></p>
        <p><a href="#main">Back to top ↑</a></p>
      </div>
    </div>
  </footer>
</div>

<style>
  .qs { color: var(--ink); }
  .qs-wrap { width: min(100%, 76rem); margin-inline: auto; padding-inline: var(--gutter); }

  .qs h2 { font-family: var(--font-sans); font-size: clamp(1.7rem, 2.6vw, 2.5rem); font-weight: 740; letter-spacing: -.04em; line-height: 1.05; }
  .qs h2 a, .qs h3 a, .qs h4 a { text-decoration: none; }
  .qs h3, .qs h4 { font-family: var(--font-sans); font-weight: 720; letter-spacing: -.025em; line-height: 1.15; }
  .qs h2 a:hover, .qs h3 a:hover, .qs h4 a:hover { color: var(--accent); }
  .qs-meta { margin: 0; font-size: .74rem; font-weight: 650; letter-spacing: .02em; color: var(--ink-faint); }
  .qs-links { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; margin: 1.75rem 0 0; }
  .qs-links a, .qs-go a { font-size: .86rem; font-weight: 700; text-decoration-color: var(--rule); text-underline-offset: .3em; }
  .qs-links a:hover, .qs-go a:hover { text-decoration-color: var(--accent); }
  .qs-go { margin: 1rem 0 0; }

  /* Header */
  .qs-head { border-bottom: 1px solid var(--rule); }
  .qs-head__inner { display: flex; align-items: center; justify-content: space-between; gap: .75rem 2rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .qs-name { font-size: 1.02rem; font-weight: 780; letter-spacing: -.03em; text-decoration: none; }
  .qs-name::before { content: ''; display: inline-block; width: .55rem; aspect-ratio: 1; margin-right: .5rem; border-radius: 50%; background: var(--coral); }
  .qs-head ul { display: flex; flex-wrap: wrap; gap: .3rem 1.75rem; margin: 0; padding: 0; list-style: none; }
  .qs-head nav a { display: inline-block; padding-block: .25rem; font-size: .9rem; font-weight: 580; color: var(--ink-soft); text-decoration: none; }
  .qs-head nav a:hover { color: var(--accent); }

  /* 1 · Introduction */
  .qs-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem); gap: clamp(2rem, 7vw, 7rem); align-items: end; padding-top: clamp(3rem, 8vw, 6.5rem); padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .qs-intro h1 { max-width: 16ch; font-family: var(--font-sans); font-size: clamp(2.4rem, 4.6vw, 4.1rem); font-weight: 740; letter-spacing: -.05em; line-height: 1; }
  .qs-intro__statement { max-width: 32rem; margin: 1.5rem 0 0; font-family: var(--font-serif); font-size: clamp(1.25rem, 1.8vw, 1.55rem); line-height: 1.42; }
  .qs-intro__body { max-width: 36rem; margin: 1rem 0 0; line-height: 1.65; color: var(--ink-soft); }
  .qs-intro__portrait { margin: 0; }
  .qs-intro__portrait :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 47% center; filter: saturate(.85) contrast(1.03); border-radius: 2px; }

  /* Sections */
  .qs-section { padding-block: clamp(3.5rem, 7vw, 6rem); border-top: 1px solid var(--rule); }
  .qs-section__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1rem clamp(2rem, 6vw, 6rem); align-items: baseline; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .qs-section__head > p { max-width: 36rem; margin: 0; font-family: var(--font-serif); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; color: var(--ink-soft); }

  /* 2 · Desk */
  .qs-desk { background: var(--paper-raised); border-top: 0; }
  .qs-dir { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .qs-dir__item { padding: 1.25rem 1.5rem 1.4rem 0; }
  .qs-dir__item + .qs-dir__item { padding-left: 1.5rem; border-left: 1px solid var(--rule); }
  .qs-dir__name { margin: 0; font-size: 1.2rem; font-weight: 720; letter-spacing: -.025em; line-height: 1.15; }
  .qs-dir__name a { text-decoration: none; }
  .qs-dir__name a:hover { color: var(--accent); }
  .qs-dir__subtitle { margin: .15rem 0 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); }
  .qs-dir__desc { max-width: 24rem; margin: .5rem 0 0; font-family: var(--font-serif); font-size: 1.02rem; line-height: 1.45; color: var(--ink-soft); }
  .qs-dir__entry { display: grid; gap: .2rem; margin: .9rem 0 0; padding-top: .8rem; border-top: 1px solid var(--rule); }
  .qs-dir__entry a { font-family: var(--font-serif); font-size: 1.12rem; line-height: 1.25; text-decoration: none; }
  .qs-dir__entry a:hover { color: var(--accent); }
  .qs-dir__entry span { font-size: .86rem; color: var(--ink-soft); }
  .qs-dir__status { margin: 1rem 0 0; font-size: .8rem; font-weight: 600; }
  .qs-dir__item.is-reserved .qs-dir__name { color: var(--ink-soft); }
  /* AA contrast on the darker Desk band: --ink-faint is only 4.15:1 here */
  .qs-desk .qs-meta, .qs-desk .qs-dir__status { color: var(--ink-soft); }

  .qs-feature { display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: end; max-width: 50rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .qs-feature__figure { margin: 0; }
  .qs-feature__figure :global(img) { display: block; width: 100%; height: auto; border-radius: 2px; }
  .qs-feature__label { margin: 0 0 .4rem; font-size: .8rem; font-weight: 650; color: var(--ink-soft); }
  .qs-feature h3 { font-size: clamp(1.6rem, 2.4vw, 2.1rem); }
  .qs-feature__subtitle { margin: .2rem 0 0; font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); }
  .qs-feature__purpose { margin: .6rem 0 .5rem; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.45; }

  /* Framed screen crop (used only if a framed project is featured) */
  .qs-frame { position: relative; overflow: hidden; aspect-ratio: var(--cw) / var(--ch); border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent); border-radius: 2px; }
  .qs-frame :global(img) { position: absolute; max-width: none; width: calc(var(--iw) / var(--cw) * 100%) !important; left: calc(var(--cx) / var(--cw) * -100%); top: calc(var(--cy) / var(--ch) * -100%); border-radius: 0; }

  /* 3 · Away from the dashboards */
  .qs-away__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .qs-away__lead { max-width: 20ch; margin: 1rem 0 1.25rem; font-family: var(--font-serif); font-size: clamp(1.45rem, 2.2vw, 1.95rem); line-height: 1.22; }
  .qs-away__copy > p:not(.qs-away__lead):not(.qs-go) { max-width: 36rem; margin: 0 0 1rem; font-family: var(--font-serif); font-size: clamp(1.05rem, 1.35vw, 1.18rem); line-height: 1.6; }
  /* Flex-grow = aspect ratio, so the tall photo and the stack of two share one
