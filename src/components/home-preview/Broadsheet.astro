---
// DIRECTION A — BROADSHEET
// An editorial front page: nameplate, one lead story, a hierarchy of secondary
// stories, a photograph above the fold-line, and a dense back page.
import { Image } from 'astro:assets';
import {
  about,
  closing,
  cover,
  experiments,
  hero,
  isExternal,
  loadArchive,
  photos,
  portraitPhoto,
  siteLinks,
  throughline,
  workEvidence,
  workHref,
  workIsLinked,
  writingHref,
  writingIntro,
  writingTitle,
} from './archive';

const { work, featuredWork, otherWork, writing, projects } = await loadArchive();
const [leadWork, ...secondWork] = featuredWork;
const leadEvidence = workEvidence[leadWork.slug];
const deskProjects = projects.filter((p) => p.data.homepage);
const tools = projects.find((p) => !p.data.homepage);
const [firstDesk, ...moreDesk] = deskProjects;

const pano = photos.find((p) => p.key === 'singapore')!;
const smallPhotos = photos.filter((p) => p.key !== 'singapore');

const edition = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/writing', label: 'Writing' },
  { href: '/desk', label: 'Desk' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const inside = [
  { href: '#bs-work', label: 'Case studies', count: work.length },
  { href: '#bs-desk', label: 'Desk projects', count: projects.length },
  { href: '#bs-desk', label: 'Prototypes', count: experiments.length },
  { href: '#bs-back', label: 'Commissioned writing', count: writing.length },
  { href: '#bs-photos', label: 'Photographs', count: photos.length },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="bs">
  <header class="bs-mast">
    <div class="bs-mast__ears">
      <p>{hero.eyebrow}</p>
      <p class="bs-mast__ears-mid">Work · Software · Photographs · Writing</p>
      <p>{edition}</p>
    </div>
    <p class="bs-mast__name"><a href="/preview/home/broadsheet/">Archieval Mariano</a></p>
    <nav class="bs-mast__nav" aria-label="Primary">
      <ul>
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={siteLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
      </ul>
    </nav>
  </header>

  <!-- ── Above the fold ─────────────────────────────────────────────── -->
  <section class="bs-front" aria-labelledby="bs-lead-head">
    <article class="bs-lead">
      <p class="bs-kicker">The cover story</p>
      <h1 id="bs-lead-head" class="bs-lead__head">
        Have you heard of AI? <em>Not that one.</em>
      </h1>
      <p class="bs-lead__deck">{cover.statement}</p>
      <p class="bs-byline">By Archieval Mariano <span>·</span> Philippines</p>
      <div class="bs-lead__body">
        <p class="bs-dropcap">{cover.intro}</p>
        {throughline.paragraphs.map((p) => <p>{p}</p>)}
        <p class="bs-jump"><a href="/about">Continued: a little about me →</a></p>
      </div>
    </article>

    <div class="bs-rail">
      <figure class="bs-portrait">
        <Image
          src={portraitPhoto.src}
          alt={portraitPhoto.alt}
          widths={[420, 640, 840]}
          sizes="(max-width: 60rem) 100vw, 26vw"
          format="webp"
          quality={74}
          loading="eager"
        />
        <figcaption><b>Archieval Mariano.</b> “I used to call myself the bored storyteller. The name still fits.”</figcaption>
      </figure>

      <nav class="bs-inside" aria-label="Inside this edition">
        <p class="bs-inside__title">Inside</p>
        <ol>
          {
            inside.map((i) => (
              <li>
                <a href={i.href}>
                  <span>{i.label}</span>
                  <b>{pad(i.count)}</b>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- ── Secondary stories ─────────────────────────────────────────── -->
  <section class="bs-stories" id="bs-work" aria-labelledby="bs-work-title">
    <header class="bs-section-head">
      <h2 id="bs-work-title">Selected work</h2>
      <p>{throughline.title}</p>
      <a href="/work">All {work.length} case studies →</a>
    </header>

    <div class="bs-stories__grid">
      <article class="bs-story bs-story--lead">
        <div class="bs-figure-stat" aria-hidden="true">
          <strong>{leadEvidence.stat}</strong>
          <span>{leadEvidence.label}</span>
        </div>
        <div>
          <p class="bs-kicker">{[leadWork.data.year, leadWork.data.category].filter(Boolean).join(' · ')}</p>
          <h3><a href={workHref(leadWork.slug)}>{leadWork.data.title}</a></h3>
          <p class="bs-story__deck">{leadWork.data.shortDescription}</p>
          <ul class="bs-marks">{leadEvidence.marks.map((m) => <li>{m}</li>)}</ul>
        </div>
      </article>

      {
        secondWork.map((entry) => {
          const ev = workEvidence[entry.slug];
          return (
            <article class="bs-story">
              <p class="bs-kicker">{[entry.data.year, entry.data.category].filter(Boolean).join(' · ')}</p>
              <h3><a href={workHref(entry.slug)}>{entry.data.title}</a></h3>
              {ev && (
                <p class="bs-story__stat">
                  <strong>{ev.stat}</strong> {ev.label}
                </p>
              )}
              <p class="bs-story__deck">{entry.data.shortDescription}</p>
              <p class="bs-story__org">{entry.data.anonymized ? 'Confidential' : entry.data.companyOrClient}</p>
            </article>
          );
        })
      }
    </div>

    <div class="bs-briefs">
      <p class="bs-briefs__title">In brief</p>
      <ul>
        {
          otherWork.map((entry) => (
            <li>
              <span class="bs-briefs__year">{entry.data.year}</span>
              {workIsLinked(entry) ? (
                <a href={workHref(entry.slug)}>{entry.data.title}</a>
              ) : (
                <span>
                  {entry.data.title} <em>— listing only</em>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Photograph ────────────────────────────────────────────────── -->
  <section class="bs-pano" aria-label="Photograph">
    <figure>
      <Image src={pano.src} alt={pano.alt} widths={[768, 1280, 1800]} sizes="100vw" format="webp" quality={74} />
      <figcaption>
        <span>{pano.caption}</span>
        <span>Photograph</span>
      </figcaption>
    </figure>
    <blockquote class="bs-pull">
      <p>“The medium changes. The interest in making complicated work clearer does not.”</p>
    </blockquote>
  </section>

  <!-- ── From the desk ─────────────────────────────────────────────── -->
  <section class="bs-desk" id="bs-desk" aria-labelledby="bs-desk-title">
    <header class="bs-section-head">
      <h2 id="bs-desk-title">From the desk</h2>
      <p>Independent applications, utilities and experiments. Some are useful, definitely specific, and occasionally unnecessary.</p>
      <a href="/desk/projects/">All projects →</a>
    </header>

    <div class="bs-desk__grid">
      <article class="bs-desk__feature">
        <a href={`/desk/${firstDesk.data.slug}/`} class="bs-desk__img" tabindex="-1" aria-hidden="true">
          {firstDesk.data.heroImage && (
            <Image src={firstDesk.data.heroImage} alt="" widths={[360, 540, 720]} sizes="(max-width: 60rem) 100vw, 30vw" format="webp" quality={72} />
          )}
        </a>
        <div>
          <p class="bs-kicker">{firstDesk.data.subtitle}</p>
          <h3><a href={`/desk/${firstDesk.data.slug}/`}>{firstDesk.data.name}</a></h3>
          <p class="bs-story__deck">{firstDesk.data.purpose}</p>
          <p class="bs-facts">{firstDesk.data.facts.join(' · ')}</p>
        </div>
      </article>

      <div class="bs-desk__list">
        {
          moreDesk.map((p) => (
            <article class="bs-desk__item">
              <a href={`/desk/${p.data.slug}/`} class="bs-desk__thumb" tabindex="-1" aria-hidden="true">
                {p.data.heroImage && <Image src={p.data.heroImage} alt="" widths={[160, 240]} sizes="120px" format="webp" quality={70} />}
              </a>
              <div>
                <h3><a href={`/desk/${p.data.slug}/`}>{p.data.name}</a></h3>
                <p>{p.data.purpose}</p>
                <p class="bs-facts">{p.data.facts.join(' · ')}</p>
              </div>
            </article>
          ))
        }
        {tools && (
          <p class="bs-desk__also">
            Also: <a href={`/desk/${tools.data.slug}/`}>{tools.data.name}</a> — {tools.data.purpose}
          </p>
        )}
      </div>

      <aside class="bs-proto" aria-label="Product experiments">
        <p class="bs-proto__title">Prototypes</p>
        <p class="bs-proto__note">Independent prototypes exploring product ideas and interactions. Not launched products.</p>
        {
          experiments.map((x) => (
            <a class="bs-proto__item" href={x.href} target="_blank" rel="noopener">
              <span class="bs-kicker">{x.label}</span>
              <strong>{x.title} ↗</strong>
              <span>{x.description}</span>
            </a>
          ))
        }
      </aside>
    </div>
  </section>

  <!-- ── Back page ─────────────────────────────────────────────────── -->
  <section class="bs-back" id="bs-back" aria-labelledby="bs-back-title">
    <header class="bs-section-head bs-section-head--back">
      <h2 id="bs-back-title">The back pages</h2>
      <p>{writingIntro.aside}</p>
      <a href="/writing">All writing →</a>
    </header>

    <div class="bs-back__grid">
      <ol class="bs-classifieds">
        {
          writing.map((e, i) => (
            <li>
              <a href={writingHref(e)} {...(isExternal(e) ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="bs-classifieds__n">{pad(i + 1)}</span>
                <span class="bs-classifieds__pub">{e.data.publisher}</span>
                <strong>{writingTitle(e)}</strong>
                <span class="bs-classifieds__fmt">{e.data.format}</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="bs-photos" id="bs-photos">
        <p class="bs-briefs__title">Pictures</p>
        <p class="bs-photos__note">{about.photographer}</p>
        {
          smallPhotos.map((p) => (
            <figure>
              <Image src={p.src} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 60rem) 50vw, 18vw" format="webp" quality={70} />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <footer class="bs-foot">
    <div class="bs-foot__close">
      <p class="bs-kicker">There’s always more</p>
      <p class="bs-foot__head">{closing.title}</p>
      <p class="bs-foot__body">{closing.body}</p>
      <p class="bs-foot__actions">
        <a href="/about">Read about me</a>
        <a href="/contact">Start a conversation →</a>
      </p>
    </div>
    <div class="bs-foot__colophon">
      <p>Archieval Mariano · <a href={`mailto:${siteLinks.email}`}>{siteLinks.email}</a></p>
      <p>Set in Newsreader &amp; Inter · {about.experienceNote}</p>
    </div>
  </footer>
</div>

<style>
  .bs {
    --bs-col: minmax(0, 1fr);
    --bs-red: var(--accent-ink);
    --bs-rule: 1px solid var(--ink);
    width: min(100%, 92rem);
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-family: var(--font-serif);
    color: var(--ink);
  }
  .bs a { text-decoration: none; }
  .bs a:hover { color: var(--bs-red); }

  /* ── Nameplate ── */
  .bs-mast { padding-top: 1.1rem; }
  .bs-mast__ears { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding-bottom: .7rem; border-bottom: var(--bs-rule); font-family: var(--font-sans); font-size: .64rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .bs-mast__ears p { margin: 0; }
  .bs-mast__ears p:last-child { text-align: right; }
  .bs-mast__ears-mid { color: var(--bs-red); }
  .bs-mast__name { margin: 0; padding: .1em 0 .04em; font-size: clamp(3.2rem, 10.6vw, 9.8rem); font-variation-settings: 'opsz' 72; font-weight: 640; letter-spacing: -.045em; line-height: .86; text-align: center; white-space: nowrap; }
  .bs-mast__nav { border-top: 4px solid var(--ink); border-bottom: var(--bs-rule); padding-top: 2px; position: relative; }
  .bs-mast__nav::before { content: ''; position: absolute; inset: 2px 0 auto; border-top: var(--bs-rule); }
  .bs-mast__nav ul { display: flex; justify-content: center; flex-wrap: wrap; gap: .25rem 2.2rem; margin: 0; padding: .65rem 0; list-style: none; font-family: var(--font-sans); font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }

  .bs-kicker { margin: 0 0 .6rem; font-family: var(--font-sans); font-size: .66rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--bs-red); }

  /* ── Front ── */
  .bs-front { display: grid; grid-template-columns: repeat(12, var(--bs-col)); gap: 0 2rem; padding-block: clamp(2rem, 4vw, 3.5rem); border-bottom: 4px double var(--ink); }
  .bs-lead { grid-column: 1 / 9; padding-right: 2rem; border-right: var(--bs-rule); }
  .bs-lead__head { max-width: 11ch; font-size: clamp(3rem, 8.6vw, 9.4rem); font-variation-settings: 'opsz' 72; font-weight: 600; letter-spacing: -.045em; line-height: .9; text-wrap: balance; }
  .bs-lead__head em { display: block; font-weight: 420; color: var(--bs-red); }
  .bs-lead__deck { max-width: 30ch; margin: 1.6rem 0 0; font-size: clamp(1.4rem, 2.2vw, 2.1rem); font-style: italic; font-weight: 380; line-height: 1.22; }
  .bs-byline { margin: 1.4rem 0 1.4rem; padding-block: .55rem; border-block: var(--bs-rule); font-family: var(--font-sans); font-size: .66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .bs-byline span { color: var(--rule); }
  .bs-lead__body { columns: 2 16rem; column-gap: 2rem; column-rule: var(--bs-rule); font-size: 1.06rem; line-height: 1.55; text-align: justify; hyphens: auto; }
  .bs-lead__body p { margin: 0 0 .9em; }
  .bs-dropcap::first-letter { float: left; margin: .06em .1em 0 0; font-size: 4.6em; font-variation-settings: 'opsz' 72; font-weight: 650; line-height: .78; color: var(--bs-red); }
  .bs-jump { font-family: var(--font-sans); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; text-align: left; }
  .bs-rail { grid-column: 9 / 13; display: grid; gap: 1.75rem; align-content: start; }
  .bs-portrait { margin: 0; }
  .bs-portrait :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 47% center; filter: grayscale(1) contrast(1.1); }
  .bs-portrait figcaption { margin-top: .6rem; padding-top: .5rem; border-top: var(--bs-rule); font-size: .88rem; line-height: 1.35; color: var(--ink-soft); }
  .bs-inside { border: 2px solid var(--ink); padding: 1rem 1.1rem; }
  .bs-inside__title { margin: 0 0 .5rem; font-size: 1.6rem; font-style: italic; font-weight: 500; }
  .bs-inside ol { margin: 0; padding: 0; list-style: none; }
  .bs-inside li + li { border-top: 1px dotted var(--ink-faint); }
  .bs-inside a { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; font-family: var(--font-sans); font-size: .78rem; font-weight: 600; }
  .bs-inside b { font-variant-numeric: tabular-nums; font-weight: 800; }

  /* ── Section heads ── */
  .bs-section-head { display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: baseline; padding: .9rem 0; border-bottom: var(--bs-rule); }
  .bs-section-head h2 { font-size: clamp(1.7rem, 2.6vw, 2.5rem); font-variation-settings: 'opsz' 72; font-weight: 640; letter-spacing: -.02em; }
  .bs-section-head p { margin: 0; max-width: 60ch; font-style: italic; color: var(--ink-soft); }
  .bs-section-head a { font-family: var(--font-sans); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }

  /* ── Stories ── */
  .bs-stories { padding-block: 1.5rem 3rem; border-bottom: 4px double var(--ink); }
  .bs-stories__grid { display: grid; grid-template-columns: 6fr 3fr 3fr; gap: 0; padding-top: 1.75rem; }
  .bs-story { padding: 0 1.75rem; border-left: var(--bs-rule); }
  .bs-story:first-child { padding-left: 0; border-left: 0; }
  .bs-story h3 { font-size: clamp(1.35rem, 1.8vw, 1.75rem); font-variation-settings: 'opsz' 48; font-weight: 600; letter-spacing: -.015em; line-height: 1.08; }
  .bs-story__deck { margin: .8rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--ink-soft); }
  .bs-story__stat { margin: .9rem 0 0; padding: .5rem 0; border-block: var(--bs-rule); font-family: var(--font-sans); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .bs-story__stat strong { font-family: var(--font-serif); font-size: 2rem; font-weight: 600; letter-spacing: -.04em; text-transform: none; vertical-align: middle; margin-right: .3rem; }
  .bs-story__org { margin: .8rem 0 0; font-family: var(--font-sans); font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); }
  .bs-story--lead { display: grid; grid-template-columns: minmax(9rem, .7fr) 1.3fr; gap: 1.75rem; }
  .bs-story--lead h3 { font-size: clamp(1.7rem, 2.5vw, 2.5rem); line-height: 1; letter-spacing: -.03em; }
  .bs-figure-stat { display: flex; flex-direction: column; justify-content: space-between; padding: 1.1rem; background: var(--ink); color: var(--paper); min-height: 18rem; }
  .bs-figure-stat strong { font-size: clamp(6rem, 11vw, 10.5rem); font-variation-settings: 'opsz' 72; font-weight: 500; letter-spacing: -.07em; line-height: .78; color: var(--yellow); }
  .bs-figure-stat span { font-family: var(--font-sans); font-size: .72rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .bs-marks { display: flex; flex-wrap: wrap; gap: .35rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .bs-marks li { padding: .2rem .5rem; border: 1px solid var(--ink); font-family: var(--font-sans); font-size: .66rem; font-weight: 700; }
  .bs-briefs { display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; margin-top: 2.25rem; padding-top: 1rem; border-top: var(--bs-rule); }
  .bs-briefs__title { margin: 0; font-size: 1.4rem; font-style: italic; font-weight: 500; }
  .bs-briefs ul { columns: 2 22rem; column-gap: 2rem; column-rule: var(--bs-rule); margin: 0; padding: 0; list-style: none; }
  .bs-briefs li { break-inside: avoid; padding: .35rem 0 .6rem; font-size: 1rem; line-height: 1.35; }
  .bs-briefs em { color: var(--ink-faint); font-size: .9em; }
  .bs-briefs__year { display: block; font-family: var(--font-sans); font-size: .62rem; font-weight: 800; letter-spacing: .1em; color: var(--bs-red); }

  /* ── Panorama ── */
  .bs-pano { position: relative; padding-block: 2.5rem; border-bottom: 4px double var(--ink); }
  .bs-pano figure { margin: 0; }
  .bs-pano :global(img) { width: 100%; height: clamp(22rem, 42vw, 40rem); object-fit: cover; object-position: center 80%; filter: grayscale(.25) contrast(1.05); }
  .bs-pano figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .55rem; font-family: var(--font-sans); font-size: .64rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  .bs-pull { position: absolute; top: 4rem; left: clamp(1rem, 3vw, 2.5rem); max-width: 24rem; margin: 0; padding: 1.25rem 1.4rem; background: var(--paper); border-top: 6px solid var(--bs-red); }
  .bs-pull p { margin: 0; font-size: clamp(1.25rem, 2vw, 1.8rem); font-style: italic; font-variation-settings: 'opsz' 60; line-height: 1.18; }

  /* ── Desk ── */
  .bs-desk { padding-block: 1.5rem 3rem; border-bottom: 4px double var(--ink); }
  .bs-desk__grid { display: grid; grid-template-columns: 5fr 4fr 3fr; gap: 0; padding-top: 1.75rem; }
  .bs-desk__feature { display: grid; grid-template-columns: .9fr 1fr; gap: 1.5rem; padding-right: 1.75rem; }
  .bs-desk__feature h3 { font-size: clamp(2.4rem, 4vw, 3.8rem); font-variation-settings: 'opsz' 72; font-weight: 640; letter-spacing: -.035em; line-height: .95; }
  .bs-desk__img :global(img), .bs-desk__thumb :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .bs-facts { margin: .8rem 0 0; font-family: var(--font-sans); font-size: .66rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-faint); }
  .bs-desk__list { padding: 0 1.75rem; border-left: var(--bs-rule); }
  .bs-desk__item { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px dotted var(--ink-faint); }
  .bs-desk__item h3 { font-size: 1.45rem; font-weight: 640; letter-spacing: -.01em; }
  .bs-desk__item p { margin: .25rem 0 0; font-size: .95rem; line-height: 1.4; }
  .bs-desk__also { font-size: .95rem; font-style: italic; color: var(--ink-soft); }
  .bs-proto { padding-left: 1.75rem; border-left: var(--bs-rule); }
  .bs-proto__title { margin: 0; font-size: 1.4rem; font-style: italic; font-weight: 500; }
  .bs-proto__note { margin: .4rem 0 1rem; font-size: .88rem; color: var(--ink-soft); }
  .bs-proto__item { display: grid; gap: .25rem; padding: .9rem 0; border-top: var(--bs-rule); }
  .bs-proto__item .bs-kicker { margin: 0; }
  .bs-proto__item strong { font-size: 1.3rem; font-weight: 600; }
