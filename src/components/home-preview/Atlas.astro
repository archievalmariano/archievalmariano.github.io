---
// DIRECTION C — FIELD NOTEBOOK / ATLAS
// An exploratory plate. Places that already appear in the archive are plotted
// on a graticule (true positions, no coastlines drawn); ON POINT's seven
// published routes become a schematic transit plate; the work becomes lines
// with stations; photographs are pinned into a notebook as specimens.
import { Image } from 'astro:assets';
import {
  about,
  closing,
  cover,
  experiments,
  hero,
  isExternal,
  loadArchive,
  photos,
  siteLinks,
  throughline,
  workEvidence,
  workHref,
  workIsLinked,
  writingHref,
  writingTitle,
  yearSpan,
} from './archive';

const { work, featuredWork, writing, projects } = await loadArchive();
const pad = (n: number) => String(n).padStart(2, '0');

// ── Plate I: regional graticule ────────────────────────────────────────────
// Equirectangular, lon 100–126 E, lat −1–27 N.
const LON0 = 100, LON1 = 126, LAT0 = -1, LAT1 = 27, K = 36, M = 28;
const W = (LON1 - LON0) * K + M * 2;
const H = (LAT1 - LAT0) * K + M * 2;
const px = (lon: number) => M + (lon - LON0) * K;
const py = (lat: number) => M + (LAT1 - lat) * K;
const meridians = Array.from({ length: (LON1 - LON0) / 2 + 1 }, (_, i) => LON0 + i * 2);
const parallels = Array.from({ length: 14 }, (_, i) => i * 2); // 0°–26° N

const hk = writing.find((w) => w.slug.includes('hong-kong'));
const onPoint = projects.find((p) => p.data.slug === 'on-point');
const photo = (k: string) => photos.find((p) => p.key === k)!;

type Place = {
  n: string;
  name: string;
  lat: number;
  lon: number;
  kind: string;
  note: string;
  href: string;
  external?: boolean;
  dx?: number; // label offset
  dy?: number;
  anchor?: 'start' | 'end';
};
const places: Place[] = [
  { n: '01', name: 'Taipei', lat: photo('taipei').lat, lon: photo('taipei').lon, kind: 'Photograph', note: photo('taipei').caption, href: '/about', anchor: 'end', dx: -16 },
  ...(hk
    ? [{ n: '02', name: 'Hong Kong', lat: 22.3, lon: 114.17, kind: 'Writing', note: `${hk.data.publisher} · ${hk.data.clientOrCampaign ?? ''}`.replace(/ · $/, ''), href: writingHref(hk), external: isExternal(hk), anchor: 'end' as const, dx: -16 }]
    : []),
  { n: '03', name: 'Central Luzon', lat: 15.0, lon: 120.85, kind: 'Desk project', note: `${onPoint?.data.name ?? 'ON POINT'} · 7 published routes · see Plate II`, href: '#plate-ii', anchor: 'end', dx: -18, dy: -14 },
  { n: '04', name: 'Pasay Baywalk', lat: photo('baywalk').lat, lon: photo('baywalk').lon, kind: 'Photograph', note: photo('baywalk').caption, href: '/about', anchor: 'end', dx: -18, dy: 34 },
  { n: '05', name: 'Singapore', lat: photo('esplanade').lat, lon: photo('esplanade').lon, kind: 'Photographs ×2', note: `${photo('esplanade').caption}; the skyline`, href: '/about', anchor: 'start', dx: 16 },
];
const dms = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)}° ${v >= 0 ? pos : neg}`;

// ── Plate II: ON POINT routes (schematic) ──────────────────────────────────
// Routes and operators exactly as published on /desk/on-point/.
const stations: Record<string, { x: number; y: number; label: string; side: 'l' | 'r'; hub?: boolean }> = {
  BAG: { x: 180, y: 40, label: 'Baguio', side: 'r' },
  CRK: { x: 180, y: 140, label: 'Clark Airport', side: 'l', hub: true },
  BLG: { x: 320, y: 210, label: 'Balagtas', side: 'r' },
  CAY: { x: 480, y: 200, label: 'Caypombo', side: 'r' },
  TRN: { x: 350, y: 300, label: 'TriNoma', side: 'l', hub: true },
  SMN: { x: 480, y: 300, label: 'SM North EDSA', side: 'r' },
  CUB: { x: 480, y: 360, label: 'Cubao', side: 'r' },
  NAI: { x: 350, y: 430, label: 'NAIA T3', side: 'r', hub: true },
  PIT: { x: 180, y: 430, label: 'PITX', side: 'l' },
};
const operators = [
  { name: 'Bulacan P2P', color: 'var(--coral)' },
  { name: 'Precious Grace', color: '#c9a21c' },
  { name: 'Genesis', color: 'var(--blue)' },
  { name: 'UBE Express', color: '#31835a' },
];
const opColor = (name: string) => operators.find((o) => o.name === name)!.color;
const routes = [
  { route: 'Balagtas ↔ TriNoma', op: 'Bulacan P2P', d: 'M320,210 L350,240 L350,300' },
  { route: 'Caypombo ↔ SM North EDSA', op: 'Precious Grace', d: 'M480,200 L480,300' },
  { route: 'Clark Airport ↔ Baguio', op: 'Genesis', d: 'M180,140 L180,40' },
  { route: 'Clark Airport ↔ NAIA T3', op: 'Genesis', d: 'M172,140 L172,260 L342,430 L350,430' },
  { route: 'Cubao ↔ Clark Airport', op: 'Genesis', d: 'M180,140 L180,226 L314,360 L480,360' },
  { route: 'NAIA T3 ↔ PITX', op: 'UBE Express', d: 'M350,430 L180,430' },
  { route: 'TriNoma ↔ Clark Airport', op: 'Genesis', d: 'M188,140 L188,190 L298,300 L350,300' },
];

// ── Lines through the archive ──────────────────────────────────────────────
const workStations = work
  .map((e) => ({ e, span: yearSpan(e.data.year) }))
  .sort((a, b) => (a.span?.[0] ?? 0) - (b.span?.[0] ?? 0) || (a.span?.[1] ?? 0) - (b.span?.[1] ?? 0));

const publishers = new Map<string, number>();
for (const w of writing) publishers.set(w.data.publisher ?? 'Other', (publishers.get(w.data.publisher ?? 'Other') ?? 0) + 1);
const pubStations = [...publishers.entries()].sort((a, b) => b[1] - a[1]);

const lines = [
  {
    code: 'W',
    name: 'Work',
    color: 'var(--coral)',
    span: `${workStations[0].span?.[0]} → ${workStations[workStations.length - 1].span?.[1]}`,
    href: '/work',
    stations: workStations.map(({ e }) => ({
      top: e.data.year ?? '',
      label: e.data.category ?? e.data.title,
      href: workIsLinked(e) ? workHref(e.slug) : undefined,
      title: e.data.title,
      major: e.data.featured,
    })),
  },
  {
    code: 'D',
    name: 'Desk',
    color: 'var(--blue)',
    span: `${projects.length} projects`,
    href: '/desk',
    stations: projects.map((p) => ({ top: p.data.status, label: p.data.name, href: `/desk/${p.data.slug}/`, title: p.data.purpose, major: p.data.featured })),
  },
  {
    code: 'P',
    name: 'Prototypes',
    color: '#c9a21c',
    span: `${experiments.length} prototypes`,
    href: '/work',
    stations: experiments.map((x) => ({ top: x.label, label: x.title, href: x.href, title: x.description, major: false })),
  },
  {
    code: 'R',
    name: 'Writing',
    color: '#31835a',
    span: `${writing.length} pieces · by publisher`,
    href: '/writing',
    stations: pubStations.map(([pub, n]) => ({ top: `×${n}`, label: pub, href: '/writing', title: `${n} commissioned piece${n > 1 ? 's' : ''}`, major: n > 1 })),
  },
];

const specimens = photos.map((p, i) => ({ ...p, n: pad(i + 1) }));
---

<div class="at">
  <header class="at-top">
    <a class="at-brand" href="/preview/home/atlas/">
      <i class="at-pin" aria-hidden="true"></i>
      <span><strong>Archieval Mariano</strong><small>Field notebook · personal archive</small></span>
    </a>
    <nav aria-label="Primary">
      <a href="/work">Work</a><a href="/services">Services</a><a href="/writing">Writing</a><a href="/desk">Desk</a><a href="/about">About</a><a href="/contact">Contact</a>
    </nav>
  </header>

  <!-- ── Plate I ─────────────────────────────────────────────────────── -->
  <section class="at-hero" aria-labelledby="at-title">
    <div class="at-hero__rail">
      <p class="at-sys">Plate I · Places in the archive</p>
      <h1 id="at-title">Archieval Mariano, <em>the bored storyteller.</em></h1>
      <p class="at-hero__lede">{about.lede.replace(/^I used to call myself the bored storyteller\. /, '')}</p>
      <p class="at-hero__eyebrow">{hero.eyebrow}</p>

      <ol class="at-legend">
        {
          places.map((p) => (
            <li>
              <a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>
                <i>{p.n}</i>
                <span>
                  <strong>{p.name}</strong>
                  <small>{p.kind} — {p.note}</small>
                </span>
                <span class="at-legend__coord">{dms(p.lat, 'N', 'S')}<br />{dms(p.lon, 'E', 'W')}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="at-plate">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="at-plate-cap">
        <defs>
          <pattern id="at-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="1" opacity=".22" />
          </pattern>
        </defs>
        <rect x="0" y="0" width={W} height={H} class="at-plate__sea" />
        {/* contour rings: decorative, centred on each place */}
        {places.map((p) => [1, 2, 3, 4].map((r) => <circle cx={px(p.lon)} cy={py(p.lat)} r={r * 26} class="at-plate__ring" />))}
        {meridians.map((lon) => (
          <g>
            <line x1={px(lon)} y1={M} x2={px(lon)} y2={H - M} class:list={['at-plate__grid', { major: lon % 10 === 0 }]} />
            <text x={px(lon)} y={M - 8} class="at-plate__deg" text-anchor="middle">{lon}°</text>
          </g>
        ))}
        {parallels.map((lat) => (
          <g>
            <line x1={M} y1={py(lat)} x2={W - M} y2={py(lat)} class:list={['at-plate__grid', { major: lat % 10 === 0 }]} />
            <text x={M - 6} y={py(lat) + 4} class="at-plate__deg" text-anchor="end">{lat}°</text>
          </g>
        ))}
        <line x1={M} y1={py(0)} x2={W - M} y2={py(0)} class="at-plate__equator" />
        <text x={W - M - 6} y={py(0) - 6} class="at-plate__deg" text-anchor="end">EQUATOR</text>
        <line x1={M} y1={py(23.44)} x2={W - M} y2={py(23.44)} class="at-plate__tropic" />
        <text x={M + 8} y={py(23.44) - 6} class="at-plate__deg">TROPIC OF CANCER</text>

        {/* Plate II locator */}
        <rect x={px(120.3)} y={py(16.7)} width={px(121.4) - px(120.3)} height={py(14.3) - py(16.7)} class="at-plate__locator" />
        <text x={px(121.6)} y={py(16.6)} class="at-plate__deg">PLATE II</text>

        {/* dashed legs between places, in the order listed */}
        <polyline points={places.map((p) => `${px(p.lon)},${py(p.lat)}`).join(' ')} class="at-plate__leg" />

        {places.map((p) => (
          <g class="at-plate__place">
            <circle cx={px(p.lon)} cy={py(p.lat)} r="13" class="at-plate__pin" />
            <text x={px(p.lon)} y={py(p.lat) + 4} class="at-plate__pin-n" text-anchor="middle">{p.n}</text>
            <text x={px(p.lon) + (p.dx ?? 16)} y={py(p.lat) + (p.dy ?? 0) - 4} class="at-plate__label" text-anchor={p.anchor}>{p.name.toUpperCase()}</text>
            <text x={px(p.lon) + (p.dx ?? 16)} y={py(p.lat) + (p.dy ?? 0) + 14} class="at-plate__sub" text-anchor={p.anchor}>{p.kind}</text>
          </g>
        ))}

        {/* compass */}
        <g transform={`translate(${W - M - 54} ${H - M - 70})`} class="at-plate__compass">
          <circle r="34" />
          <path d="M0,-44 L7,0 L0,8 L-7,0 Z" />
          <text y="-50" text-anchor="middle">N</text>
        </g>
      </svg>
      <figcaption id="at-plate-cap">
        <span>Places named in the archive’s captions and entries, plotted at their true latitude and longitude.</span>
        <span>Equirectangular · 2° graticule · no coastlines drawn · legs are schematic</span>
      </figcaption>
    </figure>
  </section>

  <!-- ── Lines ───────────────────────────────────────────────────────── -->
  <section class="at-lines" aria-labelledby="at-lines-title">
    <header class="at-head">
      <p class="at-sys">Plate III · Lines through the archive</p>
      <h2 id="at-lines-title">{throughline.title}</h2>
      <p>{throughline.paragraphs[1]}</p>
    </header>

    <div class="at-lines__map">
      {
        lines.map((l) => (
          <div class="at-line" style={`--line:${l.color}`}>
            <a class="at-line__badge" href={l.href}>
              <b>{l.code}</b>
              <span>
                <strong>{l.name}</strong>
                <small>{l.span}</small>
              </span>
            </a>
            <ol class="at-line__track">
              {l.stations.map((s) => (
                <li class:list={[{ major: s.major }]}>
                  {s.href ? (
                    <a href={s.href} title={s.title} {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                      <small>{s.top}</small>
                      <span>{s.label}</span>
                    </a>
                  ) : (
                    <span class="at-line__static" title={s.title}>
                      <small>{s.top}</small>
                      <span>{s.label}</span>
                      <em>private</em>
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
    <p class="at-note">Stations on the Work line are case studies in order of their start year; bold stations are selected work. Writing stations are publishers, with the number of commissioned pieces for each.</p>
  </section>

  <!-- ── Plate II ────────────────────────────────────────────────────── -->
  <section class="at-routes" id="plate-ii" aria-labelledby="at-routes-title">
    <div class="at-routes__copy">
      <p class="at-sys">Plate II · Central Luzon, schematic</p>
      <h2 id="at-routes-title">{onPoint?.data.name ?? 'ON POINT'}</h2>
      <p class="at-routes__lede">{onPoint?.data.purpose}</p>
      <ul class="at-routes__ops">
        {operators.map((o) => <li style={`--c:${o.color}`}>{o.name}</li>)}
      </ul>
      <ol class="at-routes__list">
        {routes.map((r, i) => <li style={`--c:${opColor(r.op)}`}><i>{pad(i + 1)}</i>{r.route}</li>)}
      </ol>
      <a class="at-cta" href="/desk/on-point/">Open ON POINT →</a>
    </div>
    <figure class="at-routes__plate">
      <svg viewBox="0 0 640 470" role="img" aria-label="Schematic diagram of the seven bus routes carried by ON POINT, coloured by operator.">
        <defs>
          <pattern id="at-dots" width="20" height="20" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="currentColor" opacity=".18" />
          </pattern>
        </defs>
        <rect x="0" y="0" width="640" height="470" fill="url(#at-dots)" />
        {routes.map((r) => <path d={r.d} stroke={opColor(r.op)} class="at-routes__path" />)}
        {Object.values(stations).map((s) => (
          <g>
            {s.hub ? <rect x={s.x - 14} y={s.y - 9} width="28" height="18" rx="9" class="at-routes__hub" /> : <circle cx={s.x} cy={s.y} r="7" class="at-routes__stop" />}
            <text x={s.side === 'r' ? s.x + 20 : s.x - 20} y={s.y + 4} text-anchor={s.side === 'r' ? 'start' : 'end'} class="at-routes__label">{s.label}</text>
          </g>
        ))}
      </svg>
      <figcaption>Routes and operators as published on the ON POINT page. Positions are schematic, not geographic.</figcaption>
    </figure>
  </section>

  <!-- ── Notebook ────────────────────────────────────────────────────── -->
  <section class="at-notebook" aria-labelledby="at-nb-title">
    <div class="at-page">
      <p class="at-sys">Field entries · selected work</p>
      <h2 id="at-nb-title">{cover.statement}</h2>
      <p class="at-page__intro">{cover.intro}</p>

      <ol class="at-entries">
        {
          featuredWork.map((e, i) => {
            const ev = workEvidence[e.slug];
            return (
              <li>
                <span class="at-stamp" aria-hidden="true">
                  <b>{ev?.stat ?? pad(i + 1)}</b>
                </span>
                <div>
                  <p class="at-entries__meta">Entry {pad(i + 1)} · {e.data.year} · {e.data.anonymized ? 'Confidential' : e.data.companyOrClient}</p>
                  <h3><a href={workHref(e.slug)}>{e.data.title}</a></h3>
                  {ev && <p class="at-entries__ev">{ev.stat} {ev.label} — {ev.marks.join(', ')}</p>}
                  <p>{e.data.shortDescription}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="at-margin-quote" aria-hidden="true">“{about.ending}”</p>
    </div>

    <div class="at-specimens" aria-label="Photographs from the personal archive">
      <p class="at-sys">Specimens · photographs</p>
      <p class="at-specimens__note">{about.photographer}</p>
      {
        specimens.map((p) => (
          <figure class={`at-specimen at-specimen--${p.key}`}>
            <Image src={p.src} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 52rem) 80vw, 22vw" format="webp" quality={72} />
            <figcaption>
              <b>No. {p.n}</b> {p.caption}
              <small>{dms(p.lat, 'N', 'S')} · {dms(p.lon, 'E', 'W')}</small>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ── Writing waypoints ───────────────────────────────────────────── -->
  <section class="at-writing" aria-labelledby="at-writing-title">
    <header class="at-head at-head--row">
      <div>
        <p class="at-sys">Waypoints · writing</p>
        <h2 id="at-writing-title">{about.heart}</h2>
      </div>
      <a class="at-cta" href="/writing">All {writing.length} pieces →</a>
    </header>
    <ol class="at-waypoints">
      {
        writing.filter((w) => w.data.featured).concat(writing.filter((w) => !w.data.featured)).slice(0, 6).map((w, i) => (
          <li>
            <a href={writingHref(w)} {...(isExternal(w) ? { target: '_blank', rel: 'noopener' } : {})}>
              <i><span>{String.fromCharCode(65 + i)}</span></i>
              <small>{w.data.publisher} · {w.data.format}</small>
              <strong>{writingTitle(w)}</strong>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <footer class="at-foot">
    <div>
      <p class="at-sys">There’s always more</p>
      <p class="at-foot__head">{closing.title}</p>
      <p>{about.travel}</p>
      <p class="at-foot__links">
        <a href="/contact">Start a conversation →</a>
        <a href={`mailto:${siteLinks.email}`}>{siteLinks.email}</a>
        <a href={siteLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </p>
    </div>
    <p class="at-foot__scale" aria-hidden="true"><span></span><span></span><span></span><span></span> Not to scale</p>
  </footer>
</div>

<style>
  .at {
    --sky: #d7edf6;
    --sky-deep: #a9d5e8;
    --land: #a9cc90;
    --grid: #ffffff;
    --pt-line: #cfd7d8;
    --pt-coral: #ee5638;
    --at-muted: #617178;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
  }
  .at a { text-decoration: none; }
  .at-sys { margin: 0 0 .9rem; font-size: .66rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; color: var(--pt-coral); }

  /* top bar */
  .at-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; padding: 1rem var(--gutter); border-bottom: 1px solid var(--pt-line); background: #fffaf0; }
  .at-brand { display: flex; align-items: center; gap: .75rem; }
  .at-pin { width: 1.2rem; height: 1.2rem; border: .38rem solid var(--pt-coral); border-radius: 50% 50% 50% 0; background: #fff; transform: rotate(-45deg); }
  .at-brand strong { display: block; font-size: 1.15rem; font-weight: 800; letter-spacing: -.04em; line-height: 1; }
  .at-brand small { display: block; margin-top: .2rem; font-size: .6rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; color: var(--at-muted); }
  .at-top nav { display: flex; flex-wrap: wrap; gap: .3rem 1.6rem; font-size: .72rem; font-weight: 700; color: var(--at-muted); }
  .at-top nav a:hover { color: var(--ink); }

  /* hero */
  .at-hero { display: grid; grid-template-columns: minmax(20rem, 27rem) minmax(0, 1fr); min-height: calc(100svh - 6rem); border-bottom: 1px solid var(--pt-line); }
  .at-hero__rail { padding: clamp(2rem, 4vw, 3.25rem) clamp(1.25rem, 2.5vw, 2rem) 2rem var(--gutter); background: #fff; border-right: 1px solid var(--pt-line); }
  .at-hero h1 { font-family: var(--font-sans); font-size: clamp(2.3rem, 3.6vw, 3.4rem); font-weight: 800; letter-spacing: -.05em; line-height: .98; }
  .at-hero h1 em { display: block; font-family: var(--font-serif); font-weight: 400; font-style: italic; letter-spacing: -.03em; color: var(--blue-dark); }
  .at-hero__lede { margin: 1.25rem 0 0; font-family: var(--font-serif); font-size: 1.12rem; line-height: 1.5; color: var(--ink-soft); }
  .at-hero__eyebrow { margin: 1rem 0 0; font-size: .64rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; color: var(--at-muted); }
  .at-legend { margin: 1.75rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--pt-line); }
  .at-legend a { display: grid; grid-template-columns: 2.2rem 1fr auto; gap: .75rem; align-items: center; padding: .8rem .5rem; border-radius: .7rem; }
  .at-legend a:hover { background: #fff0eb; }
  .at-legend i { display: grid; place-items: center; width: 2rem; height: 2rem; border: 2px solid var(--pt-coral); border-radius: 50%; font-size: .62rem; font-style: normal; font-weight: 900; color: var(--pt-coral); background: #fff; }
  .at-legend li:first-child i { background: var(--pt-coral); color: #fff; box-shadow: 0 0 0 5px #fff0eb; }
  .at-legend strong { display: block; font-size: .9rem; }
