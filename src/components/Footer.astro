---
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap site-foot__inner">
    <p class="meta">© {year} Archieval Mariano</p>
    <p class="meta">
      <a href="mailto:hello@archievalmariano.com" data-ga-event="email_click">hello@archievalmariano.com</a>
      <span aria-hidden="true"> · </span>
      <a href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: var(--space-xxl);
    border-top: 1px solid var(--rule);
  }

  .site-foot__inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
  }

  .site-foot__inner a {
    text-decoration: none;
  }

  .site-foot__inner a:hover {
    color: var(--accent);
  }
</style>
