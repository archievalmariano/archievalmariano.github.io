---
// Marked stand-in for a photo that has not been taken yet. Defaults to the 3:4
// ratio of the device photos; `orientation` lets editorial placeholders match
// the intended composition (landscape / panorama) so swapping in the real
// image later does not change the layout.
interface Props {
  label: string;
  note?: string;
  orientation?: 'portrait' | 'landscape' | 'panorama';
}

const { label, note = 'Photo to come', orientation = 'portrait' } = Astro.props;

const ratio = {
  portrait: '3 / 4',
  landscape: '3 / 2',
  panorama: '21 / 9',
}[orientation];
---

<div
  class="media-placeholder"
  role="img"
  aria-label={`${note}: ${label}`}
  style={`--placeholder-ratio: ${ratio};`}
>
  <span class="media-placeholder__note">{note}</span>
  <span class="media-placeholder__label">{label}</span>
</div>

<style>
  .media-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: .35rem;
    aspect-ratio: var(--placeholder-ratio, 3 / 4);
    width: 100%;
    padding: var(--space-md);
    background: var(--paper-raised);
    border: 1px dashed var(--rule);
  }

  .media-placeholder__note {
    font-family: var(--font-sans);
    font-size: .63rem;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .media-placeholder__label {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.35;
    color: var(--ink-soft);
  }
</style>
