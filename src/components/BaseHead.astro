---
// Self-hosted variable fonts (bundled at build, no CDN request)
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ga4Id, ogImage } from '../data/site';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  ogImage?: ImageMetadata; // optional per-article social image; falls back to the global image
  ogImageAlt?: string;
  publishedTime?: string; // ISO date, articles only
  modifiedTime?: string; // ISO date, articles only
  jsonLd?: Record<string, unknown>; // optional structured data (schema.org)
}

const {
  title,
  description,
  type = 'website',
  ogImage: ogOverride,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Per-article override resolves to the emitted asset URL; otherwise the global.
const ogImageURL = ogOverride ? new URL(ogOverride.src, Astro.site) : new URL(ogImage.path, Astro.site);
const ogImageW = ogOverride ? ogOverride.width : ogImage.width;
const ogImageH = ogOverride ? ogOverride.height : ogImage.height;
const ogImageAltText = ogOverride ? (ogImageAlt ?? description) : ogImage.alt;

// Serialize JSON-LD safely for embedding in an HTML <script> block. Escaping
// `<`, `>` and `&` to their JSON \uXXXX forms keeps the output valid JSON-LD
// while making it impossible for any field (e.g. a title containing
// `</script>`) to terminate the script element or inject markup.
const jsonLdSafe = jsonLd
  ? JSON.stringify(jsonLd)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="impact-site-verification" value="d1c149a2-d641-49e6-ab08-12e127e50713" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImageW)} />
<meta property="og:image:height" content={String(ogImageH)} />
<meta property="og:image:alt" content={ogImageAltText} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<meta name="theme-color" content="#f4f0e5" />

{jsonLdSafe && <script type="application/ld+json" is:inline set:html={jsonLdSafe} />}

{/* Google Analytics 4 (gtag.js). Enhanced Measurement handles pageviews + outbound clicks. */}
{
  ga4Id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script
        is:inline
        set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${ga4Id}');

          // Lightweight custom events via delegation on [data-ga-event] links.
          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest && e.target.closest('[data-ga-event]');
            if (el) gtag('event', el.getAttribute('data-ga-event'), { link_url: el.getAttribute('href') || undefined });
          });
        `}
      />
    </>
  )
}
